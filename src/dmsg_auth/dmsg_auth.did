// Anti-abuse admission of one caller's account creation, signed by the home's
// configured issuer over the `dmsg/account-admission/v1` digest of
// `(home, caller, expires_at)`. It grants no account or device authority.
type AdmissionTicket = record {
  // Issuer Ed25519 signature over the admission digest.
  signature : blob;
  // Exclusive deadline in Unix milliseconds, at most ten minutes ahead.
  expires_at : nat64;
};
// An interactive operation. A challenge authorizes exactly one variant.
type AuthAction = variant {
  // End every session of the passkey's identity, including this one.
  logout_all;
  // Remember this device for an existing identity.
  login;
  // Create a new single-passkey identity.
  register;
};
// Server-generated challenge, bound to the caller and operation.
type AuthChallenge = record {
  // Bound operation.
  action : AuthAction;
  // Unpredictable challenge bytes given to WebAuthn.
  challenge : blob;
  // Exclusive expiration, in milliseconds.
  expires_at : nat64;
};
// A delegation signed by the auth canister, addressed to the device key.
type AuthDelegation = record {
  // Certified canister signature; obtained through get_delegation.
  signature : blob;
  // Canister-signature public key, determining the login Principal.
  user_key : blob;
  // Device public key in SPKI DER.
  public_key : blob;
  // Exclusive expiration in IC nanoseconds.
  expiration : nat64;
};
// Install arguments; identity salt is generated by the canister.
type AuthInit = record {
  // Admission issuer's Ed25519 key; None only for unrestricted deployments.
  admission_key : opt blob;
  // Fixed governance allowed to administer alongside controllers.
  governance : principal;
  // Initial budgets.
  limits : AuthLimits;
};
// Basic service admission and execution budgets, not capacity promises.
type AuthLimits = record {
  // New identities per UTC day.
  daily_registrations : nat32;
  // Interactive requests per minute, challenges included.
  // Preparation uses at most half this budget (minimum one).
  requests_per_minute : nat32;
  // Renewals per minute across the service.
  renewals_per_minute : nat32;
  // Maximum stored identities.
  max_identities : nat64;
  // Simultaneously pending one-use challenges.
  max_challenges : nat32;
};
// Public service statistics; no user or credential inventory.
type AuthStats = record {
  // Whether registration requires a cloud admission ticket.
  admission_required : bool;
  // Canister cycle balance.
  cycles : nat;
  // Stored sessions.
  sessions : nat64;
  // Stable memory pages.
  stable_pages : nat64;
  // Stored identities.
  identities : nat64;
  // Pending interactive challenges.
  challenges : nat64;
  // Whether initialization has produced the identity salt.
  ready : bool;
  // Current admission budgets.
  limits : AuthLimits;
};
// Login or logout-all assertion.
type AuthenticatePasskey = record {
  // One-use challenge returned for this caller.
  challenge : blob;
  // WebAuthn assertion result.
  response : PasskeyResponse;
};
// A hardware caller asks for one interactive operation.
type ChallengeRequest = record {
  // Operation to authorize.
  action : AuthAction;
  // P-256 SPKI DER; its self-authenticating Principal must be the caller.
  public_key : blob;
};
// Application errors returned by dMsg canisters and protocol helpers.
// Transport failures and Candid decoding failures are separate from this enum.
type Error = variant {
  // Required legacy key material is unavailable.
  MigrationKeyUnavailable;
  // Legacy business writes are frozen.
  LegacyWriteDisabled;
  // This Passkey identity already has the maximum number of login sessions.
  SessionLimitExceeded;
  // A supplied field or combination is invalid; carries a diagnostic.
  InvalidInput : text;
  // Another accepted operation owns the same product interval.
  IntervalReserved;
  // A neuron still supports a committed or pending product application.
  NeuronOccupied;
  // A new content root must be committed before writes can resume.
  RekeyRequired;
  // Expected version/generation differs from current state; reread before preparing a new approval.
  VersionConflict;
  // Execution may have occurred; reconcile the original request instead of creating another.
  ExecutionUnknown;
  // A digest, signature, proof or accounting invariant failed validation.
  IntegrityFailed;
  // Account-ID timestamp cannot fit the generator format.
  IdTimestampOutOfRange;
  // The requested record does not exist.
  NotFound;
  // The approved fee or available fee reserve cannot support the transfer.
  FeeBlocked;
  // The device is missing, revoked or not approved for this operation.
  DeviceNotApproved;
  // Sensitive operations are locked by account state or policy.
  Locked;
  // The source benefit is closing and cannot issue new leases.
  MembershipClosing;
  // Required recovery setup/confirmation has not completed.
  RecoveryIncomplete;
  // Account-ID counter space is exhausted for this timestamp.
  IdCapacityExceeded;
  // Approval or policy evidence refers to an outdated security state.
  PolicyStale;
  // Persisted account-ID allocator state does not match its configured namespace.
  IdGeneratorStateConflict;
  // An operation ID was reused with different parameters.
  IdempotencyConflict;
  // The profile, algorithm or protocol version is unsupported.
  UnsupportedProtocol;
  // A required service or resource is unavailable; carries a diagnostic.
  Unavailable : text;
  // Commercial qualification is temporarily unverifiable or its lease expired.
  MembershipStale;
  // Caller, role or capability does not authorize this operation.
  Forbidden;
  // Retained output is no longer available; this does not authorize replay.
  ResultExpired;
  // The applicable deadline has passed.
  Expired;
  // The subject is known to be ineligible for the requested benefit.
  MembershipIneligible;
  // An execution, cycle, storage or admission limit was exceeded.
  QuotaExceeded;
  // An authenticated and appropriately bound caller is required.
  AuthRequired;
  // The operation is not yet complete; query/retry the same operation as appropriate.
  Pending;
};
// The browser or native authenticator's response, with exact signed bytes.
type PasskeyResponse = record {
  // Assertion DER ES256 signature; empty for registration with none attestation.
  signature : blob;
  // Registration: attestationObject; assertions: authenticatorData.
  authenticator_data : blob;
  // Exact clientDataJSON bytes.
  client_data_json : blob;
  // Raw credential ID, also present in registration authenticator data.
  credential_id : blob;
};
// Registration additionally carries the existing account-admission ticket format.
type RegisterPasskey = record {
  // One-use challenge returned for this caller.
  challenge : blob;
  // Ticket bound to this canister and the hardware caller.
  admission : opt AdmissionTicket;
  // WebAuthn creation result.
  response : PasskeyResponse;
};
type Result = variant { Ok; Err : Error };
type Result_1 = variant { Ok : AuthDelegation; Err : Error };
type Result_2 = variant { Ok : nat64; Err : Error };
type Result_3 = variant { Ok : AuthChallenge; Err : Error };
type Result_4 = variant { Ok : text; Err : text };
service : (AuthInit) -> {
  admin_set_admission_key : (opt blob) -> (Result);
  admin_set_limits : (AuthLimits) -> (Result);
  auth_stats : () -> (AuthStats) query;
  get_delegation : (blob) -> (Result_1) query;
  login : (AuthenticatePasskey) -> (Result_2);
  logout : () -> (Result);
  logout_all : (AuthenticatePasskey) -> (Result);
  prepare_challenge : (ChallengeRequest) -> (Result_3);
  register : (RegisterPasskey) -> (Result_2);
  renew : () -> (Result_2);
  validate_admin_set_admission_key : (opt blob) -> (Result_4) query;
  validate_admin_set_limits : (AuthLimits) -> (Result_4) query;
}
