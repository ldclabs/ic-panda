// [Account](https://github.com/dfinity/ICRC-1/blob/main/standards/ICRC-3/README.md#value)
// representation of ledgers supporting the ICRC-1 standard.
type Account = record { owner : principal; subaccount : opt blob };
type AccountCommand = variant {
  DisputeRecovery : record { op_id : blob; dispute : blob };
  ConfirmRecovery : record { proof : blob };
  BindAuth : record { "principal" : principal; nonce : blob };
  ReserveRoot : record { op_id : blob; expected_generation : nat64 };
  RemoveAuth : record { "principal" : principal };
  AuthorizeHandle : record { intent : HandleIntent };
  SetRecovery : record { proof : blob; policy : RecoveryPolicy };
  AddDevice : record { device : DeviceInput; proof : blob };
  CommitRoot : record {
    op_id : blob;
    root : ContentRootRef;
    expected_generation : nat64;
  };
  RevokeDevice : record { device_id : blob };
  SetPolicy : record { policy : SensitivePolicy };
};
type AccountInfo = record {
  account_id : blob;
  status : AccountStatus;
  account_version : nat64;
  auth_bindings : vec principal;
  recovery_nonce : nat64;
  root_slot : opt RootReservation;
  security_epoch : nat64;
  pending_recovery : opt PendingRecovery;
  issuer : text;
  home_cose : principal;
  home_user : principal;
  sensitive_policy : SensitivePolicy;
  recovery : opt RecoveryPolicy;
  current_root : opt ContentRootRef;
  recovery_checked : bool;
  devices : vec record { blob; Device };
  vault_write_state : VaultWriteState;
};
type AccountMutation = record {
  account_id : blob;
  command : AccountCommand;
  approval : Approval;
  expected_version : nat64;
};
type AccountStatus = variant { Active; RecoveryDisputed };
type Algorithm = variant { VetKdBls12381; Ed25519; EcdsaSecp256k1 };
type Approval = record {
  request_id : blob;
  signature : blob;
  device_id : blob;
  security_epoch : nat64;
  expires_at : nat64;
  sequence : nat64;
};
type Capability = variant {
  FormalApprove;
  ContentSign;
  VaultUnlock;
  RootManage;
  PaymentOffer;
};
type CertifiedBatch = record {
  certificate : blob;
  schema : nat16;
  entries : vec CertifiedEntry;
  canister : principal;
};
type CertifiedEntry = record { key : blob; value : opt blob; witness : blob };
type ContentRootRef = record {
  key_generation : nat64;
  derivation_version : nat16;
  recovery_generation : nat64;
  generation : nat64;
  suite : text;
  home_cose : principal;
  bundle_digest : blob;
};
type ControllerRole = variant { Administrator; Member };
type CreateAccount = record {
  op_id : blob;
  device : DeviceInput;
  proof : blob;
  expires_at : nat64;
};
type DeriveRootRequest = record {
  account_id : blob;
  target : RootTarget;
  max_cycles : nat;
  approval : Approval;
  transport_public_key : blob;
};
type Device = record {
  added_at : nat64;
  added_by : opt blob;
  revoked_at : opt nat64;
  next_sequence : nat64;
  input : DeviceInput;
};
type DeviceInput = record {
  capabilities : vec Capability;
  role : ControllerRole;
  device_id : blob;
  hpke_pub : blob;
  signing_pub : blob;
};
type Environment = variant { Local; Production; Staging };
type Error = variant {
  MigrationKeyUnavailable;
  LegacyWriteDisabled;
  InvalidInput : text;
  RekeyRequired;
  VersionConflict;
  ExecutionUnknown;
  IntegrityFailed;
  IdTimestampOutOfRange;
  NotFound;
  FeeBlocked;
  DeviceNotApproved;
  Locked;
  RecoveryIncomplete;
  IdCapacityExceeded;
  PolicyStale;
  IdGeneratorStateConflict;
  IdempotencyConflict;
  UnsupportedProtocol;
  Unavailable : text;
  Forbidden;
  ResultExpired;
  Expired;
  QuotaExceeded;
  AuthRequired;
  Pending;
};
type ExecutionOutcome = variant {
  Failed : Error;
  Executing;
  Authorized;
  Unknown : Error;
  ResultExpired;
  Completed : ExecutionOutput;
};
type ExecutionOutput = variant {
  EncryptedRootKey : record { key : KeyDescriptor; encrypted_key : blob };
  Signature : record { key : KeyDescriptor; artifact : SignedArtifact };
};
type ExecutionResult = record {
  request_id : blob;
  charged_cycles : nat;
  outcome : ExecutionOutcome;
};
type HandleAction = variant { AcceptTransfer; Register; Transfer; ClaimLegacy };
type HandleIntent = record {
  account_id : blob;
  handle_canister : principal;
  target_account : opt blob;
  action : HandleAction;
  op_id : blob;
  handle : text;
  expected_version : nat64;
  terms_digest : blob;
};
type KeyDescriptor = record {
  account_id : blob;
  algorithm : Algorithm;
  key_generation : nat64;
  public_key_fingerprint : blob;
  derivation_version : nat16;
  public_key : blob;
  key_id : blob;
  home_cose : principal;
  environment : Environment;
  master_key_name : text;
  purpose : KeyPurpose;
};
type KeyPurpose = variant { ContentRoot; FileAttestation; Statement };
type OperationReceipt = record {
  id : blob;
  account_version : nat64;
  digest : blob;
};
type PaymentOffer = record {
  account_id : blob;
  quote_scope : blob;
  issued_at : nat64;
  recipient : Account;
  device_id : blob;
  security_epoch : nat64;
  version : nat64;
  ledger : principal;
  offer_id : blob;
  home_payment : principal;
  expires_at : nat64;
  recipient_net : nat;
};
type PendingRecovery = record {
  reconfirmed : bool;
  request : RecoveryRequest;
  execute_after : nat64;
  confirmation : opt RecoveryConfirmation;
  dispute : opt blob;
};
type RecoveryConfirmation = record {
  request_id : blob;
  dispute : blob;
  expires_at : nat64;
};
type RecoveryPolicy = record {
  delay_ms : nat64;
  generation : nat64;
  hpke_pub : blob;
  signing_pub : blob;
};
type RecoveryRequest = record {
  op_id : blob;
  generation : nat64;
  device : DeviceInput;
  new_auth : principal;
  expires_at : nat64;
};
type Result = variant { Ok; Err : Error };
type Result_1 = variant { Ok : blob; Err : Error };
type Result_2 = variant { Ok : ExecutionResult; Err : Error };
type Result_3 = variant { Ok : AccountInfo; Err : Error };
type Result_4 = variant {
  Ok : record { SecuritySnapshot; vec record { blob; Device } };
  Err : Error;
};
type Result_5 = variant { Ok : CertifiedBatch; Err : Error };
type Result_6 = variant { Ok : OperationReceipt; Err : Error };
type Result_7 = variant { Ok : opt PendingRecovery; Err : Error };
type Result_8 = variant { Ok : opt ContentRootRef; Err : Error };
type Result_9 = variant { Ok : nat64; Err : Error };
type RootReservation = record {
  op_id : blob;
  generation : nat64;
  security_epoch : nat64;
  expected_generation : nat64;
  expires_at : nat64;
};
type RootTarget = variant {
  Candidate : record { op_id : blob; generation : nat64 };
  Current : record { generation : nat64 };
};
type SecuritySnapshot = record {
  content_root_generation : nat64;
  account_id : blob;
  account_version : nat64;
  recovery_nonce : nat64;
  content_root_digest : opt blob;
  devices_root : blob;
  recovery_hpke_pub : opt blob;
  schema : nat16;
  security_epoch : nat64;
  recovery_root_version : nat64;
  issuer : text;
  home_cose : principal;
  home_user : principal;
  recovery_delay_ms : opt nat64;
  recovery_signing_pub : opt blob;
  vault_write_state : VaultWriteState;
  account_status : AccountStatus;
  pending_recovery_digest : opt blob;
};
type SensitivePolicy = record {
  daily_cycles : nat;
  daily_executions : nat32;
  frozen : bool;
  allowed_purposes : vec KeyPurpose;
};
type SignRequest = record {
  key : SigningKeyRef;
  account_id : blob;
  statement : Statement;
  // Checked browser origin; part of device approval, not of the portable statement.
  origin : text;
  max_cycles : nat;
  approval : Approval;
};
type SignedArtifact = record { cose_sign1 : blob; cose_key : blob };
type SignedOffer = record { signature : blob; offer : PaymentOffer };
// Only algorithms that can produce a formal signature.
type SigningAlgorithm = variant { Ed25519; EcdsaSecp256k1 };
// Small reference obtained from the authenticated key descriptor.
type SigningKeyRef = record {
  kid : blob;
  algorithm : SigningAlgorithm;
  public_key_fingerprint : blob;
};
type Statement = record {
  // Claimed Unix seconds, never a TSA assertion or execution deadline.
  issued_at : opt int64;
  content : StatementContent;
  // The object being described, not the account making the statement.
  subject : opt text;
  issuer : text;
};
type StatementContent = variant {
  Text : text;
  Digest : record {
    sha256 : blob;
    content_type : opt text;
    location : opt text;
  };
};
type UserInit = record {
  handle_canister : principal;
  home_cose : principal;
  issuer_namespace : text;
  daily_new_accounts : nat32;
  payment_canister : principal;
  environment : Environment;
  max_accounts : nat64;
};
type VaultWriteState = variant { RekeyRequired; Ready; Uninitialized };
service : (UserInit) -> {
  // Only the new authentication principal may reserve its own binding. The
  // existing account_id's administrator must separately approve the exact nonce.
  begin_auth_binding : (blob, blob, nat64) -> (Result);
  complete_recovery : (blob) -> (Result);
  consume_handle_authorization : (HandleIntent) -> (Result);
  create_account : (CreateAccount) -> (Result_1);
  derive_root : (DeriveRootRequest) -> (Result_2);
  get_account : (blob) -> (Result_3) query;
  get_device_bundle : (blob) -> (Result_4) query;
  get_execution : (blob, blob) -> (Result_2) query;
  get_execution_receipt : (blob, blob) -> (Result_5) query;
  get_operation : (blob, blob) -> (Result_6) query;
  get_recovery_request : (blob) -> (Result_7) query;
  get_root_ref : (blob) -> (Result_8) query;
  mutate_account : (AccountMutation) -> (Result_6);
  my_account : () -> (opt blob) query;
  prune_auth_bindings : (blob) -> (opt blob);
  reconcile_execution : (blob, blob) -> (Result_2);
  reconfirm_recovery : (blob, RecoveryConfirmation, blob) -> (Result);
  request_recovery : (blob, RecoveryRequest, blob, blob) -> (Result);
  security_snapshot_batch : (vec blob) -> (Result_5) query;
  sign : (SignRequest) -> (Result_2);
  verify_payment_offer : (SignedOffer) -> (Result_9);
}
