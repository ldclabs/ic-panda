// [Account](https://github.com/dfinity/ICRC-1/blob/main/standards/ICRC-3/README.md#value)
// representation of ledgers supporting the ICRC-1 standard.
type Account = record { owner : principal; subaccount : opt blob };
// Sensitive account mutation covered by an [`Approval`].
// Apply through [`AccountMutation`] with the expected account version.
type AccountCommand = variant {
  // Change only an existing device's capabilities under administrator approval.
  SetDeviceCapabilities : record {
    // Complete replacement capability set, subject to normal device validation.
    capabilities : vec Capability;
    // Existing device identity; keys and device role remain unchanged.
    device_id : blob;
  };
  // Bind the next self-held controller key, proving possession of its
  // private key with the matching protocol digest helper.
  RegisterController : record {
    // Raw Ed25519 public key of the controller.
    public_key : blob;
    // Explicit delegation ceiling chosen by the owner.
    delegation : DelegationAuthority;
    // Earlier generations whose credentials this key may manage.
    supersedes : vec nat32;
    // Optional display label.
    name : opt text;
    // Next unused controller generation.
    generation : nat32;
    // Controller Ed25519 proof of possession over the registration digest.
    proof : blob;
  };
  // Change the delayed-recovery waiting period (one to seven days).
  SetRecoveryDelay : record {
    // Recovery waiting period in milliseconds.
    delay_ms : nat64;
  };
  // Cancel a pending recovery; any active device may approve this.
  DisputeRecovery : record {
    // Operation ID of the pending recovery request.
    op_id : blob;
  };
  // Publish this account as an Agent Delegation principal with no controllers.
  EnablePrincipal : record {
    // Display type of the principal.
    principal_type : PrincipalType;
  };
  // Change only a controller's display label.
  RenameController : record {
    // New label, or None to remove it.
    name : opt text;
    // Controller generation.
    generation : nat32;
  };
  // Retire a current controller; it can never sign or return.
  RetireController : record {
    // Controller generation to retire.
    generation : nat32;
  };
  // Approve binding another login Principal. It is bound when that
  // Principal calls `accept_auth_binding` with the same nonce within ten
  // minutes; any security-epoch change withdraws the approval.
  BindAuth : record {
    // Login Principal to bind.
    "principal" : principal;
    // One-time challenge from the new login's binding request.
    nonce : blob;
  };
  // Reserve the next content-root generation using compare-and-swap.
  ReserveRoot : record {
    // Idempotency identifier; reuse only with identical operation parameters.
    op_id : blob;
    // Committed root generation expected for compare-and-swap.
    expected_generation : nat64;
  };
  // Remove a login Principal binding.
  RemoveAuth : record {
    // Login Principal to bind or remove.
    "principal" : principal;
  };
  // Authorize a specific operation at the configured name registry.
  AuthorizeHandle : record {
    // Account-authorized name operation.
    intent : HandleIntent;
  };
  // Enroll a device with proof of possession.
  AddDevice : record {
    // New device identity, keys and permissions to enroll.
    device : DeviceInput;
    // New device Ed25519 proof of possession; use the matching protocol digest helper.
    proof : blob;
  };
  // Commit the bundle reference for an active root reservation.
  CommitRoot : record {
    // Idempotency identifier; reuse only with identical operation parameters.
    op_id : blob;
    // Candidate encrypted root-bundle commitment to commit.
    root : ContentRootRef;
    // Committed root generation expected for compare-and-swap.
    expected_generation : nat64;
  };
  // Retire a controller if needed and record its earliest untrusted time.
  MarkControllerCompromised : record {
    // New cutoff; may only be added or moved earlier, never before `valid_from`.
    invalid_from : nat64;
    // Controller generation.
    generation : nat32;
  };
  // Revoke a device and invalidate affected security state.
  RevokeDevice : record {
    // 32-byte device identifier, distinct from its signing public key.
    device_id : blob;
  };
  // Replace sensitive execution policy.
  SetPolicy : record {
    // New recovery or sensitive-execution policy, as selected by the command.
    policy : SensitivePolicy;
  };
};
// Account query view, not a stable-storage record or a certified proof by itself.
type AccountInfo = record {
  // Stable 12-byte dMsg account identity; not a Principal or ledger account.
  account_id : blob;
  // Account mutation revision used for optimistic concurrency.
  account_version : nat64;
  // Login Principals bound to this stable dMsg account.
  auth_bindings : vec principal;
  // Outstanding root reservation, if present.
  root_slot : opt RootReservation;
  // Device enrolled by the latest completed recovery and the root generation
  // it may derive; None once that device commits a new root.
  recovered_device : opt record { blob; nat64 };
  // Account security revision used to invalidate stale approvals.
  security_epoch : nat64;
  // Immutable creation time recorded by the user home, in Unix milliseconds.
  created_at_ms : nat64;
  // Active delayed recovery procedure, if any.
  pending_recovery : opt PendingRecovery;
  // Canonical absolute issuer URI identifying the signer.
  issuer : text;
  // Fixed COSE canister responsible for recovery derivation.
  home_cose : principal;
  // User canister authoritative for this account or deployment.
  home_user : principal;
  // Configured recovery delay in milliseconds.
  recovery_delay_ms : nat64;
  // Account-specific attestation restrictions and budgets.
  sensitive_policy : SensitivePolicy;
  // Committed content-root bundle reference, if initialized.
  current_root : opt ContentRootRef;
  // Complete device map keyed by device ID, including revoked devices.
  devices : vec record { blob; Device };
  // Whether vault writes may proceed with the current root.
  vault_write_state : VaultWriteState;
};
// Compare-and-swap account update with device approval.
// The approval binds both the expected version and the complete command.
type AccountMutation = record {
  // Stable 12-byte dMsg account identity; not a Principal or ledger account.
  account_id : blob;
  // Complete account mutation covered by the approval.
  command : AccountCommand;
  // Device approval binding the complete request and replay context.
  approval : Approval;
  // Current record version required for compare-and-swap.
  expected_version : nat64;
};
// Named argument; the name must equal the schema field at its position.
type ActionArg = record {
  // Value of the declared field type.
  value : ActionValue;
  // Field name declared by the schema.
  name : text;
};
// Named values in schema order: a command's arguments or a record's fields.
type ActionArgs = vec record {
  value : variant {
    Nat : nat64;
    Artifact : record {
      uri : text;
      sha256 : blob;
      size : nat64;
      content_type : text;
    };
    Bool : bool;
    Hash : blob;
    Record : ActionArgs;
    List : vec ActionValue;
    Null;
    Text : text;
    Principal : principal;
    Choice : text;
  };
  name : text;
};
// Exact external artifact reference; no automatic URI fetching.
type ActionArtifact = record {
  // HTTPS or IPFS reference.
  uri : text;
  // Digest of exact bytes, not encoded digest text.
  sha256 : blob;
  // Exact size in bytes.
  size : nat64;
  // Declared content type.
  content_type : text;
};
// One command of the application's schema, with every declared argument.
type ActionCommand = record {
  // Every declared argument, in schema order.
  args : vec ActionArg;
  // Command name declared by the schema.
  name : text;
};
// Exact product file version presented for this action.
type ActionFile = record {
  // Exact SHA-256 bytes.
  sha256 : blob;
  // Media type, not inferred from the file name.
  media_type : text;
  // Exact byte length.
  byte_length : nat64;
  // Optional display name committed alongside the digest.
  display_name : opt text;
  // Immutable revision; positive.
  revision : nat64;
  // Whether bytes are plaintext originals or ciphertext.
  representation : ActionFileRepresentation;
  // Stable, product-scoped file locator.
  file_id : text;
};
// File digest interpretation. Neither value proves the original was read.
type ActionFileRepresentation = variant {
  // Hash names encrypted bytes.
  Encrypted;
  // Hash names the original bytes.
  Original;
};
// Closed value model shared by every application. There is no opaque byte value.
type ActionValue = variant {
  // Unsigned integer within the declared range.
  Nat : nat64;
  // Exact external artifact reference.
  Artifact : ActionArtifact;
  // Boolean shown with the schema's yes/no labels.
  Bool : bool;
  // Nonzero 32-byte commitment, shown in hex.
  Hash : blob;
  // Every field of a declared record, in schema order.
  Record : ActionArgs;
  // Items of one declared type.
  List : vec ActionValue;
  // Absent value of an optional field.
  Null;
  // Verbatim text, never interpreted as markup.
  Text : text;
  // Authenticated principal, shown in text form.
  Principal : principal;
  // One option value declared by the schema.
  Choice : text;
};
// Anti-abuse admission of one caller's account creation, signed by the home's
// configured issuer over the `dmsg/account-admission/v1` digest of
// `(home, caller, expires_at)`. It grants no account or device authority.
type AdmissionTicket = record {
  // Issuer Ed25519 signature over the admission digest.
  signature : blob;
  // Exclusive deadline in Unix milliseconds, at most ten minutes ahead.
  expires_at : nat64;
};
// Full application decision, separate from portable document statements.
// All timestamps are Unix milliseconds. No field is a caller-supplied display summary.
type AppAction = record {
  // Immutable file/version references, ordered by file_id.
  files : vec ActionFile;
  // Product's stable actor identity, opaque to dMsg and distinct from the signer.
  actor : blob;
  // Exact registration revision used for preparation.
  app_config_version : nat64;
  // Exact browser origin; unlike document profiles, this is in signed content.
  origin : text;
  // Exact dMsg account selected by the product preparation, distinct from actor.
  signing_account : blob;
  // Product request identity; not the dMsg execution identity.
  operation_id : blob;
  // Profile version, exactly one.
  version : nat16;
  // Typed product command, checked against the schema named by `schema_hash`.
  command : ActionCommand;
  // Governance registered application.
  app_id : text;
  // First valid time.
  issued_at_ms : nat64;
  // Deployment domain.
  environment : Environment;
  // Commitment to the complete product intent, including the product's own
  // subject, precondition, role and policy commitments.
  intent_hash : blob;
  // Canister that commits the product action.
  receiver : principal;
  // Exclusive end of the intent's validity window, at most five minutes.
  expires_at_ms : nat64;
  // Digest of the registered schema that gives the command its meaning.
  schema_hash : blob;
};
// Explicit application-action attestation. The user home confirms the exact
// body and account linkage with the registered product authority before it
// records the receipt.
type AppActionAttestRequest = record {
  // Account approving this action, separate from its product actor.
  account_id : blob;
  // Approving device's Ed25519 signature over the exact Sig_structure bytes.
  signature : blob;
  // Closed typed content obtained from the product preparation.
  action : AppAction;
  // Issuer must match the user's fixed account namespace.
  issuer : text;
  // Exact device approval and original execution identity.
  approval : Approval;
};
// Approved dMsg account and product beneficiary are deliberately separate.
type ApplicationApproval = record {
  // Exact service allowed to consume this approval.
  "service" : principal;
  // Economic actor, distinct from both account IDs and payer accounts.
  actor : principal;
  // Product-defined rights recipient; no inferred AccountId conversion.
  beneficiary : Beneficiary;
  // Exact application configuration revision.
  app_config_version : nat64;
  // Extension-verified browser origin.
  origin : text;
  // Complete cash/PANDA quotation or application action digest.
  action_digest : blob;
  // Idempotency identifier.
  operation_id : blob;
  // dMsg account whose device approves this action.
  approving_account : blob;
  // Integration version.
  version : nat16;
  // Registered application.
  app_id : text;
  // Fresh challenge.
  nonce : blob;
  // Deployment separation.
  environment : Environment;
  // Purpose-separated authorization.
  purpose : ApprovalPurpose;
  // Exclusive validity deadline in Unix milliseconds.
  expires_at_ms : nat64;
};
// Fresh read-only revalidation of an exact stored application approval.
type ApplicationAuthorization = record {
  // Device approval request ID, distinct from the product operation ID.
  approval_id : blob;
  // Exclusive deadline bounded by both application and device approval.
  valid_until_ms : nat64;
  // Current account security epoch.
  security_epoch : nat64;
  // Verification time in Unix milliseconds.
  verified_at_ms : nat64;
  // Exact ApplicationApproval commitment.
  approval_hash : blob;
};
// Device Ed25519 approval over a domain-separated operation digest.
// Construct the digest with the matching `dmsg_protocol` helper; signing the
// Serde encoding of this struct is not a valid approval.
type Approval = record {
  // Operation identity used to bind approval and reconcile retries.
  request_id : blob;
  // Device Ed25519 signature over the operation-specific approval digest.
  signature : blob;
  // 32-byte device identifier, distinct from its signing public key.
  device_id : blob;
  // Account security revision used to invalidate stale approvals.
  security_epoch : nat64;
  // Exclusive deadline in Unix milliseconds (`now < expires_at`).
  expires_at : nat64;
  // Next sequence expected for this device; contributes to replay protection.
  sequence : nat64;
};
// Exact purpose for account approval, distinct from product authorization.
type ApprovalPurpose = variant {
  // Cash order approval.
  CashCheckout;
  // Full subscription waiver approval.
  PandaSubscription;
};
// Device-signed formal statement submitted to the user home for a certified
// receipt. Freeze the statement and origin, sign the exact COSE Sig_structure
// with the approving device's key, then compute the approval over all three.
type AttestRequest = record {
  // Stable 12-byte dMsg account identity; not a Principal or ledger account.
  account_id : blob;
  // Approving device's Ed25519 signature over the exact Sig_structure
  // bytes, whose kid is the device key's RFC 9679 thumbprint.
  signature : blob;
  // Prepared or parsed document claims and content.
  statement : Statement;
  // Checked browser origin; part of device approval, not of the portable statement.
  origin : text;
  // Device approval binding the complete request and replay context.
  approval : Approval;
};
// Authentication purpose prevents login/link/reauthentication replay.
type AuthenticationPurpose = variant {
  // Confirm recent control for a sensitive product action.
  Reauthenticate;
  // Sign in or register a local product account.
  Login;
  // Link to an already authenticated product account.
  Link;
};
// Exact browser authentication request approved by a dMsg device.
type AuthenticationRequest = record {
  // Exact registration version used at approval time.
  app_config_version : nat64;
  // Actual extension-verified origin.
  origin : text;
  // Stable operation identity used during recovery.
  operation_id : blob;
  // SHA-256 of the product's temporary session public-key DER.
  session_key_hash : blob;
  // Authentication profile version.
  version : nat16;
  // Registered application.
  app_id : text;
  // Inclusive request time in Unix milliseconds.
  issued_at_ms : nat64;
  // Fresh product-generated nonce.
  nonce : blob;
  // Deployment separation.
  environment : Environment;
  // Pinned product authentication receiver.
  receiver : principal;
  // Purpose checked against the local pending challenge.
  purpose : AuthenticationPurpose;
  // Exclusive authentication deadline in Unix milliseconds.
  expires_at_ms : nat64;
  // Product challenge commitment, including any local account identity.
  challenge_hash : blob;
};
// Dedicated certified authentication leaf; never substitute SecuritySnapshot.
type AuthenticationResult = record {
  // Stable dMsg subject, distinct from the product's local account.
  account_id : blob;
  // Exact approved request.
  request : AuthenticationRequest;
  // Approved device identity; not its secret key.
  device_id : blob;
  // Account epoch consumed at approval.
  security_epoch : nat64;
  // Authentication profile version.
  version : nat16;
  // Expected IC certificate authority.
  home_user : principal;
  // Exclusive validity deadline, never later than the request deadline.
  expires_at_ms : nat64;
  // Approval time in Unix milliseconds.
  approved_at_ms : nat64;
};
// Product, authority and opaque subject binding; decoding does not establish control.
type Beneficiary = record {
  // Product identifier within this protocol.
  product_id : text;
  // Canister authoritative for the beneficiary subject.
  authority_canister : principal;
  // Opaque subject bytes in the registered schema.
  subject_bytes : blob;
  // Registered schema identifying how to interpret subject_bytes.
  subject_schema : text;
};
// Product-authoritative offer for one exact half-open subscription interval.
type BillingOffer = record {
  // Opaque product SKU, never interpreted by checkout.
  sku : text;
  // Registered product.
  product_id : text;
  // Typed recipient of product rights.
  beneficiary : Beneficiary;
  // Entire interval price in USD micro units, not an annualized price.
  amount_usd_micros : nat;
  // Operation identity fixed across retries.
  operation_id : blob;
  // Inclusive subscription start in Unix milliseconds.
  starts_at_ms : nat64;
  // Commerce version, currently two.
  version : nat16;
  // Registered application.
  app_id : text;
  // Quote issuance in Unix milliseconds.
  issued_at_ms : nat64;
  // Product-issued quote identifier.
  offer_id : blob;
  // Registered authoritative quote canister.
  quote_authority : principal;
  // Deployment separation.
  environment : Environment;
  // Product CAS revision, separate from qualification lease revision.
  expected_business_revision : nat64;
  // Registered product delivery canister.
  adapter : principal;
  // Explicit enabled settlement sources, without duplicates.
  allowed_settlement_methods : vec SettlementMethod;
  // Exclusive immutable end in Unix milliseconds.
  expires_at_ms : nat64;
  // Exclusive initial acceptance deadline; not an activation deadline.
  accept_by_ms : nat64;
  // Exact product terms accepted by the user.
  product_terms_hash : blob;
};
// Explicit device permission; authentication alone grants none of these rights.
type Capability = variant {
  // Approve formal document attestations.
  FormalApprove;
  // Sign ordinary content under device authority.
  ContentSign;
  // Read account ciphertext through the cloud service. The user home only
  // records it: every active device receives a content-root envelope.
  VaultUnlock;
  // Reserve and commit content roots.
  RootManage;
  // Authorize recipient payment offers.
  PaymentOffer;
};
// IC-certified query response. Merely decoding this value authenticates nothing.
// Verify the IC certificate against a trusted root, the expected canister and
// certificate time, then each witness, requested path and exact leaf bytes.
type CertifiedBatch = record {
  // IC data certificate bytes; verify against a trusted IC root key.
  certificate : blob;
  // Version of this public certified-leaf format, not the storage schema.
  schema : nat16;
  // Requested leaves and their membership/absence witnesses.
  entries : vec CertifiedEntry;
  // Canister identity to match against the expected service and certificate.
  canister : principal;
};
// One requested leaf and its IC hash-tree witness.
// A missing value must be checked as an absence proof, not treated as an empty leaf.
type CertifiedEntry = record {
  // Raw requested leaf path segment; compare with the exact expected path.
  key : blob;
  // Exact serialized leaf bytes, or None for requested absence.
  value : opt blob;
  // CBOR-encoded IC hash-tree witness for this requested leaf.
  witness : blob;
};
// Commitment to an encrypted root bundle stored outside the user canister.
// This contains neither the bundle nor a plaintext content key.
// The commit checks that `recipients_digest` names exactly the active devices
// and the vetKD recovery identity of this generation, and that
// `bundle_digest = digest("dmsg/root-bundle-digest/2", (recipients_digest, body_digest))`.
type ContentRootRef = record {
  // SHA-256 of the bundle body that carries the envelopes.
  body_digest : blob;
  // Reserved content-root generation being committed.
  generation : nat64;
  // Root bundle suite identifier; current commit validation requires `dmsg-root-v2`.
  suite : text;
  // `digest("dmsg/root-recipients/1", (sorted active device IDs, generation))`.
  recipients_digest : blob;
  // Commitment to the externally stored encrypted root bundle.
  bundle_digest : blob;
};
// Account device role, distinct from ICP canister controller privileges.
type ControllerRole = variant {
  // Device eligible for account administration, subject to required capabilities.
  Administrator;
  // Device with limited capabilities; not an account administrator.
  Member;
};
// Authenticated account creation with initial-device proof of possession.
// The user canister allocates the AccountId; clients do not choose it.
type CreateAccount = record {
  // Idempotency identifier; reuse only with identical operation parameters.
  op_id : blob;
  // Initial administrator device with its keys and requested capabilities.
  device : DeviceInput;
  // Issuer ticket; required when the home has an `admission_key`.
  admission : opt AdmissionTicket;
  // Initial device Ed25519 proof over the account-creation digest.
  proof : blob;
  // Exclusive deadline in Unix milliseconds (`now < expires_at`).
  expires_at : nat64;
};
// Delegation ceiling of a controller, immutable once published.
type DelegationAuthority = variant {
  // Only the listed exact scopes and relying-party audiences, and only credentials
  // owned within this key's lineage. Both lists are nonempty.
  Restricted : record {
    // Exact scope strings; no wildcard, prefix or hierarchy.
    scopes : vec text;
    // Relying-party origins or Agent IDs, matched exactly.
    audiences : vec text;
  };
  // `"*"`: any explicit scopes and audiences, and management of every credential
  // of this principal. Always an explicit owner choice.
  Unrestricted;
};
// Request the vetKD key of the committed content root, encrypted to a
// caller-generated transport public key. Authorized only for the device a
// completed delayed recovery enrolled, until that device commits a new root.
type DeriveRootRequest = record {
  // Stable 12-byte dMsg account identity; not a Principal or ledger account.
  account_id : blob;
  // Committed content-root generation to derive.
  generation : nat64;
  // Maximum ICP cycles approved for this execution; not a token amount.
  max_cycles : nat;
  // Device approval binding the complete request and replay context.
  approval : Approval;
  // 48-byte compressed vetKD transport public key; protocol validation checks the point.
  transport_public_key : blob;
};
// Registered device and replay/revocation state.
type Device = record {
  // Enrollment time in Unix milliseconds.
  added_at : nat64;
  // Approving device ID, when enrollment had an existing-device sponsor.
  added_by : opt blob;
  // Revocation time in Unix milliseconds, or None if not revoked.
  revoked_at : opt nat64;
  // Next device approval sequence expected by the user home.
  next_sequence : nat64;
  // Device identity, keys and permissions registered at enrollment.
  input : DeviceInput;
};
// Public keys, role and capabilities proposed for a device.
// The protocol validates keys and requires proof of possession for enrollment.
type DeviceInput = record {
  // Explicit operations permitted to this device.
  capabilities : vec Capability;
  // Account device role; capabilities are checked separately.
  role : ControllerRole;
  // 32-byte device identifier, distinct from its signing public key.
  device_id : blob;
  // 32-byte X25519 public key receiving content-root and channel HPKE envelopes.
  hpke_pub : blob;
  // 32-byte Ed25519 verification key; protocol validation rejects invalid/weak keys.
  signing_pub : blob;
};
// Encrypted vetKD output and the derivation-key descriptor.
// The vetKey it decrypts to opens the root bundle's IBE recovery envelope.
type EncryptedRootKey = record {
  // Public descriptor of the key used to produce this output.
  key : KeyDescriptor;
  // vetKD result encrypted to the supplied transport public key.
  encrypted_key : blob;
};
// Deployment domain used to separate identities and key derivation.
type Environment = variant {
  // Local development deployment.
  Local;
  // Production deployment with pinned chain-key configuration.
  Production;
  // Pre-production deployment domain.
  Staging;
};
// Application errors returned by dMsg canisters and protocol helpers.
// Transport failures and Candid decoding failures are separate from this enum.
type Error = variant {
  // Required legacy key material is unavailable.
  MigrationKeyUnavailable;
  // Legacy business writes are frozen.
  LegacyWriteDisabled;
  // A supplied field or combination is invalid; carries a diagnostic.
  InvalidInput : text;
  // Another accepted operation owns the same product interval.
  IntervalReserved;
  // A neuron still supports a committed or pending product application.
  NeuronOccupied;
  // A new content root must be committed before writes can resume.
  RekeyRequired;
  // Expected version/generation differs from current state; reread before preparing a new approval.
  VersionConflict;
  // Execution may have occurred; reconcile the original request instead of creating another.
  ExecutionUnknown;
  // A digest, signature, proof or accounting invariant failed validation.
  IntegrityFailed;
  // Account-ID timestamp cannot fit the generator format.
  IdTimestampOutOfRange;
  // The requested record does not exist.
  NotFound;
  // The approved fee or available fee reserve cannot support the transfer.
  FeeBlocked;
  // The device is missing, revoked or not approved for this operation.
  DeviceNotApproved;
  // Sensitive operations are locked by account state or policy.
  Locked;
  // The source benefit is closing and cannot issue new leases.
  MembershipClosing;
  // Required recovery setup/confirmation has not completed.
  RecoveryIncomplete;
  // Account-ID counter space is exhausted for this timestamp.
  IdCapacityExceeded;
  // Approval or policy evidence refers to an outdated security state.
  PolicyStale;
  // Persisted account-ID allocator state does not match its configured namespace.
  IdGeneratorStateConflict;
  // An operation ID was reused with different parameters.
  IdempotencyConflict;
  // The profile, algorithm or protocol version is unsupported.
  UnsupportedProtocol;
  // A required service or resource is unavailable; carries a diagnostic.
  Unavailable : text;
  // Commercial qualification is temporarily unverifiable or its lease expired.
  MembershipStale;
  // Caller, role or capability does not authorize this operation.
  Forbidden;
  // Retained output is no longer available; this does not authorize replay.
  ResultExpired;
  // The applicable deadline has passed.
  Expired;
  // The subject is known to be ineligible for the requested benefit.
  MembershipIneligible;
  // An execution, cycle, storage or admission limit was exceeded.
  QuotaExceeded;
  // An authenticated and appropriately bound caller is required.
  AuthRequired;
  // The operation is not yet complete; query/retry the same operation as appropriate.
  Pending;
};
// Formal executions one user home charged in a UTC month. Aggregate only:
// per-account usage stays readable by the account's own logins.
type ExecutionMonthStats = record {
  // Attestations committed in the month.
  attestations : nat64;
  // Weighted units charged in the month.
  charged_units : nat64;
  // Accounts charged at least once in the month.
  accounts : nat64;
  // UTC month as YYYYMM.
  month_utc : nat32;
};
// Execution lifecycle carrying either output or failure information.
type ExecutionOutcome = variant {
  // Execution returned a known failure.
  Failed : Error;
  // Execution has started and may be awaiting an external call.
  Executing;
  // Authorization is committed; no completed result is yet available.
  Authorized;
  // Execution outcome is uncertain; reconcile using the same request ID.
  Unknown : Error;
  // Retained output is no longer available; this does not authorize replay.
  ResultExpired;
  // Execution completed with a retained output.
  Completed : EncryptedRootKey;
};
// Query/retry view of a derivation and its conservative management-call cost bound.
type ExecutionResult = record {
  // Operation identity used to bind approval and reconcile retries.
  request_id : blob;
  // Conservative ICP cost upper bound, including maximum response/callback
  // reservations, less refunded attached cycles. Not an actual charge or bill.
  // Zero before dispatch or when the management call was not sent.
  cycles_cost_upper_bound : nat;
  // Threshold fee the returned management call consumed: its attached
  // request cycles less the refund. Set on Completed and Failed results,
  // zero otherwise; daily budgets settle to it. Excludes message fees.
  cycles_charged : nat;
  // Execution state with any available output or error.
  outcome : ExecutionOutcome;
};
// Monthly execution counters of one account; retrying an attestation does not charge again.
type ExecutionUsage = record {
  // Stable 12-byte dMsg account identity.
  account_id : blob;
  // Revision of business terms or qualification, independent of lease refreshes.
  business_revision : nat64;
  // Exclusive validity deadline in Unix milliseconds.
  valid_until_ms : nat64;
  // Monotonic projection/lease revision, including refreshes.
  lease_revision : nat64;
  // Total monthly units, rounding down once after summing weighted durations.
  allowed_units : nat64;
  // Units charged to attestations; each is charged when it commits.
  charged_units : nat64;
  // Execution weight version used for this accounting.
  weight_policy_version : nat64;
  // Revision of the retained monthly calculation.
  month_revision : nat64;
  // UTC year and month encoded as YYYYMM.
  month_utc : nat32;
};
// Name ownership operation authorized by an account.
type HandleAction = variant {
  // Accept a proposed ownership transfer.
  AcceptTransfer;
  // Register an available canonical name.
  Register;
  // Propose transfer of an owned name.
  Transfer;
  // Claim a name reserved in a frozen legacy snapshot.
  ClaimLegacy;
};
// Exact name operation authorized by the user home for the handle canister.
type HandleIntent = record {
  // Stable 12-byte dMsg account identity; not a Principal or ledger account.
  account_id : blob;
  // Name registry responsible for this operation/deployment.
  handle_canister : principal;
  // Recipient account for transfer-related operations, when required.
  target_account : opt blob;
  // Name ownership action being authorized.
  action : HandleAction;
  // Idempotency identifier; reuse only with identical operation parameters.
  op_id : blob;
  // Canonical name: lowercase ASCII letters/digits/underscore, 1..19 bytes; no leading underscore.
  handle : text;
  // Current record version required for compare-and-swap.
  expected_version : nat64;
  // Commitment to action-specific terms, including charge terms when applicable.
  terms_digest : blob;
};
// Controller record. The key is generated and held by the owner's client;
// key, `valid_from`, `delegation` and `supersedes` never change.
type HostedController = record {
  // Earliest untrusted signature time after compromise; requires retirement.
  invalid_from : opt nat64;
  // Raw Ed25519 public key of this generation; the Agent ID encodes it.
  public_key : blob;
  // Delegation ceiling of this key.
  delegation : DelegationAuthority;
  // Earlier generations of this principal whose credentials this key may manage.
  supersedes : vec nat32;
  // Optional display label; the only field that may change.
  name : opt text;
  // Positive controller generation, allocated once and never reused.
  generation : nat32;
  // Binding start (inclusive): the user-home commit time.
  valid_from : nat64;
  // Binding end (exclusive) once retired; None while current.
  retired_at : opt nat64;
};
// Public provenance of the content-root vetKD key.
// Authenticate its source before encrypting to it: key identity depends on the
// home canister and derivation configuration.
type KeyDescriptor = record {
  // Stable 12-byte dMsg account identity; not a Principal or ledger account.
  account_id : blob;
  // Content-root generation this descriptor was requested for; it is the
  // IBE identity together with the account ID.
  key_generation : nat64;
  // SHA-256 of `public_key`; the configured master pin.
  public_key_fingerprint : blob;
  // Key derivation format version; current public protocol uses 2.
  derivation_version : nat16;
  // Raw 96-byte vetKD derived public key of the content-root context,
  // shared by every account of this executor.
  public_key : blob;
  // Fixed COSE canister responsible for key derivation and execution.
  home_cose : principal;
  // Deployment domain used in validation and derivation.
  environment : Environment;
  // ICP master-key name used for this derived key.
  master_key_name : text;
};
// Policy domain of a formal statement, derived from its content profile.
type KeyPurpose = variant {
  // Typed product actions; not a generic document.
  AppAction;
  // SHA-256 document attestations.
  FileAttestation;
  // Text and structured file statements.
  Statement;
};
// Idempotent account mutation result, distinct from a certified execution receipt.
type OperationReceipt = record {
  // Operation identifier for idempotent lookup.
  id : blob;
  // Account mutation revision used for optimistic concurrency.
  account_version : nat64;
  // Domain-separated commitment to this operation and its parameters.
  digest : blob;
};
// Recipient device authorization of fixed payment terms.
// Signed under `dmsg/payment-offer/v1`; does not itself open or fund an escrow.
type PaymentOffer = record {
  // Stable 12-byte dMsg account identity; not a Principal or ledger account.
  account_id : blob;
  // Opaque commitment binding the quote to the offer application scope.
  quote_scope : blob;
  // Offer issuance time in Unix milliseconds (unlike Statement::issued_at).
  issued_at : nat64;
  // ICRC account receiving the quoted net payment.
  recipient : Account;
  // 32-byte device identifier, distinct from its signing public key.
  device_id : blob;
  // Account security revision used to invalidate stale approvals.
  security_epoch : nat64;
  // Revision of this record/authorization, used for stale-state checks.
  version : nat64;
  // ICRC ledger canister for all amounts in this contract.
  ledger : principal;
  // Recipient-generated payment offer identifier.
  offer_id : blob;
  // Payment canister authoritative for this escrow/offer.
  home_payment : principal;
  // Exclusive deadline in Unix milliseconds (`now < expires_at`).
  expires_at : nat64;
  // Amount owed to the recipient, excluding fees, in ledger base units.
  recipient_net : nat;
};
// Delayed recovery state. A dispute by an active device cancels it.
type PendingRecovery = record {
  // Original delayed recovery proposal.
  request : RecoveryRequest;
  // Earliest recovery execution time in Unix milliseconds.
  execute_after : nat64;
};
// Owner view of a principal, including publication state.
type PrincipalInfo = record {
  // Current authoritative state in the user home.
  state : PrincipalState;
  // Canonical principal URL `principal_origin/<account_id>`.
  principal_id : text;
  // Highest version the directory confirmed; the change is live only when it equals `state.version`.
  published_version : nat64;
};
// Account principal state published by the directory.
// `version` and `updated_at` both increase strictly on every change.
type PrincipalState = record {
  // Document `updated_at`: `max(now, previous + 1)` on every change.
  updated_at : nat64;
  // Current and retired controllers in generation order.
  controllers : vec HostedController;
  // Display type of the principal.
  principal_type : PrincipalType;
  // Publication version; the directory rejects rollback.
  version : nat64;
};
// Display type of a principal; it grants no authority.
type PrincipalType = variant {
  // A team inside or across organizations.
  Team;
  // A natural person.
  Person;
  // A company or other legal organization.
  Organization;
  // A project.
  Project;
  // Any other non-agent subject.
  Other;
};
// Explicit product permission; not a claim that the payer has a project role.
type ProductApproval = record {
  // Accepted settlement method.
  method : SettlementMethod;
  // Product-owned approval identity.
  approval_id : blob;
  // Exact bill accepted by the product operator.
  offer_hash : blob;
  // Operator whose product permissions must remain valid at delivery.
  operator : principal;
  // Protocol version two.
  version : nat16;
  // Exclusive application deadline, never extended on retry.
  expires_at_ms : nat64;
  // Approval time.
  approved_at_ms : nat64;
};
// Fresh replicated product authorization; no interval is reserved by this read.
type ProductAuthorization = record {
  // Digest of all authorization inputs.
  request_hash : blob;
  // Authenticated product operator, separate from the economic actor.
  operator : principal;
  // Exclusive freshness boundary.
  valid_until_ms : nat64;
  // Check time.
  verified_at_ms : nat64;
};
// Inputs authenticated by checkout/membership before asking the product authority.
type ProductAuthorizationRequest = record {
  // Explicit product approval; a personal-account adapter may derive owner consent from account_approval.
  product_approval : opt ProductApproval;
  // dMsg device-approved account and economic actor.
  account_approval : ApplicationApproval;
  // Exact device approval record.
  approval_id : blob;
  // Registered dMsg user home that verified the approval.
  user_home : principal;
  // Exact authoritative bill.
  offer : BillingOffer;
};
// Login-authorized proposal for a replacement device, executed after the
// account's recovery delay unless an active device disputes it.
type RecoveryRequest = record {
  // Idempotency identifier; reuse only with identical operation parameters.
  op_id : blob;
  // Replacement device to enroll when recovery completes.
  device : DeviceInput;
  // Login Principal that submits the request and is bound after recovery completes.
  new_auth : principal;
  // Exclusive deadline in Unix milliseconds (`now < expires_at`).
  expires_at : nat64;
};
type Result = variant { Ok; Err : Error };
type Result_1 = variant { Ok : blob; Err : Error };
type Result_10 = variant { Ok : ExecutionUsage; Err : Error };
type Result_11 = variant { Ok : OperationReceipt; Err : Error };
type Result_12 = variant { Ok : PrincipalInfo; Err : Error };
type Result_13 = variant { Ok : opt PendingRecovery; Err : Error };
type Result_14 = variant { Ok : opt ContentRootRef; Err : Error };
type Result_15 = variant { Ok : nat64; Err : Error };
type Result_16 = variant { Ok : text; Err : text };
type Result_17 = variant { Ok : ApplicationAuthorization; Err : Error };
type Result_2 = variant { Ok : AuthenticationResult; Err : Error };
type Result_3 = variant { Ok : SignedArtifact; Err : Error };
type Result_4 = variant { Ok : CertifiedBatch; Err : Error };
type Result_5 = variant { Ok : ProductAuthorization; Err : Error };
type Result_6 = variant { Ok : blob; Err : Error };
type Result_7 = variant { Ok : ExecutionResult; Err : Error };
type Result_8 = variant { Ok : AccountInfo; Err : Error };
type Result_9 = variant {
  Ok : record { SecuritySnapshot; vec record { blob; Device } };
  Err : Error;
};
// Temporary compare-and-swap slot for a candidate content root.
type RootReservation = record {
  // Idempotency identifier; reuse only with identical operation parameters.
  op_id : blob;
  // Allocated candidate generation; abandoned reservations may leave gaps.
  generation : nat64;
  // Account security revision used to invalidate stale approvals.
  security_epoch : nat64;
  // Committed root generation expected for compare-and-swap.
  expected_generation : nat64;
  // Exclusive deadline in Unix milliseconds (`now < expires_at`).
  expires_at : nat64;
};
// Certified account security leaf (current schema 4).
// The leaf path is the single raw 12-byte account ID. `devices_root` commits
// to the complete device map, including revocation and replay state. Verify
// certificate, witness and freshness before using it as authority.
type SecuritySnapshot = record {
  // Committed content-root generation; zero before initialization.
  content_root_generation : nat64;
  // Stable 12-byte dMsg account identity; not a Principal or ledger account.
  account_id : blob;
  // Account mutation revision used for optimistic concurrency.
  account_version : nat64;
  // Committed root-bundle digest, or None before initialization.
  content_root_digest : opt blob;
  // `dmsg/devices/v1` digest of the complete BTreeMap<Hash, Device>.
  devices_root : blob;
  // `updated_at` of the account's current principal state, or None before
  // the principal is enabled. A published document older than this is stale.
  principal_updated_at : opt nat64;
  // Version of this public certified-leaf format, not the storage schema.
  schema : nat16;
  // Account security revision used to invalidate stale approvals.
  security_epoch : nat64;
  // Canonical absolute issuer URI identifying the signer.
  issuer : text;
  // Fixed COSE canister responsible for recovery derivation.
  home_cose : principal;
  // User canister authoritative for this account or deployment.
  home_user : principal;
  // Configured recovery delay in milliseconds.
  recovery_delay_ms : nat64;
  // Whether vault writes may proceed with the current root.
  vault_write_state : VaultWriteState;
  // Commitment to pending recovery state, if any.
  pending_recovery_digest : opt blob;
};
// Account limits on formal attestations and recovery derivations.
// The default permits statement, file and app-action attestations, 20 per
// day, which is also the user home's ceiling for root derivations.
type SensitivePolicy = record {
  // Maximum executions in a daily budget window.
  daily_executions : nat32;
  // Whether sensitive execution is frozen by account policy.
  frozen : bool;
  // Statement purposes allowed by this policy.
  allowed_purposes : vec KeyPurpose;
};
// Mutually exclusive settlement sources. PANDA always covers the entire offer.
type SettlementMethod = variant {
  // One explicitly enabled ledger.
  Cash;
  // Full subscription waiver without any cash transfer.
  Panda;
};
// Portable signed document plus a public-only COSE_Key.
// The attached key supports mathematical verification but does not establish
// who owns the key or whether the signer had authority.
type SignedArtifact = record {
  // Tagged RFC 9052 COSE_Sign1 CBOR bytes.
  cose_sign1 : blob;
  // Public-only COSE_Key CBOR bytes; never include private key parameters.
  cose_key : blob;
};
// Payment offer and its device Ed25519 signature over the offer digest.
type SignedOffer = record {
  // Device Ed25519 signature over the `dmsg/payment-offer/v1` digest.
  signature : blob;
  // Recipient authorization signed by a permitted device.
  offer : PaymentOffer;
};
// Portable statement preparation/parsed view, not the COSE wire payload.
// The issuer and optional claims become protected headers; content determines
// the document or explicit application-action profile. Use `dmsg_protocol` to validate and encode it.
type Statement = record {
  // Claimed Unix seconds, never a TSA assertion or execution deadline.
  issued_at : opt int64;
  // Document content and profile selection.
  content : StatementContent;
  // The object being described, not the account making the statement.
  subject : opt text;
  // Canonical absolute issuer URI identifying the signer.
  issuer : text;
};
// Closed payload selection. Application actions cannot use the document-only endpoint.
type StatementContent = variant {
  // Explicit application action profile; never accepted by the generic document signer.
  AppAction : AppAction;
  // A statement about one exact file, encoded as deterministic CBOR.
  // The text conveys no automatic approval, authority or proof of file review.
  FileStatement : record {
    // SHA-256 of the exact original file bytes.
    sha256 : blob;
    // Raw UTF-8 text, 1..4096 bytes; preserved without normalization.
    "text" : text;
    // Optional file media type, included in the signed payload.
    content_type : opt text;
    // Optional file URI; verification never fetches it automatically.
    location : opt text;
  };
  // Raw UTF-8 text, 1..4096 bytes; no whitespace trimming or Unicode normalization.
  Text : text;
  // SHA-256 document profile with optional original-content metadata.
  Digest : record {
    // SHA-256 of the exact original bytes, not their encoded digest text.
    sha256 : blob;
    // Optional original media type; metadata does not verify the original bytes.
    content_type : opt text;
    // Optional original-content URI; verification does not fetch it automatically.
    location : opt text;
  };
};
// Deployment configuration and account-creation limits for the user home.
type UserInit = record {
  // Name registry responsible for this operation/deployment.
  handle_canister : principal;
  // Ed25519 public key of the account admission issuer. When set,
  // `create_account` requires an [`AdmissionTicket`] signed by it; None
  // admits any authenticated caller. Adjustable by governance.
  admission_key : opt blob;
  // HTTPS origin of Agent Delegation principal IDs, such as `https://id.dmsg.net`.
  // Permanent: principal IDs never change.
  principal_origin : text;
  // Fixed COSE canister responsible for recovery derivation.
  home_cose : principal;
  // Fixed issuer URI prefix; ends in `/` or `:` with no query or fragment.
  issuer_namespace : text;
  // Account creation limit per UTC day (1..=100,000); adjustable by governance.
  daily_new_accounts : nat32;
  // Configured escrow service.
  payment_canister : principal;
  // Deployment domain used in validation and derivation.
  environment : Environment;
  // Fixed product commerce service, authoritative for resource leases.
  commerce_canister : principal;
  // Fixed SNS governance caller allowed, besides controllers, to adjust
  // account limits and the admission key.
  governance : principal;
  // Maximum accounts admitted by this home (1..=21,000,000, [`MAX_HOME_ACCOUNTS`]);
  // adjustable by governance.
  max_accounts : nat64;
  // Shared PANDA qualification service.
  membership_canister : principal;
  // Directory canister that publishes principal documents.
  directory_canister : principal;
};
// Operational counters of a user home.
type UserStats = record {
  // UTC day (days since the Unix epoch) of `created_today`.
  day : nat64;
  // Whether the device unlock secret has been generated.
  unlock_ready : bool;
  // Accounts created on `day`.
  created_today : nat32;
  // Cycle balance.
  cycles : nat;
  // Accounts this home allocated.
  accounts : nat64;
  // Configured daily new-account quota.
  daily_new_accounts : nat32;
  // Formal-execution totals of the latest charged months, newest first;
  // a month without charges is absent.
  execution_months : vec ExecutionMonthStats;
  // Configured account capacity.
  max_accounts : nat64;
  // Stable memory in 64 KiB pages.
  stable_pages : nat64;
};
// Whether new vault writes may use the committed root.
type VaultWriteState = variant {
  // A new content root must be committed before writes can resume.
  RekeyRequired;
  // Required material is initialized and ready for use.
  Ready;
  // Required material has not been initialized.
  Uninitialized;
};
service : (UserInit) -> {
  // A new login accepts the binding an administrator approved for it with the
  // nonce of its own request. Retrying after success returns Ok.
  accept_auth_binding : (blob, blob) -> (Result);
  // Set the account capacity and the daily new-account quota. A capacity below
  // the current count only stops new accounts.
  admin_set_account_limits : (nat64, nat32) -> (Result);
  // Set or clear the Ed25519 key whose tickets admit new accounts. Clearing it
  // admits any authenticated caller, within the account limits.
  admin_set_admission_key : (opt blob) -> (Result);
  approve_application : (ApplicationApproval, Approval) -> (Result_1);
  approve_authentication : (blob, AuthenticationRequest, Approval) -> (
      Result_2,
    );
  // Record a device-signed document statement and certify its receipt.
  // Application actions use `attest_app_action`.
  attest : (AttestRequest) -> (Result_3);
  // Record a device-signed application action after the registered product
  // authority confirms it, and certify its receipt.
  attest_app_action : (AppActionAttestRequest) -> (Result_3);
  authentication_certificate : (blob, blob) -> (Result_4) query;
  // Personal-account product consent. Project products use their own registered authority.
  authorize_product_billing : (ProductAuthorizationRequest) -> (Result_5);
  complete_recovery : (blob, blob) -> (Result);
  consume_handle_authorization : (HandleIntent) -> (Result);
  consume_handle_transfer_authorizations : (HandleIntent, HandleIntent) -> (
      Result,
    );
  create_account : (CreateAccount) -> (Result_6);
  // A recovered device's vetKD derivation of the committed root; see
  // `DeriveRootRequest`. Retries with the same request return the stored result;
  // a new approval derives again until the device commits a new root.
  derive_root : (DeriveRootRequest) -> (Result_7);
  get_account : (blob) -> (Result_8) query;
  // The retained artifact of an attestation, for a client resuming after a lost reply.
  get_attestation : (blob, blob) -> (Result_3) query;
  get_device_bundle : (blob) -> (Result_9) query;
  // The retained result of a derivation; attestations are read with `get_attestation`.
  get_execution : (blob, blob) -> (Result_7) query;
  get_execution_receipt : (blob, blob) -> (Result_4) query;
  get_execution_usage : (blob, nat32) -> (Result_10) query;
  get_operation : (blob, blob) -> (Result_11) query;
  // Public principal state and publication progress.
  get_principal : (blob) -> (Result_12) query;
  get_recovery_request : (blob) -> (Result_13) query;
  get_root_ref : (blob) -> (Result_14) query;
  inspect_app_action : (blob, AppAction) -> (Result);
  mutate_account : (AccountMutation) -> (Result_11);
  my_account : () -> (opt blob) query;
  // Release expired terminal results across accounts, one page of execution
  // records after the cursor; anyone may run it. Start from an empty cursor and
  // continue with the returned key until it returns None.
  prune_executions : (blob) -> (opt blob);
  // Bounded public cleanup removes only expired authentication/approval records.
  prune_external_approvals : (blob) -> (opt blob);
  // Push the account's current principal state to the directory. Anyone may
  // retry a publication; it is idempotent and never rolls the document back.
  publish_principal : (blob) -> (Result_15);
  reconcile_execution : (blob, blob) -> (Result_7);
  refresh_execution_entitlement : (blob) -> (Result_10);
  // Begin a delayed takeover from a bound login: after the account's recovery
  // delay, `complete_recovery` replaces every device and binding with these.
  // Any active device cancels it with `DisputeRecovery`.
  request_recovery : (blob, RecoveryRequest, blob) -> (Result);
  security_snapshot_batch : (vec blob) -> (Result_4) query;
  // The secret a bound login fetches to unlock one device's local store. It is
  // refused for revoked devices, so revocation also locks the device's copy.
  unlock_secret : (blob, blob) -> (Result_6) query;
  // Installed configuration with the current account limits. Services check it
  // before they list this home with `admin_add_user_home`.
  user_config : () -> (UserInit) query;
  // Account count, capacity, today's admissions, unlock readiness, stable
  // pages, the cycle balance and monthly formal-execution totals.
  user_stats : () -> (UserStats) query;
  validate_admin_set_account_limits : (nat64, nat32) -> (Result_16) query;
  validate_admin_set_admission_key : (opt blob) -> (Result_16) query;
  // Read-only revalidation by the fixed consumer. It creates no product order or claim.
  verify_application_authorization : (blob, ApplicationApproval) -> (Result_17);
  verify_payment_offer : (SignedOffer) -> (Result_15);
  // A registered product may check whether its own account beneficiary still exists.
  verify_product_account : (text, Beneficiary) -> (Result);
}
