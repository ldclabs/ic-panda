{
  "name": "dmsg_app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5176",
    "check": "svelte-check --tsgo --tsconfig ./tsconfig.json && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:cloud": "node scripts/test-cloud.mjs",
    "test:inventory": "node --test scripts/legacy-inventory.test.mjs",
    "test:cose-prune": "node --test scripts/cose-prune.test.mjs",
    "cose:prune": "node scripts/cose-prune.mjs",
    "build": "vite build && node scripts/verify-build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4176",
    "bindings": "node scripts/bindings.mjs",
    "test:account": "node scripts/test-cloud.mjs account"
  },
  "dependencies": {
    "@dmsg/legacy": "workspace:*",
    "@hpke/core": "^1.9.0",
    "@hpke/dhkem-x25519": "^1.8.0",
    "@icp-sdk/core": "^6.1.0",
    "@icp-sdk/signer": "^6.0.0",
    "@icp-sdk/vetkeys": "0.7.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "cborg": "^6.1.3",
    "dmsg-sdk": "workspace:*",
    "idb": "^8.0.4",
    "svelte": "^5.57.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "@typescript/native": "npm:typescript@~7.0.2",
    "fake-indexeddb": "^6.2.5",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
