// Deployment configuration for the COSE executor.
// Production validation requires `key_1` and a nonzero fingerprint;
// changing derivation inputs changes key identity.
type CoseInit = record {
  // Expected identity of this COSE executor.
  executing_canister : principal;
  // Key derivation format version; current public protocol uses 2.
  derivation_version : nat16;
  // Maximum reserved ICP cycles in a daily budget window; adjustable by governance.
  daily_cycles : nat;
  // Fixed issuer URI prefix; ends in `/` or `:` with no query or fragment.
  issuer_namespace : text;
  // Maximum derivations in a daily budget window; adjustable by governance.
  daily_executions : nat32;
  // Deployment domain used in validation and derivation.
  environment : Environment;
  // vetKD master-key pin.
  master : MasterKey;
  // Fixed SNS governance caller allowed, besides controllers, to run administrative operations.
  governance : principal;
  // User homes authorized to supply execution grants, each only for the
  // accounts whose IDs carry its allocator fingerprint. Append-only.
  user_homes : vec principal;
};
// Operational counters of a COSE executor.
type CoseStats = record {
  // Derivations counted today against `daily_executions`.
  executions_today : nat32;
  // Retained execution results.
  results : nat64;
  // Cycle balance.
  cycles : nat;
  // UTC day (days since the Unix epoch) of the usage below.
  budget_day : nat64;
  // Accounts that have reached this executor; their records are kept.
  accounts : nat64;
  // Management calls this module instance is awaiting.
  in_flight : nat64;
  // Account capacity shared by every configured user home.
  max_accounts : nat64;
  // Stable memory in 64 KiB pages.
  stable_pages : nat64;
  // Executions recorded as Unknown, including calls an upgrade abandoned.
  unknown : nat64;
  // Reserved or settled cycles today against `daily_cycles`.
  cycles_today : nat;
};
// Encrypted vetKD output and the derivation-key descriptor.
// The vetKey it decrypts to opens the root bundle's IBE recovery envelope.
type EncryptedRootKey = record {
  // Public descriptor of the key used to produce this output.
  key : KeyDescriptor;
  // vetKD result encrypted to the supplied transport public key.
  encrypted_key : blob;
};
// Deployment domain used to separate identities and key derivation.
type Environment = variant {
  // Local development deployment.
  Local;
  // Production deployment with pinned chain-key configuration.
  Production;
  // Pre-production deployment domain.
  Staging;
};
// Application errors returned by dMsg canisters and protocol helpers.
// Transport failures and Candid decoding failures are separate from this enum.
type Error = variant {
  // Required legacy key material is unavailable.
  MigrationKeyUnavailable;
  // Legacy business writes are frozen.
  LegacyWriteDisabled;
  // A supplied field or combination is invalid; carries a diagnostic.
  InvalidInput : text;
  // Another accepted operation owns the same product interval.
  IntervalReserved;
  // A neuron still supports a committed or pending product application.
  NeuronOccupied;
  // A new content root must be committed before writes can resume.
  RekeyRequired;
  // Expected version/generation differs from current state; reread before preparing a new approval.
  VersionConflict;
  // Execution may have occurred; reconcile the original request instead of creating another.
  ExecutionUnknown;
  // A digest, signature, proof or accounting invariant failed validation.
  IntegrityFailed;
  // Account-ID timestamp cannot fit the generator format.
  IdTimestampOutOfRange;
  // The requested record does not exist.
  NotFound;
  // The approved fee or available fee reserve cannot support the transfer.
  FeeBlocked;
  // The device is missing, revoked or not approved for this operation.
  DeviceNotApproved;
  // Sensitive operations are locked by account state or policy.
  Locked;
  // The source benefit is closing and cannot issue new leases.
  MembershipClosing;
  // Required recovery setup/confirmation has not completed.
  RecoveryIncomplete;
  // Account-ID counter space is exhausted for this timestamp.
  IdCapacityExceeded;
  // Approval or policy evidence refers to an outdated security state.
  PolicyStale;
  // Persisted account-ID allocator state does not match its configured namespace.
  IdGeneratorStateConflict;
  // An operation ID was reused with different parameters.
  IdempotencyConflict;
  // The profile, algorithm or protocol version is unsupported.
  UnsupportedProtocol;
  // A required service or resource is unavailable; carries a diagnostic.
  Unavailable : text;
  // Commercial qualification is temporarily unverifiable or its lease expired.
  MembershipStale;
  // Caller, role or capability does not authorize this operation.
  Forbidden;
  // Retained output is no longer available; this does not authorize replay.
  ResultExpired;
  // The applicable deadline has passed.
  Expired;
  // The subject is known to be ineligible for the requested benefit.
  MembershipIneligible;
  // An execution, cycle, storage or admission limit was exceeded.
  QuotaExceeded;
  // An authenticated and appropriately bound caller is required.
  AuthRequired;
  // The operation is not yet complete; query/retry the same operation as appropriate.
  Pending;
};
// Public maintenance page of expired COSE execution results.
// The caller supplies next_after to continue, including across upgrades.
type ExecutionCleanup = record {
  // Exclusive account cursor for the next page; None ends this pass.
  next_after : opt blob;
  // Number of homes inspected (at most 64).
  homes_scanned : nat32;
  // Expired terminal results deleted; replay high-water marks are preserved.
  results_removed : nat32;
};
// User-home authorization passed to the configured COSE home.
// This is a restricted cross-canister contract, not a bearer token that any
// caller may construct and redeem.
type ExecutionGrant = record {
  // Stable 12-byte dMsg account identity; not a Principal or ledger account.
  account_id : blob;
  // Operation identity used to bind approval and reconcile retries.
  request_id : blob;
  // Device approval sequence consumed by this authorization.
  device_sequence : nat64;
  // User-home execution sequence for replay protection.
  execution_sequence : nat64;
  // Committed content-root generation to derive.
  generation : nat64;
  // Time authorization was accepted, in Unix milliseconds.
  approved_at : nat64;
  // 32-byte device identifier, distinct from its signing public key.
  device_id : blob;
  // Account security revision used to invalidate stale approvals.
  security_epoch : nat64;
  // Fixed COSE canister responsible for key derivation and execution.
  home_cose : principal;
  // Maximum ICP cycles approved for this execution; not a token amount.
  max_cycles : nat;
  // User canister authoritative for this account or deployment.
  home_user : principal;
  // 48-byte compressed vetKD transport public key; protocol validation checks the point.
  transport_key : blob;
  // Exclusive deadline in Unix milliseconds (`now < expires_at`).
  expires_at : nat64;
};
// Execution lifecycle carrying either output or failure information.
type ExecutionOutcome = variant {
  // Execution returned a known failure.
  Failed : Error;
  // Execution has started and may be awaiting an external call.
  Executing;
  // Authorization is committed; no completed result is yet available.
  Authorized;
  // Execution outcome is uncertain; reconcile using the same request ID.
  Unknown : Error;
  // Retained output is no longer available; this does not authorize replay.
  ResultExpired;
  // Execution completed with a retained output.
  Completed : EncryptedRootKey;
};
// Query/retry view of a derivation and its conservative management-call cost bound.
type ExecutionResult = record {
  // Operation identity used to bind approval and reconcile retries.
  request_id : blob;
  // Conservative ICP cost upper bound, including maximum response/callback
  // reservations, less refunded attached cycles. Not an actual charge or bill.
  // Zero before dispatch or when the management call was not sent.
  cycles_cost_upper_bound : nat;
  // Threshold fee the returned management call consumed: its attached
  // request cycles less the refund. Set on Completed and Failed results,
  // zero otherwise; daily budgets settle to it. Excludes message fees.
  cycles_charged : nat;
  // Execution state with any available output or error.
  outcome : ExecutionOutcome;
};
// Readiness of the configured chain-key public key.
type Initialization = variant {
  // Required material is initialized and ready for use.
  Ready;
  // Required material has not been initialized.
  Uninitialized;
  // Public-key initialization is in progress.
  Initializing;
};
// Public provenance of the content-root vetKD key.
// Authenticate its source before encrypting to it: key identity depends on the
// home canister and derivation configuration.
type KeyDescriptor = record {
  // Stable 12-byte dMsg account identity; not a Principal or ledger account.
  account_id : blob;
  // Content-root generation this descriptor was requested for; it is the
  // IBE identity together with the account ID.
  key_generation : nat64;
  // SHA-256 of `public_key`; the configured master pin.
  public_key_fingerprint : blob;
  // Key derivation format version; current public protocol uses 2.
  derivation_version : nat16;
  // Raw 96-byte vetKD derived public key of the content-root context,
  // shared by every account of this executor.
  public_key : blob;
  // Fixed COSE canister responsible for key derivation and execution.
  home_cose : principal;
  // Deployment domain used in validation and derivation.
  environment : Environment;
  // ICP master-key name used for this derived key.
  master_key_name : text;
};
// COSE deployment configuration and master-key initialization diagnostics.
type KeyState = record {
  // Master public-key initialization state.
  initialization : Initialization;
  // Initialization diagnostic, when one is available.
  error : opt text;
  // SHA-256 of the initialized derived public key, once Ready.
  fingerprint : opt blob;
  // Deployment configuration used by the executor.
  config : CoseInit;
};
// Pinned vetKD master-key configuration checked during COSE initialization.
type MasterKey = record {
  // SHA-256 of the derived content-root public key for the configured
  // context. A zero pin is allowed only outside Production.
  expected_fingerprint : blob;
  // ICP management-canister vetKD master-key name.
  key_name : text;
};
type Result = variant { Ok; Err : Error };
type Result_1 = variant { Ok : ExecutionResult; Err : Error };
type Result_2 = variant { Ok : KeyState; Err : Error };
type Result_3 = variant { Ok : KeyDescriptor; Err : Error };
type Result_4 = variant { Ok : text; Err : text };
service : (CoseInit) -> {
  // Append a user home. Its `dmsg_user` must name this canister as
  // `home_cose` and share the environment and issuer namespace.
  admin_add_user_home : (principal) -> (Result);
  // Set the global daily limits. Counts already used today are retained.
  admin_set_daily_budget : (nat32, nat) -> (Result);
  // Account capacity, retained results, Unknown executions, today's global
  // budget usage, stable pages and the cycle balance.
  cose_stats : () -> (CoseStats) query;
  execute : (ExecutionGrant) -> (Result_1);
  get_execution : (blob, blob) -> (Result_1) query;
  // Fetch the content-root vetKD public key and check it against its pin.
  initialize_keys : () -> (Result_2);
  key_state : () -> (KeyState) query;
  // Prune one bounded page of expired terminal results, retaining replay guards.
  // Public maintenance is safe: a page inspects at most 64 accounts and stops
  // between accounts after half the 40B update instruction limit.
  prune_executions : (opt blob) -> (ExecutionCleanup);
  // The content-root vetKD public key, described for one account and root
  // generation. Clients encrypt that generation's recovery envelope to the
  // identity `canonical((account_id, generation))` under this key. No
  // management call, registration or stable write is needed for this query.
  root_public_key : (blob, nat64) -> (Result_3) query;
  validate_admin_add_user_home : (principal) -> (Result_4) query;
  validate_admin_set_daily_budget : (nat32, nat) -> (Result_4) query;
  validate_initialize_keys : () -> (Result_4) query;
}
