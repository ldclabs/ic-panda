{
  "name": "@dmsg/desktop",
  "private": true,
  "version": "1.3.1-beta.1",
  "description": "dMsg desktop: the vault, signatures and approvals of a dMsg device, on its local daemon",
  "author": "LDC Labs",
  "license": "Apache-2.0",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node --test tests/*.test.ts",
    "audit:controls": "node scripts/audit-native-controls.ts",
    "test:e2e": "pnpm build && node scripts/smoke.mjs",
    "package": "pnpm build && node scripts/prepare-runtime.mjs && electron-builder --config electron-builder.local.cjs --publish never",
    "package:dir": "pnpm build && node scripts/prepare-runtime.mjs && electron-builder --dir --publish never"
  },
  "dependencies": {
    "agent-protocols": "0.12.6",
    "electron-updater": "6.8.11",
    "semver": "7.8.5",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "3.12.4",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "@types/ws": "^8.18.2",
    "bits-ui": "^2.20.2",
    "clsx": "^2.1.1",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "playwright": "1.64.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "8.3.5",
    "yaml": "2.9.1"
  }
}