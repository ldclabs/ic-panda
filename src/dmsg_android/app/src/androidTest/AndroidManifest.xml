<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name="net.dmsg.android.AutofillFixtureActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <provider android:name="net.dmsg.android.IncomingFixtureProvider"
            android:authorities="${applicationId}.incoming-fixture" android:exported="true" />
        <activity android:name="net.dmsg.android.DragFixtureActivity" android:exported="true"
            android:theme="@android:style/Theme.Material.Light.Dialog.NoActionBar" />
        <provider android:name="net.dmsg.android.DragFixtureProvider"
            android:authorities="${applicationId}.drag-fixture" android:exported="false" android:grantUriPermissions="true" />
    </application>
</manifest>
