<?xml version="1.0" encoding="utf-8"?>
<resources>
  <color name="widget_paper">#FBFCF7</color>
  <color name="widget_forest">#315B40</color>
  <color name="widget_ink">#1B2B20</color>
  <color name="widget_cell">#E8EEE2</color>
  <style name="WidgetCell">
    <item name="android:layout_width">0dp</item>
    <item name="android:layout_height">match_parent</item>
    <item name="android:layout_weight">1</item>
    <item name="android:layout_margin">4dp</item>
    <item name="android:background">@drawable/widget_cell</item>
    <item name="android:textColor">@color/widget_forest</item>
    <item name="android:textSize">14sp</item>
    <item name="android:gravity">center</item>
    <item name="android:padding">8dp</item>
    <item name="android:maxLines">2</item>
  </style>
</resources>
