<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_open" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_background" android:orientation="vertical" android:padding="18dp"
    android:theme="@android:style/Theme.DeviceDefault.DayNight" android:gravity="center_vertical">
    <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/dmsg_mark" android:contentDescription="@null" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="dMsg" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/widget_ink" />
    <TextView android:id="@+id/widget_open_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/widget_open" android:textSize="12sp" android:textColor="@color/widget_forest" android:maxLines="2" />
</LinearLayout>
