// [Account](https://github.com/dfinity/ICRC-1/blob/main/standards/ICRC-3/README.md#value)
// representation of ledgers supporting the ICRC-1 standard.
type Account = record { owner : principal; subaccount : opt blob };
// Explicit external capability; never grants access to secrets or wallet keys.
type AppCapability = variant {
  // A registered, typed product action.
  SignAction;
  // Exact business offer approval.
  Checkout;
  // One of the three existing closed document profiles.
  SignDocument;
  // Account authentication only.
  Authenticate;
};
// Governance-pinned application identity and browser boundary.
type AppRegistration = record {
  // Pinned execution canisters allowed to sign artifacts.
  cose_homes : vec principal;
  // Explicit capability allowlist.
  capabilities : vec AppCapability;
  // Canonical exact browser origins, never URL prefixes.
  origins : vec text;
  // Product IDs allowed for this application.
  product_ids : vec text;
  // Receiver of external account authentication proofs.
  authentication_receiver : principal;
  // Wire version, currently one.
  version : nat16;
  // Stable application identifier.
  app_id : text;
  // Monotonically increasing configuration version.
  config_version : nat64;
  // Deployment separation.
  environment : Environment;
  // Product authority that confirms prepared actions and signer-account linkage.
  action_authority : principal;
  // Pinned user canisters allowed to authenticate accounts.
  user_homes : vec principal;
  // Closed signing profile allowlist, empty for an authentication-only app.
  profiles : vec SigningProfile;
  // Stops new approvals; does not erase accepted commitments.
  paused : bool;
};
// Approved dMsg account and product beneficiary are deliberately separate.
type ApplicationApproval = record {
  // Exact service allowed to consume this approval.
  "service" : principal;
  // Economic actor, distinct from both account IDs and payer accounts.
  actor : principal;
  // Product-defined rights recipient; no inferred AccountId conversion.
  beneficiary : Beneficiary;
  // Exact application configuration revision.
  app_config_version : nat64;
  // Extension-verified browser origin.
  origin : text;
  // Complete cash/PANDA quotation or application action digest.
  action_digest : blob;
  // Idempotency identifier.
  operation_id : blob;
  // dMsg account whose device approves this action.
  approving_account : blob;
  // Integration version.
  version : nat16;
  // Registered application.
  app_id : text;
  // Fresh challenge.
  nonce : blob;
  // Deployment separation.
  environment : Environment;
  // Purpose-separated authorization.
  purpose : ApprovalPurpose;
  // Exclusive validity deadline in Unix milliseconds.
  expires_at_ms : nat64;
};
// Exact purpose for account approval, distinct from product authorization.
type ApprovalPurpose = variant {
  // Cash order approval.
  CashCheckout;
  // Full subscription waiver approval.
  PandaSubscription;
};
// Product, authority and opaque subject binding; decoding does not establish control.
type Beneficiary = record {
  // Product identifier within this protocol.
  product_id : text;
  // Canister authoritative for the beneficiary subject.
  authority_canister : principal;
  // Opaque subject bytes in the registered schema.
  subject_bytes : blob;
  // Registered schema identifying how to interpret subject_bytes.
  subject_schema : text;
};
// Product-authoritative offer for one exact half-open subscription interval.
type BillingOffer = record {
  // Opaque product SKU, never interpreted by checkout.
  sku : text;
  // Registered product.
  product_id : text;
  // Typed recipient of product rights.
  beneficiary : Beneficiary;
  // Entire interval price in USD micro units, not an annualized price.
  amount_usd_micros : nat;
  // Operation identity fixed across retries.
  operation_id : blob;
  // Inclusive subscription start in Unix milliseconds.
  starts_at_ms : nat64;
  // Commerce version, currently two.
  version : nat16;
  // Registered application.
  app_id : text;
  // Quote issuance in Unix milliseconds.
  issued_at_ms : nat64;
  // Product-issued quote identifier.
  offer_id : blob;
  // Registered authoritative quote canister.
  quote_authority : principal;
  // Deployment separation.
  environment : Environment;
  // Product CAS revision, separate from qualification lease revision.
  expected_business_revision : nat64;
  // Registered product delivery canister.
  adapter : principal;
  // Explicit enabled settlement sources, without duplicates.
  allowed_settlement_methods : vec SettlementMethod;
  // Exclusive immutable end in Unix milliseconds.
  expires_at_ms : nat64;
  // Exclusive initial acceptance deadline; not an activation deadline.
  accept_by_ms : nat64;
  // Exact product terms accepted by the user.
  product_terms_hash : blob;
};
// A ledger-scoped block reference.
type CashBlock = record {
  // Native ledger block index; checked before narrowing in an adapter.
  block_index : nat;
  // Authenticated ledger source.
  ledger : principal;
};
// Durable permission to cancel exactly one unstarted cash term.
type CashCancellationReceipt = record {
  // Full original decision commitment.
  decision_hash : blob;
  // False is a durable refusal, not an unknown cancellation.
  cancelled : bool;
  // Product's new business revision.
  business_revision : nat64;
  // Product contract cancelled atomically.
  contract_id : blob;
  // Time of the cancellation.
  cancelled_at_ms : nat64;
  // Checkout order to refund.
  order_id : blob;
};
// Fixed single-asset cash terms; no floating point or implicit peg.
type CashQuote = record {
  // Product price converted using the accepted asset policy.
  amount_atomic : nat;
  // Complete authoritative offer commitment.
  offer_hash : blob;
  // Separately identified fee reserve.
  fee_reserve_atomic : nat;
  // Exclusive funding deadline.
  funding_deadline_ms : nat64;
  // Approved per-transfer fee ceiling.
  max_network_fee_atomic : nat;
  // Exclusive initial activation deadline, not a release rule for Unknown.
  activation_deadline_ms : nat64;
  // Exact per-order receiving account.
  deposit : Account;
  // Commerce version.
  version : nat16;
  // Immutable selected ledger.
  ledger : principal;
  // Approved funding account.
  payer : Account;
  // Commitment to the actual conversion rate / depeg checks.
  conversion_hash : blob;
};
// Each outgoing leg owns its ledger, source, destination, fee, memo and timestamp.
type CashTransfer = record {
  // Approved immutable destination.
  to : Account;
  // Actual transfer state.
  status : CashTransferStatus;
  // Source order subaccount.
  source_subaccount : blob;
  // Net amount to deliver.
  amount_atomic : nat;
  // Ledger-reported replacement fee, not permission to use it.
  expected_fee_atomic : opt nat;
  // A known-rejected predecessor, if any.
  replaces : opt blob;
  // Confirmed block when succeeded.
  block_index : opt nat;
  // Stable sender time in nanoseconds, not the funding proof's ledger timestamp.
  created_at_time_ns : nat64;
  // Stable ledger deduplication memo.
  memo : blob;
  // A replacement leg prevents replay of this one.
  replaced_by : opt blob;
  // Globally unique immutable transfer identity.
  transfer_id : blob;
  // Immutable ledger.
  ledger : principal;
  // Limit accepted by the responsible payer/merchant.
  max_fee_atomic : nat;
  // Frozen fee for this exact attempt.
  fee_atomic : nat;
  // Source order, never another merchant's pool.
  order_id : blob;
  // Stable diagnostic code without private payloads.
  error_code : opt text;
};
// Public transfer advancement does not disclose payer or merchant account details.
type CashTransferProgress = record {
  // Authoritative progress.
  status : CashTransferStatus;
  // Ledger block when known.
  block_index : opt nat;
  // Original immutable leg.
  transfer_id : blob;
};
// Network transfer lifecycle. Unknown is never replaced with another memo/time.
type CashTransferStatus = variant {
  // Replaced only after a known rejection; never dispatch this leg again.
  Superseded;
  // Known ledger rejection; no prior unknown attempt exists.
  Rejected;
  // Actual block confirmed or ledger Duplicate returned.
  Succeeded;
  // Call may still execute.
  InFlight;
  // Original transfer must be retried or matched to a trusted block.
  Unknown;
  // Durable frozen transfer before dispatch.
  Pending;
};
// Outgoing legs visible to their recipient or the corresponding order reader.
type CashTransfersPage = record {
  // Exact immutable transfer arguments and state.
  transfers : vec CashTransfer;
  // Last scanned key, including inaccessible rows.
  next : opt blob;
};
// Certified commercial catalog; asset identity and governance approval require trusted evidence.
type Catalog = record {
  // Additional storage products in this catalog.
  storage_products : vec StorageProduct;
  // Public record format version, independent of stable storage.
  schema : nat16;
  // Inclusive activation time in Unix milliseconds.
  effective_at_ms : nat64;
  // Immutable version identifier within this policy or catalog.
  version : nat64;
  // Available base-plan snapshots.
  plans : vec PlanVersion;
  // Commitment to the accepted service terms.
  terms_digest : blob;
};
// IC-certified query response. Merely decoding this value authenticates nothing.
// Verify the IC certificate against a trusted root, the expected canister and
// certificate time, then each witness, requested path and exact leaf bytes.
type CertifiedBatch = record {
  // IC data certificate bytes; verify against a trusted IC root key.
  certificate : blob;
  // Version of this public certified-leaf format, not the storage schema.
  schema : nat16;
  // Requested leaves and their membership/absence witnesses.
  entries : vec CertifiedEntry;
  // Canister identity to match against the expected service and certificate.
  canister : principal;
};
// One requested leaf and its IC hash-tree witness.
// A missing value must be checked as an absence proof, not treated as an empty leaf.
type CertifiedEntry = record {
  // Raw requested leaf path segment; compare with the exact expected path.
  key : blob;
  // Exact serialized leaf bytes, or None for requested absence.
  value : opt blob;
  // CBOR-encoded IC hash-tree witness for this requested leaf.
  witness : blob;
};
// Result of registering a real deposit, including wrong-source/late/excess deposits.
type CheckoutDeposit = record {
  // Actual amount received.
  amount_atomic : nat;
  // Still-unallocated refund obligation to the original source.
  refundable_atomic : nat;
  // Original source account; refunds cannot substitute another destination.
  from : Account;
  // Ledger-scoped identity, never a global bare block number.
  block : CashBlock;
  // Original order receiving these funds.
  order_id : blob;
};
// Exact per-order accounting in one ledger; amounts in distinct ledgers are never added.
type CheckoutLedgerBalance = record {
  // Customer-funded network fee reserve.
  fee_reserve_atomic : nat;
  // Obligations to original deposit sources.
  refundable_atomic : nat;
  // All allocated outgoing obligations, including their exact fees.
  outgoing_atomic : nat;
  // Product price not yet allocated to a merchant transfer.
  service_reserve_atomic : nat;
  // Asset identity.
  ledger : principal;
  // Confirmed incoming amount.
  incoming_atomic : nat;
};
// Private operational observation; delivery continues to require the service's durable receipt.
type CheckoutOperationAudit = record {
  // Original order and receipt.
  order : CheckoutView;
  // Independently conserved balances.
  balances : vec CheckoutLedgerBalance;
};
// Bounded owner/merchant/governance scan. Cursor is the last scanned key, not the last match.
type CheckoutOperationsPage = record {
  // Accessible orders.
  orders : vec CheckoutOperationAudit;
  // Continue after this key; null means the scan reached the end.
  next : opt blob;
};
// Safe public progress without disclosing private product bill/account data.
type CheckoutProgress = record {
  // Current state, not inferred from a wallet reply.
  status : CheckoutStatus;
  // Immutable delivery identity when prepared.
  decision_id : opt blob;
  // Original order identity.
  order_id : blob;
};
// Fixed cash terms, including independently verified asset policy.
type CheckoutQuote = record {
  // Accepted conversion and network-fee policy.
  asset : SettlementAsset;
  // Product-authoritative USD bill.
  offer : BillingOffer;
  // Immutable one-ledger payment and refund terms.
  cash : CashQuote;
  // Time used to compute the fixed funding/activation deadlines.
  quoted_at_ms : nat64;
  // Frozen registered merchant, subject schema and adapter configuration.
  product : ProductRegistration;
};
// Same operation identity is retained through every uncertain result.
type CheckoutStatus = variant {
  // Product applied rights and a durable receipt.
  Applied;
  // Product interval reservation is being reconciled; do not fund yet.
  Reserving;
  // Order and its interval are accepted; the payer may transfer once.
  AwaitingFunding;
  // No order permission was granted.
  Rejected;
  // Definitive nondelivery or unstarted cancellation; original deposits are refundable.
  RefundCommitted;
  // Funds and delivery decision committed; adapter acknowledgement is pending.
  Applying;
};
// Owner/adapter view, used for recovery and the billing centre.
type CheckoutView = record {
  // Product receipt if obtained.
  receipt : opt ProductReceipt;
  // Remaining customer-funded network reserve.
  fee_reserve_atomic : nat;
  // Cumulative allocated transfers for the selected asset, including their fees.
  outgoing_atomic : nat;
  // Original fixed terms.
  quote : CheckoutQuote;
  // Identity and public state.
  progress : CheckoutProgress;
  // Amount of price still reserved, never withdrawable before earned.
  service_reserve_atomic : nat;
};
// Product commerce deployment, accepted asset and admission configuration.
type CommerceInit = record {
  // New merchant-order limit per UTC day.
  daily_orders : nat32;
  // Maximum retained beneficiary subjects.
  max_subjects : nat64;
  // Deployment domain of the request or service.
  environment : Environment;
  // Governance Principal controlling this service configuration.
  governance : principal;
  // Shared PANDA qualification authority.
  membership_canister : principal;
  // Permitted dMsg account-authority canisters.
  user_homes : vec principal;
  // Fixed catalog snapshot.
  catalog : Catalog;
};
// Qualification observation; unverifiable is distinct from known ineligibility.
type Eligibility = variant {
  // Current supporting facts cannot be verified.
  Unverifiable;
  // Known not to satisfy the policy.
  Ineligible;
  // Known to satisfy the fixed qualification policy.
  Eligible;
};
// Certified resource lease projection; validate beneficiary, revisions and expiry before use.
type EntitlementView = record {
  // Contracts supporting this issued lease.
  lease_source_contract_ids : vec blob;
  // Base-plan terms used for this projection.
  plan_snapshot : PlanVersion;
  // Revision of business terms or qualification, independent of lease refreshes.
  business_revision : nat64;
  // Known service termination time in Unix milliseconds.
  service_terminated_at_ms : opt nat64;
  // Product subject receiving the benefit.
  beneficiary : Beneficiary;
  // Public record format version, independent of stable storage.
  schema : nat16;
  // Exclusive validity deadline in Unix milliseconds.
  valid_until_ms : nat64;
  // Time the supporting qualification observation began, in Unix milliseconds.
  observed_at_ms : nat64;
  // Qualification repair deadline in Unix milliseconds, when applicable.
  repair_deadline_ms : opt nat64;
  // Monotonic projection/lease revision, including refreshes.
  lease_revision : nat64;
  // Projection issuance time in Unix milliseconds.
  issued_at_ms : nat64;
  // Commerce canister authoritative for this order or lease.
  home_commerce : principal;
  // Separately valid paid storage entitlements.
  addons : vec StorageAddon;
  // Known resource stop time in Unix milliseconds.
  effective_stop_at_ms : opt nat64;
  // Combined currently applicable resource limits.
  effective_limits : ResourceLimits;
  // Next known resource-limit transition in Unix milliseconds.
  next_limit_change_at_ms : opt nat64;
  // Current resource-source lifecycle.
  source_status : SourceStatus;
  // Qualification assessment supporting this projection.
  eligibility_status : Eligibility;
  // Currently selected base contract, absent for Free.
  active_contract_id : opt blob;
};
// Deployment domain used to separate identities and key derivation.
type Environment = variant {
  // Local development deployment.
  Local;
  // Production deployment with pinned chain-key configuration.
  Production;
  // Pre-production deployment domain.
  Staging;
};
// Application errors returned by dMsg canisters and protocol helpers.
// Transport failures and Candid decoding failures are separate from this enum.
type Error = variant {
  // Required legacy key material is unavailable.
  MigrationKeyUnavailable;
  // Legacy business writes are frozen.
  LegacyWriteDisabled;
  // A supplied field or combination is invalid; carries a diagnostic.
  InvalidInput : text;
  // Another accepted operation owns the same product interval.
  IntervalReserved;
  // A neuron still supports a committed or pending product application.
  NeuronOccupied;
  // A new content root must be committed before writes can resume.
  RekeyRequired;
  // Expected version/generation differs from current state; reread before preparing a new approval.
  VersionConflict;
  // Execution may have occurred; reconcile the original request instead of creating another.
  ExecutionUnknown;
  // A digest, signature, proof or accounting invariant failed validation.
  IntegrityFailed;
  // Account-ID timestamp cannot fit the generator format.
  IdTimestampOutOfRange;
  // The requested record does not exist.
  NotFound;
  // The approved fee or available fee reserve cannot support the transfer.
  FeeBlocked;
  // The device is missing, revoked or not approved for this operation.
  DeviceNotApproved;
  // Sensitive operations are locked by account state or policy.
  Locked;
  // The source benefit is closing and cannot issue new leases.
  MembershipClosing;
  // Required recovery setup/confirmation has not completed.
  RecoveryIncomplete;
  // Account-ID counter space is exhausted for this timestamp.
  IdCapacityExceeded;
  // Approval or policy evidence refers to an outdated security state.
  PolicyStale;
  // Persisted account-ID allocator state does not match its configured namespace.
  IdGeneratorStateConflict;
  // An operation ID was reused with different parameters.
  IdempotencyConflict;
  // The profile, algorithm or protocol version is unsupported.
  UnsupportedProtocol;
  // A required service or resource is unavailable; carries a diagnostic.
  Unavailable : text;
  // Commercial qualification is temporarily unverifiable or its lease expired.
  MembershipStale;
  // Caller, role or capability does not authorize this operation.
  Forbidden;
  // Retained output is no longer available; this does not authorize replay.
  ResultExpired;
  // The applicable deadline has passed.
  Expired;
  // The subject is known to be ineligible for the requested benefit.
  MembershipIneligible;
  // An execution, cycle, storage or admission limit was exceeded.
  QuotaExceeded;
  // An authenticated and appropriately bound caller is required.
  AuthRequired;
  // The operation is not yet complete; query/retry the same operation as appropriate.
  Pending;
};
// Consistent resource lease and monthly formal-execution allocation.
type ExecutionEntitlement = record {
  // Monthly quota calculation matching this beneficiary.
  month : MonthEntitlement;
  // Resource qualification and lease projection.
  view : EntitlementView;
};
// Versioned integer cost per formal-signing algorithm.
type ExecutionWeights = record {
  // Units charged for one ES256K formal execution.
  ecdsa_secp256k1 : nat64;
  // Units charged for one Ed25519 formal execution.
  ed25519 : nat64;
  // Immutable version identifier within this policy or catalog.
  version : nat64;
};
// Versioned monthly quota calculation; retain prior segments when terms change.
type MonthEntitlement = record {
  // Revision of business terms or qualification, independent of lease refreshes.
  business_revision : nat64;
  // Version of the monthly allowance algorithm.
  calculation_version : nat16;
  // Product subject receiving the benefit.
  beneficiary : Beneficiary;
  // Contiguous quota segments, limited to 64 by protocol validation.
  segments : vec MonthSegment;
  // Total monthly units, rounding down once after summing weighted durations.
  allowed_units : nat64;
  // Versioned execution-cost weights.
  weights : ExecutionWeights;
  // Revision of the retained monthly calculation.
  month_revision : nat64;
  // YYYYMM in UTC.
  month_utc : nat32;
};
// Contiguous half-open UTC millisecond interval weighted by a full-month quota.
type MonthSegment = record {
  // Inclusive segment start in Unix milliseconds.
  start_ms : nat64;
  // Full-month units applicable during this segment.
  monthly_units : nat64;
  // Exclusive segment end in Unix milliseconds.
  end_ms : nat64;
  // Contract supporting the segment, or None for Free.
  source_contract_id : opt blob;
};
// Opening never transfers funds. Transfer only after an accepted order exists.
type OpenCheckout = record {
  // Accepted immutable quote.
  quote : CheckoutQuote;
  // Account and product permission input.
  authorization : ProductAuthorizationRequest;
};
// Base resource tier; it grants no account or cryptographic permissions.
type PlanId = variant {
  // Max base tier.
  Max;
  // Pro base tier.
  Pro;
  // Free base tier.
  Free;
  // Plus base tier.
  Plus;
};
// Immutable base-plan price, limits, weights and policy snapshot.
type PlanVersion = record {
  // Immutable catalog version containing this plan.
  catalog_version : nat64;
  // Version of the accepted service terms.
  terms_version : nat64;
  // Integer annual or product price in USD cents.
  price_cents : nat64;
  // Versioned execution-cost weights.
  weights : ExecutionWeights;
  // Base resource tier.
  plan_id : PlanId;
  // Base resource limits.
  limits : ResourceLimits;
};
// Explicit product permission; not a claim that the payer has a project role.
type ProductApproval = record {
  // Accepted settlement method.
  method : SettlementMethod;
  // Product-owned approval identity.
  approval_id : blob;
  // Exact bill accepted by the product operator.
  offer_hash : blob;
  // Operator whose product permissions must remain valid at delivery.
  operator : principal;
  // Protocol version two.
  version : nat16;
  // Exclusive application deadline, never extended on retry.
  expires_at_ms : nat64;
  // Approval time.
  approved_at_ms : nat64;
};
// Inputs authenticated by checkout/membership before asking the product authority.
type ProductAuthorizationRequest = record {
  // Explicit product approval; a personal-account adapter may derive owner consent from account_approval.
  product_approval : opt ProductApproval;
  // dMsg device-approved account and economic actor.
  account_approval : ApplicationApproval;
  // Exact device approval record.
  approval_id : blob;
  // Registered dMsg user home that verified the approval.
  user_home : principal;
  // Exact authoritative bill.
  offer : BillingOffer;
};
// Durable product delivery decision, persisted before the external Apply call.
type ProductDecision = record {
  // Permanent decision identity; never replaced after an unknown response.
  decision_id : blob;
  // Complete accepted business offer.
  offer : BillingOffer;
  // Typed source verified against the fixed service caller.
  source : SettlementSource;
  // Decision preparation time in Unix milliseconds.
  decided_at_ms : nat64;
  // Commerce version.
  version : nat16;
  // Exclusive delivery deadline; unknown delivery never implies a refund.
  apply_by_ms : nat64;
};
// Terminal Apply result. Unknown is the absence of an authenticated receipt.
type ProductOutcome = variant {
  // Rights and the receipt were committed atomically.
  Applied : record {
    // Product business revision after Apply.
    business_revision : nat64;
    // Immutable contract identity.
    contract_id : blob;
    // Earliest permissible commitment release time.
    committed_until_ms : nat64;
  };
  // Known rejection, persisted and idempotently retrievable.
  Rejected : record {
    // Stable typed reason without sensitive free-form diagnostics.
    reason : ProductRejection;
  };
};
// Authenticated product receipt, not an untrusted browser success flag.
type ProductReceipt = record {
  // Complete decision commitment; catches same-ID/different-bytes retries.
  decision_hash : blob;
  // Original immutable decision identity.
  decision_id : blob;
  // Atomic receipt creation time in Unix milliseconds.
  applied_at_ms : nat64;
  // Commerce version.
  version : nat16;
  // Terminal delivery result.
  outcome : ProductOutcome;
  // Fixed registered delivery authority.
  adapter : principal;
};
// Product identity, subject schema and settlement boundary.
type ProductRegistration = record {
  // Stable product identifier.
  product_id : text;
  // Exact subject byte length.
  subject_size : nat16;
  // Current product terms commitment.
  terms_hash : blob;
  // Commerce version, currently two.
  version : nat16;
  // Monotonically increasing configuration version.
  config_version : nat64;
  // Merchant settlement identity, separate from the beneficiary.
  merchant : Account;
  // Canister supplying authoritative offers.
  quote_authority : principal;
  // Deployment separation.
  environment : Environment;
  // Enabled ledgers, explicitly configured even in local fixtures.
  ledgers : vec principal;
  // Canister supplying beneficiary permissions.
  beneficiary_authority : principal;
  // Canister applying product decisions.
  adapter : principal;
  // Fixed interpretation of subject bytes.
  subject_schema : text;
  // Stops new commitments only.
  paused : bool;
};
// Expected terminal product rejections.
type ProductRejection = variant {
  // Authoritative quote or product terms no longer match.
  OfferMismatch;
  // Another operation already owns the same interval.
  IntervalReserved;
  // Business revision changed.
  RevisionConflict;
  // Product permission is no longer valid.
  Unauthorized;
  // Delivery deadline or permitted interval has passed.
  Expired;
};
// Logical storage, active-channel and formal-execution resource limits.
type ResourceLimits = record {
  // Number of active sponsored channel slots.
  active_channels : nat64;
  // Full UTC-month allowance of weighted formal-execution units.
  monthly_execution_units : nat64;
  // Logical retained ciphertext capacity in bytes.
  storage_bytes : nat64;
};
type Result = variant { Ok : ProductReceipt; Err : Error };
type Result_1 = variant { Ok : CashCancellationReceipt; Err : Error };
type Result_10 = variant { Ok : ExecutionEntitlement; Err : Error };
type Result_11 = variant { Ok : opt ProductReceipt; Err : Error };
type Result_12 = variant { Ok : BillingOffer; Err : Error };
type Result_13 = variant { Ok : CashTransferProgress; Err : Error };
type Result_14 = variant { Ok : SettlementAsset; Err : Error };
type Result_15 = variant { Ok : CheckoutQuote; Err : Error };
type Result_16 = variant {
  Ok : record { AppRegistration; opt ProductRegistration };
  Err : Error;
};
type Result_17 = variant { Ok : EntitlementView; Err : Error };
type Result_18 = variant { Ok; Err : Error };
type Result_2 = variant { Ok : CheckoutProgress; Err : Error };
type Result_3 = variant { Ok : CertifiedBatch; Err : Error };
type Result_4 = variant { Ok : vec CheckoutDeposit; Err : Error };
type Result_5 = variant { Ok : CheckoutOperationsPage; Err : Error };
type Result_6 = variant { Ok : CashTransfersPage; Err : Error };
type Result_7 = variant { Ok : CashTransfer; Err : Error };
type Result_8 = variant { Ok : opt CashCancellationReceipt; Err : Error };
type Result_9 = variant { Ok : CheckoutView; Err : Error };
// Governance-approved asset/price snapshot. Pausing admission never removes refund routing.
type SettlementAsset = record {
  // Verified atomic precision; initial assets require six decimals.
  decimals : nat16;
  // Declared kind, checked against the configured ledger identity.
  asset : SettlementAssetKind;
  // Per-transfer cap accepted for new orders.
  max_network_fee_atomic : nat;
  // Exclusive validity end of that price observation.
  price_valid_until_ms : nat64;
  // Time of the trusted price observation.
  price_observed_at_ms : nat64;
  // Protocol version two.
  version : nat16;
  // New-quote admission only.
  enabled : bool;
  // Latest verified ledger network fee.
  network_fee_atomic : nat;
  // Ledger identity, not a symbol.
  ledger : principal;
  // Deployment domain.
  environment : Environment;
  // Explicit reference USD micro price for one full token.
  price_usd_micros : nat;
  // Immutable revision for this ledger.
  policy_version : nat64;
};
// Initially supported stable assets, bound to fixed ledger IDs outside Local.
type SettlementAssetKind = variant {
  // ckUSDC on ICP.
  CkUsdc;
  // ckUSDT on ICP.
  CkUsdt;
};
// Asset discovery remains available while quotes are paused.
type SettlementAssetView = record {
  // Metadata/block format has been verified for this policy.
  ledger_verified : bool;
  // Exact current asset policy.
  policy : SettlementAsset;
};
// Mutually exclusive settlement sources. PANDA always covers the entire offer.
type SettlementMethod = variant {
  // One explicitly enabled ledger.
  Cash;
  // Full subscription waiver without any cash transfer.
  Panda;
};
// Paid/waived provenance. PANDA never fabricates a ledger payment reference.
type SettlementSource = variant {
  // Confirmed receipt of a single selected asset.
  Cash : record {
    // Actual product price, excluding the separately tracked fee reserve.
    amount_atomic : nat;
    // Authentic ICRC block index.
    block_index : nat;
    // Selected ledger, also scopes block deduplication.
    ledger : principal;
    // Checkout order identity.
    order_id : blob;
  };
  // Full waiver requiring a live qualification lease.
  Panda : record {
    // Shared membership claim identity.
    claim_id : blob;
    // Exact accepted quotation.
    quote_hash : blob;
    // Current exclusive lease end, bounded by contract end.
    lease_until_ms : nat64;
    // Immutable commitment, even if benefit later terminates.
    committed_until_ms : nat64;
  };
};
// Closed signing profiles that an application may request.
type SigningProfile = variant {
  // Existing text-plus-file statement profile.
  FileStatementV1;
  // Existing raw UTF-8 text statement profile.
  TextStatementV1;
  // Existing SHA-256 digest statement profile.
  DigestStatementV1;
  // Typed application action profile.
  AppActionV1;
};
// Current resource-source state, distinct from account security state.
type SourceStatus = variant {
  // Current supporting facts cannot be verified.
  Unverifiable;
  // Free base tier.
  Free;
  // Benefit closure is in progress.
  Closing;
  // Benefit is active under its recorded terms.
  Active;
  // New paid resource admission is suspended.
  Suspended;
  // Known qualification loss is within the repair period.
  RepairRequired;
  // The source interval has expired.
  Expired;
};
// Paid storage entitlement with its own interval and issued-lease deadline.
type StorageAddon = record {
  // Product contract identity.
  contract_id : blob;
  // Inclusive interval start in Unix milliseconds.
  starts_at_ms : nat64;
  // Logical retained ciphertext capacity in bytes.
  storage_bytes : nat64;
  // Stable merchant order identity.
  order_id : blob;
  // Exclusive interval end in Unix milliseconds.
  expires_at_ms : nat64;
  // Latest resource-lease deadline already issued, in Unix milliseconds.
  last_issued_until_ms : nat64;
};
// Additional storage product with fixed size and annual price.
type StorageProduct = record {
  // Product identifier within this protocol.
  product_id : blob;
  // Integer annual price in USD cents, prorated to the base term endpoint.
  price_cents : nat64;
  // Logical retained ciphertext capacity in bytes.
  storage_bytes : nat64;
};
service : (CommerceInit) -> {
  apply_product_decision : (ProductDecision) -> (Result);
  cancel_cash_contract : (blob, blob, blob) -> (Result_1);
  cancel_checkout : (blob) -> (Result_2);
  check_checkout_funding : (blob, CashBlock) -> (Result_2);
  checkout_certificate : (blob) -> (Result_3) query;
  checkout_deposits : (blob) -> (Result_4) query;
  // Private operations centre; quoting and monitoring never reserve an interval.
  checkout_operations : (opt blob, nat16) -> (Result_5) query;
  checkout_progress : (blob) -> (Result_2) query;
  checkout_transfer_certificate : (blob) -> (Result_3) query;
  checkout_transfers : (opt blob, nat16) -> (Result_6) query;
  claim_checkout_fee_reserve : (blob) -> (Result_7);
  claim_checkout_refund : (blob, principal, vec nat, blob) -> (Result_7);
  collect_checkout_revenue : (blob) -> (Result_7);
  get_cash_cancellation : (blob) -> (Result_8);
  get_catalog : () -> (Result_3) query;
  get_checkout : (blob) -> (Result_9) query;
  // Consensus read for the pinned product adapter during Apply. Query replies are not delivery authority.
  get_checkout_for_product : (blob) -> (Result_9);
  get_checkout_transfer : (blob) -> (Result_7) query;
  get_entitlement_batch : (vec Beneficiary) -> (Result_3) query;
  get_execution_entitlement : (Beneficiary, nat32, nat64) -> (Result_10);
  get_product_decision : (blob) -> (Result_11);
  // Public, authenticated discovery. A paused configuration remains discoverable.
  integration_configuration_certificate : (text, opt text) -> (Result_3) query;
  list_catalogs : (opt nat64) -> (vec Catalog) query;
  open_checkout : (OpenCheckout) -> (Result_9);
  prepare_account_subscription : (text, Beneficiary, text, blob) -> (Result_12);
  process_checkout_transfer : (blob) -> (Result_13);
  publish_settlement_price : (principal, nat, nat64) -> (Result_14);
  quote_checkout : (BillingOffer, principal, Account) -> (Result_15);
  // Replicated response used by the pinned user home during exact approval.
  read_integration_configuration : (text, opt text) -> (Result_16);
  // Safe progress can be advanced without revealing the payer or private bill.
  reconcile_checkout : (blob) -> (Result_2);
  reconcile_checkout_transfer : (blob, CashBlock) -> (Result_13);
  refresh_catalog : () -> (Catalog);
  refresh_entitlement : (Beneficiary) -> (Result_17);
  register_integration_app : (AppRegistration) -> (Result_18);
  register_integration_product : (ProductRegistration) -> (Result_18);
  register_settlement_asset : (SettlementAsset) -> (Result_18);
  release_product_billing : (ProductAuthorizationRequest) -> (Result_18);
  reserve_product_billing : (ProductAuthorizationRequest, nat64) -> (Result_18);
  revise_checkout_transfer_fee : (blob, nat) -> (Result_7);
  schedule_policy : (Catalog) -> (Result_18);
  set_admission_pause : (bool) -> (Result_18);
  set_settlement_price_authority : (principal) -> (Result_18);
  settlement_assets : () -> (vec SettlementAssetView) query;
  settlement_assets_certificate : () -> (Result_3) query;
  verify_billing_offer : (BillingOffer) -> (Result_18);
  verify_settlement_asset : (principal, opt nat) -> (Result_18);
}
