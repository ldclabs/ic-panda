// [Account](https://github.com/dfinity/ICRC-1/blob/main/standards/ICRC-3/README.md#value)
// representation of ledgers supporting the ICRC-1 standard.
type Account = record { owner : principal; subaccount : opt blob };
// Plain display text for one locale; never markup.
type ActionLabel = record {
  // Display text.
  "text" : text;
  // BCP 47 language tag, such as `en` or `zh`.
  locale : text;
};
// Governance-registered command vocabulary of one application.
type ActionSchema = record {
  // Schema format version, exactly one.
  version : nat16;
  // Commands the application may request, with unique names.
  commands : vec CommandSchema;
};
// Explicit external capability; never grants access to secrets or wallet keys.
type AppCapability = variant {
  // A registered, typed product action.
  SignAction;
  // Exact business offer approval.
  Checkout;
  // One of the three existing closed document profiles.
  SignDocument;
  // Account authentication only.
  Authenticate;
};
// Governance-pinned application identity and browser boundary.
type AppRegistration = record {
  // Explicit capability allowlist.
  capabilities : vec AppCapability;
  // Canonical exact browser origins, never URL prefixes.
  origins : vec text;
  // Product IDs allowed for this application.
  product_ids : vec text;
  // Receiver of external account authentication proofs.
  authentication_receiver : principal;
  // Wire version, currently one.
  version : nat16;
  // Stable application identifier.
  app_id : text;
  // Monotonically increasing configuration version.
  config_version : nat64;
  // Deployment separation.
  environment : Environment;
  // Command schema rendered for signing, present exactly with `SignAction`.
  action_schema : opt ActionSchema;
  // Product authority that confirms prepared actions and signer-account linkage.
  action_authority : principal;
  // Closed signing profile allowlist, empty for an authentication-only app.
  profiles : vec SigningProfile;
  // Stops new approvals; does not erase accepted commitments.
  paused : bool;
};
// Merchant-verification policy set by governance.
type AppStoreConfig = record {
  // Permit sandbox annual subscriptions alongside production. Missing means false.
  accept_sandbox : opt bool;
  // Signed application bundle ID.
  bundle_id : text;
  // Principals of the server-side Apple-verification service.
  verifiers : vec principal;
  // One deployment environment.
  environment : StoreEnvironment;
  // App Store Connect application Apple ID.
  app_apple_id : nat64;
  // No unknown product can mint an entitlement.
  products : vec StoreProduct;
};
// Approved dMsg account and product beneficiary are deliberately separate.
type ApplicationApproval = record {
  // Exact service allowed to consume this approval.
  "service" : principal;
  // Economic actor, distinct from both account IDs and payer accounts.
  actor : principal;
  // Product-defined rights recipient; no inferred AccountId conversion.
  beneficiary : Beneficiary;
  // Exact application configuration revision.
  app_config_version : nat64;
  // Browser origin, verified by the dMsg client.
  origin : text;
  // Complete cash/PANDA quotation or application action digest.
  action_digest : blob;
  // Idempotency identifier.
  operation_id : blob;
  // dMsg account whose device approves this action.
  approving_account : blob;
  // Integration version.
  version : nat16;
  // Registered application.
  app_id : text;
  // Fresh challenge.
  nonce : blob;
  // Deployment separation.
  environment : Environment;
  // Purpose-separated authorization.
  purpose : ApprovalPurpose;
  // Exclusive validity deadline in Unix milliseconds.
  expires_at_ms : nat64;
};
// Exact purpose for account approval, distinct from product authorization.
type ApprovalPurpose = variant {
  // Join a multisig wallet and bind the actor Principal; the service is the wallet.
  WalletJoin;
  // Create a multisig wallet; the service is the wallet hub.
  WalletCreate;
  // Cash order approval.
  CashCheckout;
  // Decide on a multisig wallet proposal; the service is the wallet.
  WalletProposal;
  // Full subscription waiver approval.
  PandaSubscription;
};
// Product, authority and opaque subject binding; decoding does not establish control.
type Beneficiary = record {
  // Product identifier within this protocol.
  product_id : text;
  // Canister authoritative for the beneficiary subject.
  authority_canister : principal;
  // Opaque subject bytes in the registered schema.
  subject_bytes : blob;
  // Registered schema identifying how to interpret subject_bytes.
  subject_schema : text;
};
// Product-authoritative offer for one exact half-open subscription interval.
type BillingOffer = record {
  // Opaque product SKU, never interpreted by checkout.
  sku : text;
  // Registered product.
  product_id : text;
  // Typed recipient of product rights.
  beneficiary : Beneficiary;
  // Entire interval price in USD micro units, not an annualized price.
  amount_usd_micros : nat;
  // Operation identity fixed across retries.
  operation_id : blob;
  // Inclusive subscription start in Unix milliseconds.
  starts_at_ms : nat64;
  // Commerce version, currently two.
  version : nat16;
  // Registered application.
  app_id : text;
  // Quote issuance in Unix milliseconds.
  issued_at_ms : nat64;
  // Product-issued quote identifier.
  offer_id : blob;
  // Registered authoritative quote canister.
  quote_authority : principal;
  // Deployment separation.
  environment : Environment;
  // Product CAS revision, separate from qualification lease revision.
  expected_business_revision : nat64;
  // Registered product delivery canister.
  adapter : principal;
  // Explicit enabled settlement sources, without duplicates.
  allowed_settlement_methods : vec SettlementMethod;
  // Exclusive immutable end in Unix milliseconds.
  expires_at_ms : nat64;
  // Exclusive initial acceptance deadline; not an activation deadline.
  accept_by_ms : nat64;
  // Exact product terms accepted by the user.
  product_terms_hash : blob;
};
// A ledger-scoped block reference.
type CashBlock = record {
  // Native ledger block index; checked before narrowing in an adapter.
  block_index : nat;
  // Authenticated ledger source.
  ledger : principal;
};
// Durable permission to cancel exactly one cash term: unstarted, or refunded
// early under its product's policy.
type CashCancellationReceipt = record {
  // Full original decision commitment.
  decision_hash : blob;
  // False is a durable refusal, not an unknown cancellation.
  cancelled : bool;
  // Product's new business revision.
  business_revision : nat64;
  // Product contract cancelled atomically.
  contract_id : blob;
  // Time the term's rights stop: the request time for an unstarted term,
  // otherwise no earlier than the last resource lease already issued.
  // Revenue is earned up to it and the rest of the price is refunded.
  cancelled_at_ms : nat64;
  // Checkout order to refund.
  order_id : blob;
};
// Fixed single-asset cash terms; no floating point or implicit peg.
type CashQuote = record {
  // Product price converted using the accepted asset policy.
  amount_atomic : nat;
  // Complete authoritative offer commitment.
  offer_hash : blob;
  // Separately identified fee reserve.
  fee_reserve_atomic : nat;
  // Exclusive funding deadline.
  funding_deadline_ms : nat64;
  // Approved per-transfer fee ceiling.
  max_network_fee_atomic : nat;
  // Exclusive initial activation deadline, not a release rule for Unknown.
  activation_deadline_ms : nat64;
  // Exact per-order receiving account.
  deposit : Account;
  // Commerce version.
  version : nat16;
  // Immutable selected ledger.
  ledger : principal;
  // Approved funding account.
  payer : Account;
  // Commitment to the actual conversion rate / depeg checks.
  conversion_hash : blob;
};
// Each outgoing leg owns its ledger, source, destination, fee, memo and timestamp.
type CashTransfer = record {
  // Approved immutable destination.
  to : Account;
  // Actual transfer state.
  status : CashTransferStatus;
  // Source order subaccount.
  source_subaccount : blob;
  // Net amount to deliver.
  amount_atomic : nat;
  // Ledger-reported replacement fee, not permission to use it.
  expected_fee_atomic : opt nat;
  // A known-rejected predecessor, if any.
  replaces : opt blob;
  // Confirmed block when succeeded.
  block_index : opt nat;
  // Stable sender time in nanoseconds, not the funding proof's ledger timestamp.
  created_at_time_ns : nat64;
  // Stable ledger deduplication memo.
  memo : blob;
  // A replacement leg prevents replay of this one.
  replaced_by : opt blob;
  // Globally unique immutable transfer identity.
  transfer_id : blob;
  // Immutable ledger.
  ledger : principal;
  // Limit accepted by the responsible payer/merchant.
  max_fee_atomic : nat;
  // Frozen fee for this exact attempt.
  fee_atomic : nat;
  // Source order, never another merchant's pool.
  order_id : blob;
  // Stable diagnostic code without private payloads.
  error_code : opt text;
};
// Public transfer advancement does not disclose payer or merchant account details.
type CashTransferProgress = record {
  // Authoritative progress.
  status : CashTransferStatus;
  // Ledger block when known.
  block_index : opt nat;
  // Original immutable leg.
  transfer_id : blob;
};
// Network transfer lifecycle. Unknown is never replaced with another memo/time.
type CashTransferStatus = variant {
  // Replaced only after a known rejection; never dispatch this leg again.
  Superseded;
  // Known ledger rejection; no prior unknown attempt exists.
  Rejected;
  // Actual block confirmed or ledger Duplicate returned.
  Succeeded;
  // Call may still execute.
  InFlight;
  // Original transfer must be retried or matched to a trusted block.
  Unknown;
  // Durable frozen transfer before dispatch.
  Pending;
};
// Outgoing legs visible to their recipient or the corresponding order reader.
type CashTransfersPage = record {
  // Exact immutable transfer arguments and state.
  transfers : vec CashTransfer;
  // Last returned identity when another accessible transfer exists.
  next : opt blob;
};
// Certified commercial catalog; asset identity and governance approval require trusted evidence.
type Catalog = record {
  // Additional storage products in this catalog.
  storage_products : vec StorageProduct;
  // Public record format version, independent of stable storage.
  schema : nat16;
  // Inclusive activation time in Unix milliseconds.
  effective_at_ms : nat64;
  // Immutable version identifier within this policy or catalog.
  version : nat64;
  // Available base-plan snapshots.
  plans : vec PlanVersion;
  // Commitment to the accepted service terms.
  terms_digest : blob;
};
// IC-certified query response. Merely decoding this value authenticates nothing.
// Verify the IC certificate against a trusted root, the expected canister and
// certificate time, then each witness, requested path and exact leaf bytes.
type CertifiedBatch = record {
  // IC data certificate bytes; verify against a trusted IC root key.
  certificate : blob;
  // Version of this public certified-leaf format, not the storage schema.
  schema : nat16;
  // Requested leaves and their membership/absence witnesses.
  entries : vec CertifiedEntry;
  // Canister identity to match against the expected service and certificate.
  canister : principal;
};
// One requested leaf and its IC hash-tree witness.
// A missing value must be checked as an absence proof, not treated as an empty leaf.
type CertifiedEntry = record {
  // Raw requested leaf path segment; compare with the exact expected path.
  key : blob;
  // Exact serialized leaf bytes, or None for requested absence.
  value : opt blob;
  // CBOR-encoded IC hash-tree witness for this requested leaf.
  witness : blob;
};
// Result of registering a real deposit, including wrong-source/late/excess deposits.
type CheckoutDeposit = record {
  // Actual amount received.
  amount_atomic : nat;
  // Still-unallocated refund obligation to the original source.
  refundable_atomic : nat;
  // Original source account; refunds cannot substitute another destination.
  from : Account;
  // Ledger-scoped identity, never a global bare block number.
  block : CashBlock;
  // Original order receiving these funds.
  order_id : blob;
};
// Bounded page of independently refundable funding records for one order.
type CheckoutDepositsPage = record {
  // Opaque cursor after the last returned deposit, only when more remain.
  next : opt blob;
  // Original source and remaining refundable amount of each recorded deposit.
  deposits : vec CheckoutDeposit;
};
// Counts archived in one bounded maintenance call; money obligations are never removed.
type CheckoutHistorySweep = record {
  // Succeeded or superseded outgoing legs moved out of the active tree.
  transfers : nat16;
  // Fully settled orders moved out of the active certification tree.
  orders : nat16;
};
// Exact per-order accounting in one ledger; amounts in distinct ledgers are never added.
type CheckoutLedgerBalance = record {
  // Customer-funded network fee reserve.
  fee_reserve_atomic : nat;
  // Obligations to original deposit sources.
  refundable_atomic : nat;
  // All allocated outgoing obligations, including their exact fees.
  outgoing_atomic : nat;
  // Product price not yet allocated to a merchant transfer.
  service_reserve_atomic : nat;
  // Asset identity.
  ledger : principal;
  // Confirmed incoming amount.
  incoming_atomic : nat;
};
// Private operational observation; delivery continues to require the service's durable receipt.
type CheckoutOperationAudit = record {
  // Original order and receipt.
  order : CheckoutView;
  // Independently conserved balances.
  balances : vec CheckoutLedgerBalance;
};
// Bounded owner/merchant/adapter/governance page, backed by reader indexes.
type CheckoutOperationsPage = record {
  // Accessible orders.
  orders : vec CheckoutOperationAudit;
  // Last returned identity when another accessible order exists.
  next : opt blob;
};
// Safe public progress without disclosing private product bill/account data.
type CheckoutProgress = record {
  // Current state, not inferred from a wallet reply.
  status : CheckoutStatus;
  // Immutable delivery identity when prepared.
  decision_id : opt blob;
  // Original order identity.
  order_id : blob;
};
// Fixed cash terms, including independently verified asset policy.
type CheckoutQuote = record {
  // Accepted conversion and network-fee policy.
  asset : SettlementAsset;
  // Product-authoritative USD bill.
  offer : BillingOffer;
  // Immutable one-ledger payment and refund terms.
  cash : CashQuote;
  // Time used to compute the fixed funding/activation deadlines.
  quoted_at_ms : nat64;
  // Frozen registered merchant, subject schema and adapter configuration.
  product : ProductRegistration;
};
// Same operation identity is retained through every uncertain result.
type CheckoutStatus = variant {
  // Product applied rights and a durable receipt.
  Applied;
  // Product interval reservation is being reconciled; do not fund yet.
  Reserving;
  // Order and its interval are accepted; the payer may transfer once.
  AwaitingFunding;
  // No order permission was granted.
  Rejected;
  // Definitive nondelivery or unstarted cancellation; original deposits are refundable.
  RefundCommitted;
  // Funds and delivery decision committed; adapter acknowledgement is pending.
  Applying;
};
// Owner/adapter view, used for recovery and the billing centre.
type CheckoutView = record {
  // Product receipt if obtained.
  receipt : opt ProductReceipt;
  // Remaining customer-funded network reserve.
  fee_reserve_atomic : nat;
  // Cumulative allocated transfers for the selected asset, including their fees.
  outgoing_atomic : nat;
  // Original fixed terms.
  quote : CheckoutQuote;
  // Identity and public state.
  progress : CheckoutProgress;
  // Amount of price still reserved, never withdrawable before earned.
  service_reserve_atomic : nat;
  // Product cancellation result, including the actual end of an early-refunded term.
  cancellation : opt CashCancellationReceipt;
};
// One allowed choice value and its displayed label.
type ChoiceOption = record {
  // Encoded value.
  value : text;
  // Displayed label, one entry per locale.
  label : vec ActionLabel;
};
// One command: its displayed title and complete argument list.
type CommandSchema = record {
  // Displayed title, one entry per locale.
  title : vec ActionLabel;
  // Stable command name.
  name : text;
  // Arguments in display and encoding order, with unique names.
  fields : vec FieldSchema;
};
// Product commerce deployment, accepted asset and admission configuration.
type CommerceInit = record {
  // Deployment domain of the request or service.
  environment : Environment;
  // Governance Principal controlling this service configuration.
  governance : principal;
  // Shared PANDA qualification authority.
  membership_canister : principal;
  // Permitted dMsg account-authority canisters.
  user_homes : vec principal;
  // Fixed catalog snapshot.
  catalog : Catalog;
  // Admission limits; governance can change them later.
  limits : CommerceLimits;
};
// Commerce admission limits. Only new subjects, orders and outgoing calls are
// refused when a limit is reached; recovery of accepted operations continues.
type CommerceLimits = record {
  // New merchant-order limit per UTC day.
  daily_orders : nat32;
  // Maximum orders kept in the hot table, including live subscriptions.
  max_hot_orders : nat64;
  // Quote and checkout authorization calls per UTC minute.
  authorizations_per_minute : nat32;
  // PANDA qualification refreshes per UTC minute.
  refreshes_per_minute : nat32;
  // Maximum order identities ever admitted, hot and archived.
  max_orders : nat64;
  // Share of `calls_per_minute` one caller may use; a dispatch job needs
  // more than an end user.
  calls_per_caller : nat32;
  // Maximum retained beneficiary subjects with a paid or granted contract.
  max_subjects : nat64;
  // Funding, product and outgoing-transfer calls per UTC minute.
  calls_per_minute : nat32;
};
// Live record counts and resources of a commerce canister, read against its
// limits to see how much admission headroom remains.
type CommerceStats = record {
  // Applied orders with revenue their merchant has not collected.
  collectable_orders : nat64;
  // Beneficiary subjects with a paid or granted contract.
  subjects : nat64;
  // Orders in the hot table.
  hot_orders : nat64;
  // Cycle balance.
  cycles : nat;
  // Archived orders; hot and archived together count against `max_orders`.
  archived_orders : nat64;
  // Archived outgoing legs.
  archived_transfers : nat64;
  // Stable memory in 64 KiB pages.
  stable_pages : nat64;
  // Outgoing legs in the hot table, in any state.
  hot_transfers : nat64;
  // Certified keys: registrations, the catalog and one leaf per subject.
  certified_leaves : nat64;
};
type ContractSourceV1 = variant {
  Sns : record { claim_id : blob };
  Cash : record { order_id : blob };
  AppStore : record {
    transaction_id : blob;
    environment : opt StoreEnvironment;
  };
  Compensation;
};
type ContractSourceV2 = variant {
  Sns : record { claim_id : blob };
  Cash : record { order_id : blob };
  AppStore : record {
    transaction_id : blob;
    environment : opt StoreEnvironment;
  };
  Compensation;
  GooglePlay : record {
    transaction_id : blob;
    environment : PlayEnvironment;
    token_hash : blob;
  };
};
// Qualification observation; unverifiable is distinct from known ineligibility.
type Eligibility = variant {
  // Current supporting facts cannot be verified.
  Unverifiable;
  // Known not to satisfy the policy.
  Ineligible;
  // Known to satisfy the fixed qualification policy.
  Eligible;
};
// Certified resource lease projection; validate beneficiary, revisions and expiry before use.
type EntitlementView = record {
  // Contracts supporting this issued lease.
  lease_source_contract_ids : vec blob;
  // Base-plan terms used for this projection.
  plan_snapshot : PlanVersion;
  // Revision of business terms or qualification, independent of lease refreshes.
  business_revision : nat64;
  // Known service termination time in Unix milliseconds.
  service_terminated_at_ms : opt nat64;
  // Product subject receiving the benefit.
  beneficiary : Beneficiary;
  // Public record format version, independent of stable storage.
  schema : nat16;
  // Exclusive validity deadline in Unix milliseconds.
  valid_until_ms : nat64;
  // Time the supporting qualification observation began, in Unix milliseconds.
  observed_at_ms : nat64;
  // Qualification repair deadline in Unix milliseconds, when applicable.
  // PANDA terminates immediately, so this is currently always `None`.
  repair_deadline_ms : opt nat64;
  // Monotonic projection/lease revision, including refreshes.
  lease_revision : nat64;
  // Projection issuance time in Unix milliseconds.
  issued_at_ms : nat64;
  // Commerce canister authoritative for this order or lease.
  home_commerce : principal;
  // Separately valid paid storage entitlements.
  addons : vec StorageAddon;
  // Known resource stop time in Unix milliseconds.
  effective_stop_at_ms : opt nat64;
  // Combined currently applicable resource limits.
  effective_limits : ResourceLimits;
  // Next known resource-limit transition in Unix milliseconds.
  next_limit_change_at_ms : opt nat64;
  // Current resource-source lifecycle.
  source_status : SourceStatus;
  // Qualification assessment supporting this projection.
  eligibility_status : Eligibility;
  // Currently selected base contract, absent for Free.
  active_contract_id : opt blob;
};
// Deployment domain used to separate identities and key derivation.
type Environment = variant {
  // Local development deployment.
  Local;
  // Production deployment with pinned chain-key configuration.
  Production;
  // Pre-production deployment domain.
  Staging;
};
// Application errors returned by dMsg canisters and protocol helpers.
// Transport failures and Candid decoding failures are separate from this enum.
type Error = variant {
  // Required legacy key material is unavailable.
  MigrationKeyUnavailable;
  // Legacy business writes are frozen.
  LegacyWriteDisabled;
  // This Passkey identity already has the maximum number of login sessions.
  SessionLimitExceeded;
  // A supplied field or combination is invalid; carries a diagnostic.
  InvalidInput : text;
  // Another accepted operation owns the same product interval.
  IntervalReserved;
  // A neuron still supports a committed or pending product application.
  NeuronOccupied;
  // A new content root must be committed before writes can resume.
  RekeyRequired;
  // Expected version/generation differs from current state; reread before preparing a new approval.
  VersionConflict;
  // Execution may have occurred; reconcile the original request instead of creating another.
  ExecutionUnknown;
  // A digest, signature, proof or accounting invariant failed validation.
  IntegrityFailed;
  // Account-ID timestamp cannot fit the generator format.
  IdTimestampOutOfRange;
  // The requested record does not exist.
  NotFound;
  // The approved fee or available fee reserve cannot support the transfer.
  FeeBlocked;
  // The device is missing, revoked or not approved for this operation.
  DeviceNotApproved;
  // Sensitive operations are locked by account state or policy.
  Locked;
  // The source benefit is closing and cannot issue new leases.
  MembershipClosing;
  // Required recovery setup/confirmation has not completed.
  RecoveryIncomplete;
  // Account-ID counter space is exhausted for this timestamp.
  IdCapacityExceeded;
  // Approval or policy evidence refers to an outdated security state.
  PolicyStale;
  // Persisted account-ID allocator state does not match its configured namespace.
  IdGeneratorStateConflict;
  // An operation ID was reused with different parameters.
  IdempotencyConflict;
  // The profile, algorithm or protocol version is unsupported.
  UnsupportedProtocol;
  // A required service or resource is unavailable; carries a diagnostic.
  Unavailable : text;
  // Commercial qualification is temporarily unverifiable or its lease expired.
  MembershipStale;
  // Caller, role or capability does not authorize this operation.
  Forbidden;
  // Retained output is no longer available; this does not authorize replay.
  ResultExpired;
  // The applicable deadline has passed.
  Expired;
  // The subject is known to be ineligible for the requested benefit.
  MembershipIneligible;
  // An execution, cycle, storage or admission limit was exceeded.
  QuotaExceeded;
  // An authenticated and appropriately bound caller is required.
  AuthRequired;
  // The operation is not yet complete; query/retry the same operation as appropriate.
  Pending;
};
// Consistent resource lease and monthly formal-execution allocation.
type ExecutionEntitlement = record {
  // Monthly quota calculation matching this beneficiary.
  month : MonthEntitlement;
  // Resource qualification and lease projection.
  view : EntitlementView;
};
// Versioned integer cost of one formal attestation.
type ExecutionWeights = record {
  // Units charged for one Ed25519 device attestation.
  ed25519 : nat64;
  // Immutable version identifier within this policy or catalog.
  version : nat64;
};
// One argument or record field. Every field is always displayed.
type FieldSchema = record {
  // Accepted value type and bounds.
  ty : FieldType;
  // Stable field name.
  name : text;
  // Displayed label, one entry per locale.
  label : vec ActionLabel;
};
// Field types and bounds. Nesting is limited to three levels.
type FieldType = variant {
  // Unsigned integer in the inclusive range.
  Nat : record {
    // Inclusive maximum.
    max : nat64;
    // Inclusive minimum.
    min : nat64;
  };
  // External artifact reference.
  Artifact;
  // Boolean with explicit labels for both values.
  Bool : record {
    // Label of `false`.
    no : vec ActionLabel;
    // Label of `true`.
    yes : vec ActionLabel;
  };
  // Nonzero 32-byte commitment.
  Hash;
  // Fixed fields.
  Record : record {
    // Fields in display and encoding order, with unique names.
    fields : SchemaFields;
  };
  // Items of one type.
  List : record {
    // Item type.
    item : FieldType;
    // Maximum item count.
    max_items : nat64;
  };
  // Nonblank verbatim text.
  Text : record {
    // Whether line breaks and tabs are allowed and preserved.
    multiline : bool;
    // Maximum UTF-8 length.
    max_bytes : nat64;
  };
  // Authenticated principal.
  Principal;
  // One of the declared options.
  Choice : record {
    // Allowed values with unique names.
    options : vec ChoiceOption;
  };
  // Either `Null` or a value of the item type.
  Optional : record {
    // Present value type; not itself optional.
    item : FieldType;
  };
};
// Independent admission policy; an Apple verifier is not implicitly admitted.
type GooglePlayConfig = record {
  // Authorized Google verification service principals.
  verifiers : vec principal;
  // Primary purchase environment.
  environment : PlayEnvironment;
  // Governed product/option/offer mappings; no inferred SKU meaning.
  products : vec PlayProduct;
  // Exact Android package, including any distribution suffix.
  package_name : text;
  // Explicit production opt-in for test base subscriptions, not consumables.
  accept_test : bool;
};
type LegacyContract = record {
  resource_pauses : vec record { nat64; opt nat64 };
  terminated_at_ms : opt nat64;
  source : ContractSourceV1;
  qualified_until_ms : nat64;
  plan : PlanVersion;
  observed_at_ms : nat64;
  contract_id : blob;
  starts_at_ms : nat64;
  eligibility : Eligibility;
  term_starts_at_ms : nat64;
  expires_at_ms : nat64;
};
type LegacyContract_1 = record {
  resource_pauses : vec record { nat64; opt nat64 };
  terminated_at_ms : opt nat64;
  source : ContractSourceV2;
  qualified_until_ms : nat64;
  plan : PlanVersion;
  observed_at_ms : nat64;
  contract_id : blob;
  starts_at_ms : nat64;
  eligibility : Eligibility;
  term_starts_at_ms : nat64;
  expires_at_ms : nat64;
};
type LegacyTerms = record {
  contracts : vec LegacyContract;
  addons : vec StorageAddon;
  refund : opt RefundWindow;
};
type LegacyTerms_1 = record {
  contracts : vec LegacyContract_1;
  addons : vec StorageAddon;
  refund : opt RefundWindow;
};
// Versioned monthly quota calculation; retain prior segments when terms change.
type MonthEntitlement = record {
  // Revision of business terms or qualification, independent of lease refreshes.
  business_revision : nat64;
  // Version of the monthly allowance algorithm.
  calculation_version : nat16;
  // Product subject receiving the benefit.
  beneficiary : Beneficiary;
  // Contiguous quota segments, limited to 64 by protocol validation.
  segments : vec MonthSegment;
  // Total monthly units, rounding down once after summing weighted durations.
  allowed_units : nat64;
  // Versioned execution-cost weights.
  weights : ExecutionWeights;
  // Revision of the retained monthly calculation.
  month_revision : nat64;
  // YYYYMM in UTC.
  month_utc : nat32;
};
// Contiguous half-open UTC millisecond interval weighted by a full-month quota.
type MonthSegment = record {
  // Inclusive segment start in Unix milliseconds.
  start_ms : nat64;
  // Full-month units applicable during this segment.
  monthly_units : nat64;
  // Exclusive segment end in Unix milliseconds.
  end_ms : nat64;
  // Contract supporting the segment, or None for Free.
  source_contract_id : opt blob;
};
// Opening never transfers funds. Transfer only after an accepted order exists.
type OpenCheckout = record {
  // Accepted immutable quote.
  quote : CheckoutQuote;
  // Account and product permission input.
  authorization : ProductAuthorizationRequest;
};
// Base resource tier; it grants no account or cryptographic permissions.
type PlanId = variant {
  // Max base tier.
  Max;
  // Pro base tier.
  Pro;
  // Free base tier.
  Free;
  // Plus base tier.
  Plus;
};
// Immutable base-plan price, limits, weights and policy snapshot.
type PlanVersion = record {
  // Immutable catalog version containing this plan.
  catalog_version : nat64;
  // Version of the accepted service terms.
  terms_version : nat64;
  // Integer annual or product price in USD cents.
  price_cents : nat64;
  // Versioned execution-cost weights.
  weights : ExecutionWeights;
  // Base resource tier.
  plan_id : PlanId;
  // Base resource limits.
  limits : ResourceLimits;
};
// Google test purchases use the same API, independently of business staging.
type PlayEnvironment = variant {
  // A real Google Play purchase.
  Production;
  // A purchase identified as a test by Google's authenticated response.
  Test;
};
// One allowed product/option/offer tuple. IDs do not encode a dMsg tier.
type PlayProduct = record {
  // Exact Google product identifier.
  product_id : text;
  // Entitlement and exact option controlled by governance.
  kind : PlayProductKind;
  // Disabling new purchases retains verification of existing receipts.
  enabled : bool;
  // Null selects the base offer, never an arbitrary discount.
  offer_id : opt text;
};
// Exact storefront selection; price and offer tokens come from Play Billing.
type PlayProductKind = variant {
  // A consumable storage addon for the current Google subscription term.
  Storage : record {
    // Existing governed dMsg storage product.
    product : blob;
    // Exact Google one-time purchase option.
    purchase_option_id : text;
  };
  // Auto-renewing base membership. Prepaid, installment and rental products
  // are not silently interpreted as an annual dMsg subscription.
  Plan : record {
    // Existing governed dMsg tier.
    plan : PlanId;
    // Exact Google base plan.
    base_plan_id : text;
  };
};
// Authority-side reconciliation result, readable only by configured verifiers.
type PlayReceipt = record {
  // Last actual provider check.
  checked_at_ms : nat64;
  // Stable receipt identity.
  transaction_id : blob;
  // Original, immutable recipient.
  beneficiary : Beneficiary;
  // Current provider state.
  state : PlayState;
  // Whether this receipt ever produced its entitlement (not just a callback).
  delivered : bool;
  // Last accepted provider observation order.
  revision : nat64;
  // Fixed storage term end, or current subscription expiry.
  expires_at_ms : opt nat64;
};
// Current provider state. Cancellation of renewal retains access until expiry.
type PlayState = variant {
  // Google subscription is suspended for a payment problem.
  OnHold;
  // Google subscription is paused.
  Paused;
  // A one-time purchase is canceled or fully refunded.
  Refunded;
  // Google retains subscription access during its grace period.
  Grace;
  // Current Google subscription or one-time purchase is active.
  Active;
  // A pending subscription was canceled before payment.
  PendingCanceled;
  // Subscription has ended, including immediate provider revocation.
  Expired;
  // Renewal is canceled; current access still follows Google's expiry.
  Canceled;
  // Payment is not complete; must not deliver or acknowledge.
  Pending;
};
// Facts obtained from authenticated Developer APIs, not client JSON or RTDN
// event order. The verifier must re-read current state before granting access.
type PlayTransaction = record {
  // Time current Google state was read; must be fresh at canister application.
  checked_at_ms : nat64;
  // Stable 64-character account binding, independently recomputed here.
  account_binding : text;
  // The provider identifies this token as replaced; it cannot revive later.
  replaced : bool;
  // Exact selected Google product ID.
  product_id : text;
  // Actual predecessor token identified by Google's linkedPurchaseToken.
  linked_token_hash : opt blob;
  // Exact entitlement beneficiary bound by Google's obfuscated account ID.
  beneficiary : Beneficiary;
  // Storage only: original base contract, bound by Google's obfuscated
  // profile ID. Recovery must not attach an old purchase to a new term.
  base_contract_id : opt blob;
  // Original order's billing-period anchor. A deferred replacement transfers
  // its remaining interval without starting a new paid year. Absent for
  // storage and earlier non-transferred observations.
  term_starts_at_ms : opt nat64;
  // Base plan or purchase option ID, depending on the governed kind.
  option_id : text;
  // Current verified subscription or product state.
  state : PlayState;
  // Start of the owned interval: max of the order period anchor and this
  // token's subscription start. One-time products use completion time.
  purchased_at_ms : nat64;
  // Exact observed offer; absent for the base offer.
  offer_id : opt text;
  // Environment from Google's test-purchase field.
  environment : PlayEnvironment;
  // Latest successful order for subscriptions; optional for one-time products.
  order_id : opt text;
  // Durable observation order assigned by the verifier for this token.
  revision : nat64;
  // SHA-256 of the raw Google purchase token; the token is never on-chain.
  token_hash : blob;
  // Package under which the Developer API verified the token.
  package_name : text;
  // Current subscription expiry from subscriptionsv2, never an order snapshot.
  expires_at_ms : opt nat64;
};
// Explicit product permission; not a claim that the payer has a project role.
type ProductApproval = record {
  // Accepted settlement method.
  method : SettlementMethod;
  // Product-owned approval identity.
  approval_id : blob;
  // Exact bill accepted by the product operator.
  offer_hash : blob;
  // Operator whose product permissions must remain valid at delivery.
  operator : principal;
  // Protocol version two.
  version : nat16;
  // Exclusive application deadline, never extended on retry.
  expires_at_ms : nat64;
  // Approval time.
  approved_at_ms : nat64;
};
// Inputs authenticated by checkout/membership before asking the product authority.
type ProductAuthorizationRequest = record {
  // Explicit product approval; a personal-account adapter may derive owner consent from account_approval.
  product_approval : opt ProductApproval;
  // dMsg device-approved account and economic actor.
  account_approval : ApplicationApproval;
  // Exact device approval record.
  approval_id : blob;
  // Registered dMsg user home that verified the approval.
  user_home : principal;
  // Exact authoritative bill.
  offer : BillingOffer;
};
// Durable product delivery decision, persisted before the external Apply call.
type ProductDecision = record {
  // Permanent decision identity; never replaced after an unknown response.
  decision_id : blob;
  // Complete accepted business offer.
  offer : BillingOffer;
  // Typed source verified against the fixed service caller.
  source : SettlementSource;
  // Decision preparation time in Unix milliseconds.
  decided_at_ms : nat64;
  // Commerce version.
  version : nat16;
  // Exclusive delivery deadline; unknown delivery never implies a refund.
  apply_by_ms : nat64;
};
// Terminal Apply result. Unknown is the absence of an authenticated receipt.
type ProductOutcome = variant {
  // Rights and the receipt were committed atomically.
  Applied : record {
    // Product business revision after Apply.
    business_revision : nat64;
    // Immutable contract identity.
    contract_id : blob;
    // Earliest permissible commitment release time.
    committed_until_ms : nat64;
  };
  // Known rejection, persisted and idempotently retrievable.
  Rejected : record {
    // Stable typed reason without sensitive free-form diagnostics.
    reason : ProductRejection;
  };
};
// Authenticated product receipt, not an untrusted browser success flag.
type ProductReceipt = record {
  // Complete decision commitment; catches same-ID/different-bytes retries.
  decision_hash : blob;
  // Original immutable decision identity.
  decision_id : blob;
  // Atomic receipt creation time in Unix milliseconds.
  applied_at_ms : nat64;
  // Commerce version.
  version : nat16;
  // Terminal delivery result.
  outcome : ProductOutcome;
  // Fixed registered delivery authority.
  adapter : principal;
};
// Product identity, subject schema and settlement boundary.
type ProductRegistration = record {
  // Canisters supplying beneficiary permissions, append-only. A subject names
  // one of them; a dMsg account product lists every user home.
  beneficiary_authorities : vec principal;
  // Stable product identifier.
  product_id : text;
  // Exact subject byte length.
  subject_size : nat16;
  // Current product terms commitment.
  terms_hash : blob;
  // Commerce version, currently two.
  version : nat16;
  // Monotonically increasing configuration version.
  config_version : nat64;
  // Merchant settlement identity, separate from the beneficiary.
  merchant : Account;
  // Canister supplying authoritative offers.
  quote_authority : principal;
  // Deployment separation.
  environment : Environment;
  // Enabled ledgers, explicitly configured even in local fixtures.
  ledgers : vec principal;
  // Canister applying product decisions.
  adapter : principal;
  // Fixed interpretation of subject bytes.
  subject_schema : text;
  // Stops new commitments only.
  paused : bool;
};
// Expected terminal product rejections.
type ProductRejection = variant {
  // Authoritative quote or product terms no longer match.
  OfferMismatch;
  // Another operation already owns the same interval.
  IntervalReserved;
  // Business revision changed.
  RevisionConflict;
  // Product permission is no longer valid.
  Unauthorized;
  // Delivery deadline or permitted interval has passed.
  Expired;
};
// Governed authorization for new grants and recovery of outstanding requests.
type PromoConfig = record {
  // Principals allowed to submit authenticated grant decisions.
  verifiers : vec principal;
  // Admit new grants.
  enabled : bool;
};
// Aggregate first applications and first revocations for one combination.
type PromoCount = record {
  // Compensation accounting category.
  compensation : bool;
  // Previously issued grants revoked.
  revoked : nat64;
  // Interval in days.
  days : nat16;
  // Plan granted.
  plan : PlanId;
  // All first deliveries, including revoked contracts.
  issued : nat64;
};
// Immutable grant parameters. Both endpoints are UTC milliseconds.
type PromoGrant = record {
  // Service compensation uses its existing source.
  compensation : bool;
  // Account and authority recorded at acceptance.
  beneficiary : Beneficiary;
  // Plus, Pro or Max.
  plan : PlanId;
  // First reservation time, inclusive.
  starts_at_ms : nat64;
  // Exactly 30 or 365 days after the start, exclusive.
  expires_at_ms : nat64;
  // Domain-separated, globally unique operation identifier.
  grant_id : blob;
};
// Authoritative delivery outcome for this immutable request.
type PromoOutcome = variant {
  // The contract was issued.
  Applied;
  // Irrevocable non-delivery for this request ID.
  Rejected : text;
  // The previously issued contract ended at this time.
  Revoked : nat64;
};
// Persisted result. A duplicate request returns the current receipt.
type PromoReceipt = record {
  // Business revision after the decision.
  business_revision : nat64;
  // Identical on every replay.
  grant : PromoGrant;
  // Grant lifecycle state.
  outcome : PromoOutcome;
  // First observed formal purchase in the attribution window (source, UTC ms).
  conversion : opt record { text; nat64 };
};
// The first cash base contract of a beneficiary, refundable for its unused
// time until `until_ms`.
type RefundWindow = record {
  // Exclusive end of the self-service refund window in Unix milliseconds.
  until_ms : nat64;
  // Product contract identity.
  contract_id : blob;
  // Merchant order whose payer may cancel it.
  order_id : blob;
};
// Logical storage, active-channel and formal-execution resource limits.
type ResourceLimits = record {
  // Number of active sponsored channel slots.
  active_channels : nat64;
  // Full UTC-month allowance of weighted formal-execution units.
  monthly_execution_units : nat64;
  // Logical retained ciphertext capacity in bytes.
  storage_bytes : nat64;
};
type Result = variant { Ok; Err : Error };
type Result_1 = variant { Ok : EntitlementView; Err : Error };
type Result_10 = variant { Ok : CashTransfer; Err : Error };
type Result_11 = variant { Ok : opt CashCancellationReceipt; Err : Error };
type Result_12 = variant { Ok : CertifiedBatch; Err : Error };
type Result_13 = variant { Ok : CheckoutView; Err : Error };
type Result_14 = variant { Ok : ExecutionEntitlement; Err : Error };
type Result_15 = variant { Ok : opt PlayReceipt; Err : Error };
type Result_16 = variant { Ok : LegacyTerms; Err : Error };
type Result_17 = variant { Ok : LegacyTerms_1; Err : Error };
type Result_18 = variant { Ok : TermsDisplayV3; Err : TermsErrorV3 };
type Result_19 = variant { Ok : opt ProductReceipt; Err : Error };
type Result_2 = variant { Ok : ProductReceipt; Err : Error };
type Result_20 = variant { Ok : opt PromoReceipt; Err : Error };
type Result_21 = variant { Ok : BillingOffer; Err : Error };
type Result_22 = variant { Ok : CashTransferProgress; Err : Error };
type Result_23 = variant { Ok : SettlementAsset; Err : Error };
type Result_24 = variant { Ok : CheckoutQuote; Err : Error };
type Result_25 = variant {
  Ok : record { AppRegistration; opt ProductRegistration };
  Err : Error;
};
type Result_26 = variant { Ok : text; Err : text };
type Result_3 = variant { Ok : PromoReceipt; Err : Error };
type Result_4 = variant { Ok : CashCancellationReceipt; Err : Error };
type Result_5 = variant { Ok : CheckoutProgress; Err : Error };
type Result_6 = variant { Ok : nat64; Err : Error };
type Result_7 = variant { Ok : CheckoutDepositsPage; Err : Error };
type Result_8 = variant { Ok : CheckoutOperationsPage; Err : Error };
type Result_9 = variant { Ok : CashTransfersPage; Err : Error };
// Fields in display and encoding order: a command's arguments or a record's fields.
type SchemaFields = vec record {
  ty : variant {
    Nat : record { max : nat64; min : nat64 };
    Artifact;
    Bool : record {
      no : vec record { "text" : text; locale : text };
      yes : vec record { "text" : text; locale : text };
    };
    Hash;
    Record : record { fields : SchemaFields };
    List : record { item : FieldType; max_items : nat64 };
    Text : record { multiline : bool; max_bytes : nat64 };
    Principal;
    Choice : record {
      options : vec record {
        value : text;
        label : vec record { "text" : text; locale : text };
      };
    };
    Optional : record { item : FieldType };
  };
  name : text;
  label : vec record { "text" : text; locale : text };
};
// Governance-approved asset/price snapshot. Pausing admission never removes refund routing.
type SettlementAsset = record {
  // Verified atomic precision; initial assets require six decimals.
  decimals : nat16;
  // Declared kind, checked against the configured ledger identity.
  asset : SettlementAssetKind;
  // Per-transfer cap accepted for new orders.
  max_network_fee_atomic : nat;
  // Exclusive validity end of that price observation.
  price_valid_until_ms : nat64;
  // Time of the trusted price observation.
  price_observed_at_ms : nat64;
  // Protocol version two.
  version : nat16;
  // New-quote admission only.
  enabled : bool;
  // Latest verified ledger network fee.
  network_fee_atomic : nat;
  // Ledger identity, not a symbol.
  ledger : principal;
  // Deployment domain.
  environment : Environment;
  // Explicit reference USD micro price for one full token.
  price_usd_micros : nat;
  // Immutable revision for this ledger.
  policy_version : nat64;
};
// Initially supported stable assets, bound to fixed ledger IDs outside Local.
type SettlementAssetKind = variant {
  // ckUSDC on ICP.
  CkUsdc;
  // ckUSDT on ICP.
  CkUsdt;
};
// Asset discovery remains available while quotes are paused.
type SettlementAssetView = record {
  // Metadata/block format has been verified for this policy.
  ledger_verified : bool;
  // Exact current asset policy.
  policy : SettlementAsset;
};
// Mutually exclusive settlement sources. PANDA always covers the entire offer.
type SettlementMethod = variant {
  // One explicitly enabled ledger.
  Cash;
  // Full subscription waiver without any cash transfer.
  Panda;
};
// Paid/waived provenance. PANDA never fabricates a ledger payment reference.
type SettlementSource = variant {
  // Confirmed receipt of a single selected asset.
  Cash : record {
    // Actual product price, excluding the separately tracked fee reserve.
    amount_atomic : nat;
    // Authentic ICRC block index.
    block_index : nat;
    // Selected ledger, also scopes block deduplication.
    ledger : principal;
    // Checkout order identity.
    order_id : blob;
  };
  // Full waiver requiring a live qualification lease.
  Panda : record {
    // Shared membership claim identity.
    claim_id : blob;
    // Exact accepted quotation.
    quote_hash : blob;
    // Current exclusive lease end, bounded by contract end.
    lease_until_ms : nat64;
    // Immutable commitment, even if benefit later terminates.
    committed_until_ms : nat64;
  };
};
// Closed signing profiles that an application may request.
type SigningProfile = variant {
  // Existing text-plus-file statement profile.
  FileStatementV1;
  // Existing raw UTF-8 text statement profile.
  TextStatementV1;
  // Existing SHA-256 digest statement profile.
  DigestStatementV1;
  // Typed application action profile.
  AppActionV1;
};
// Current resource-source state, distinct from account security state.
type SourceStatus = variant {
  // Current supporting facts cannot be verified.
  Unverifiable;
  // Free base tier.
  Free;
  // Benefit closure is in progress.
  Closing;
  // Benefit is active under its recorded terms.
  Active;
  // New paid resource admission is suspended.
  Suspended;
  // Known qualification loss within a repair period; retained for the
  // existing commerce projection, never emitted after immediate termination.
  RepairRequired;
  // The source interval has expired.
  Expired;
};
// Paid storage entitlement with its own interval and issued-lease deadline.
type StorageAddon = record {
  // Product contract identity.
  contract_id : blob;
  // Inclusive interval start in Unix milliseconds.
  starts_at_ms : nat64;
  // Logical retained ciphertext capacity in bytes.
  storage_bytes : nat64;
  // Stable merchant order identity.
  order_id : blob;
  // Exclusive interval end in Unix milliseconds.
  expires_at_ms : nat64;
  // Latest resource-lease deadline already issued, in Unix milliseconds.
  last_issued_until_ms : nat64;
};
// Additional storage product with fixed size and annual price.
type StorageProduct = record {
  // Product identifier within this protocol.
  product_id : blob;
  // Integer annual price in USD cents, prorated to the base term endpoint.
  price_cents : nat64;
  // Logical retained ciphertext capacity in bytes.
  storage_bytes : nat64;
};
// Apple's transaction environment, independent of the business deployment.
type StoreEnvironment = variant {
  // Transactions signed for App Store distribution.
  Production;
  // Apple sandbox transactions; production admission requires explicit opt-in.
  Sandbox;
};
// One App Store Connect product ID, independent of the application's SKU.
type StoreProduct = record {
  // Exact Apple product identifier.
  product_id : text;
  // Existing dMsg product to grant.
  kind : StoreProductKind;
};
// A governed mapping from an Apple product to an existing dMsg catalogue item.
type StoreProductKind = variant {
  // Storage for the active subscription term.
  Storage : blob;
  // Annual base subscription.
  Plan : PlanId;
};
// Facts extracted from a cryptographically verified Apple transaction.
type StoreTransaction = record {
  // Time the verifier checked current Apple status, or submitted a verified revocation.
  checked_at_ms : nat64;
  // Immutable Apple transaction ID, retained across retries.
  transaction_id : text;
  // StoreKit appAccountToken in UUID form.
  app_account_token : text;
  // Signed bundle ID.
  bundle_id : text;
  // Exact configured product ID.
  product_id : text;
  // Rights recipient; the account token must bind the same beneficiary.
  beneficiary : Beneficiary;
  // Apple's signedDate, used to reject older observations.
  signed_at_ms : nat64;
  // Original subscription chain. Each paid transaction keeps its beneficiary;
  // a new term after expiry may bind the chain to another account.
  original_transaction_id : text;
  // Apple purchase time in Unix milliseconds.
  purchased_at_ms : nat64;
  // Signed Apple environment.
  environment : StoreEnvironment;
  // Verified refund or revocation time.
  revoked_at_ms : opt nat64;
  // Apple subscription expiry; absent only for a configured storage product.
  expires_at_ms : opt nat64;
  // Apple has replaced this transaction with an upgrade; it cannot grant new rights.
  is_upgraded : opt bool;
};
// Open identifiers allow older readers to display future sources.
type TermDisplayV3 = record {
  // Google Play subscription reference, never a purchase token.
  store_token_hash : opt blob;
  // Earlier end if revoked.
  terminated_at_ms : opt nat64;
  // Product contract id.
  contract_id : blob;
  // Inclusive start.
  starts_at_ms : nat64;
  // Source receipt id if present.
  source_ref : opt blob;
  // Annual term anchor.
  term_starts_at_ms : nat64;
  // Stable display tier.
  plan_id : text;
  // Stable open source identifier.
  source_kind : text;
  // Exclusive end.
  expires_at_ms : nat64;
  // Test transactions are identified independently of their source.
  is_sandbox : bool;
  // Store classification for an existing client.
  store_environment : opt text;
};
// Display only. Resource admission always uses the certified lease.
type TermsDisplayV3 = record {
  // Match to the certified entitlement before offering actions.
  business_revision : nat64;
  // Open action identifiers understood by the caller.
  allowed_actions : vec text;
  // Retained contracts.
  contracts : vec TermDisplayV3;
  // Unexpired paid storage.
  addons : vec StorageAddon;
  // Applicable first cash refund.
  refund : opt RefundWindow;
};
// Stable textual error code for the display-only interface.
type TermsErrorV3 = record {
  // Nonlocalized machine code.
  code : text;
};
service : (CommerceInit) -> {
  // Append a user home. Its `dmsg_user` must name this canister as
  // `commerce_canister`; product registrations list it separately.
  admin_add_user_home : (principal) -> (Result);
  // Replace the admission limits. Accepted subjects, orders and recovery are unaffected.
  admin_set_limits : (CommerceLimits) -> (Result);
  apply_app_store_transaction : (StoreTransaction) -> (Result_1);
  apply_google_play_transaction : (PlayTransaction) -> (Result_1);
  // Only a failed call to an authority leaves the decision unknown. Every other failure
  // is a durable rejection, so the settlement service can refund without waiting.
  apply_product_decision : (ProductDecision) -> (Result_2);
  apply_promo_grant : (PromoGrant) -> (Result_3);
  cancel_cash_contract : (blob, blob, blob) -> (Result_4);
  cancel_checkout : (blob) -> (Result_5);
  check_checkout_funding : (blob, CashBlock) -> (Result_5);
  // Authority observation for issuing one guest pass. The caller also enforces its annual limit.
  check_guest_pass_issuer : (Beneficiary) -> (Result_6);
  checkout_deposits : (blob, opt blob, nat16) -> (Result_7) query;
  // Private operations centre; quoting and monitoring never reserve an interval.
  checkout_operations : (opt blob, nat16) -> (Result_8) query;
  checkout_progress : (blob) -> (Result_5) query;
  checkout_transfers : (opt blob, nat16) -> (Result_9) query;
  // Return the unused fee reserve to the payer once all revenue is collected.
  // Anyone may trigger it: the destination is the payer frozen in the quote.
  claim_checkout_fee_reserve : (blob) -> (Result_10);
  claim_checkout_refund : (blob, principal, vec nat, blob) -> (Result_10);
  // Monitor the calling merchant's applied orders still awaiting automatic
  // collection, ordered by service end (including an early refund).
  collectable_checkouts : (opt blob, nat16) -> (Result_8) query;
  // Record counts against the limits, with the stable size and cycle balance.
  commerce_stats : () -> (CommerceStats) query;
  get_app_store_config : () -> (opt AppStoreConfig) query;
  get_cash_cancellation : (blob) -> (Result_11);
  get_catalog : () -> (Result_12) query;
  get_checkout : (blob) -> (Result_13) query;
  // Consensus read for the pinned product adapter during Apply. Query replies are not delivery authority.
  get_checkout_for_product : (blob) -> (Result_13);
  get_checkout_transfer : (blob) -> (Result_10) query;
  get_commerce_limits : () -> (CommerceLimits) query;
  get_entitlement_batch : (vec Beneficiary) -> (Result_12) query;
  get_execution_entitlement : (Beneficiary, nat32, nat64) -> (Result_14);
  get_google_play_config : () -> (opt GooglePlayConfig) query;
  get_google_play_receipt : (PlayEnvironment, blob) -> (Result_15) query;
  // Original display interface. Google Play terms require get_membership_terms_v2;
  // return UnsupportedProtocol instead of changing the original source variant.
  get_membership_terms : (Beneficiary) -> (Result_16) query;
  // A beneficiary's base contracts and storage add-ons for display, with the
  // refund window of its first cash purchase. An account that never bought
  // anything has none; its rights are the certified Free entitlement.
  get_membership_terms_v2 : (Beneficiary) -> (Result_17) query;
  get_membership_terms_v3 : (Beneficiary) -> (Result_18) query;
  get_product_decision : (blob) -> (Result_19);
  get_promo_config : () -> (PromoConfig) query;
  get_promo_receipt : (blob) -> (Result_20);
  // Public, authenticated discovery. A paused configuration remains discoverable.
  integration_configuration_certificate : (text, opt text) -> (Result_12) query;
  list_catalogs : (opt nat64) -> (vec Catalog) query;
  open_checkout : (OpenCheckout) -> (Result_13);
  prepare_account_subscription : (text, Beneficiary, text, blob) -> (Result_21);
  process_checkout_transfer : (blob) -> (Result_22);
  promo_stats : () -> (vec PromoCount) query;
  // Publish a reference price observed now; the price authority calls this routinely.
  publish_settlement_price : (principal, nat, nat64) -> (Result_23);
  quote_checkout : (BillingOffer, principal, Account) -> (Result_24);
  // Replicated response used by the pinned user home during exact approval.
  read_integration_configuration : (text, opt text) -> (Result_25);
  // Safe progress can be advanced without revealing the payer or private bill.
  reconcile_checkout : (blob) -> (Result_5);
  reconcile_checkout_transfer : (blob, CashBlock) -> (Result_22);
  refresh_catalog : () -> (Catalog);
  refresh_entitlement : (Beneficiary) -> (Result_1);
  // Register or replace an app at the next config version. Every listed product
  // must already be registered.
  register_integration_app : (AppRegistration) -> (Result);
  // Register or replace a product at the next config version.
  register_integration_product : (ProductRegistration) -> (Result);
  // Register a settlement ledger or replace its non-price terms. Price
  // observations come from `publish_settlement_price`.
  register_settlement_asset : (SettlementAsset) -> (Result);
  release_product_billing : (ProductAuthorizationRequest) -> (Result);
  reserve_product_billing : (ProductAuthorizationRequest, nat64) -> (Result);
  // The recipient may reissue a definitely rejected leg with a fresh ledger timestamp,
  // keeping its fee or adopting the ledger's expected fee within the original cap.
  revise_checkout_transfer_fee : (blob, nat) -> (Result_10);
  revoke_promo_grant : (blob) -> (Result_3);
  // Announce a catalog at least 7 days ahead. With effective_at_ms = 0,
  // apply a limits-only increase now, preserving prices, terms and weights.
  schedule_policy : (Catalog) -> (Result);
  // Pause or resume new cash checkouts; reconciliation, refunds, lease
  // refresh and expiry continue.
  set_admission_pause : (bool) -> (Result);
  set_app_store_config : (AppStoreConfig) -> (Result);
  set_google_play_config : (GooglePlayConfig) -> (Result);
  set_promo_config : (PromoConfig) -> (Result);
  set_settlement_price_authority : (principal) -> (Result);
  settlement_assets : () -> (vec SettlementAssetView) query;
  // Bounded maintenance; funds, original-source refunds and idempotency survive archival.
  sweep_checkout_history : () -> (CheckoutHistorySweep);
  validate_admin_add_user_home : (principal) -> (Result_26) query;
  validate_admin_set_limits : (CommerceLimits) -> (Result_26) query;
  validate_publish_settlement_price : (principal, nat, nat64) -> (
      Result_26,
    ) query;
  validate_register_integration_app : (AppRegistration) -> (Result_26) query;
  validate_register_integration_product : (ProductRegistration) -> (
      Result_26,
    ) query;
  validate_register_settlement_asset : (SettlementAsset) -> (Result_26) query;
  validate_schedule_policy : (Catalog) -> (Result_26) query;
  validate_set_admission_pause : (bool) -> (Result_26) query;
  validate_set_app_store_config : (AppStoreConfig) -> (Result_26) query;
  validate_set_google_play_config : (GooglePlayConfig) -> (Result_26) query;
  validate_set_promo_config : (PromoConfig) -> (Result_26) query;
  validate_set_settlement_price_authority : (principal) -> (Result_26) query;
  validate_verify_settlement_asset : (principal, opt nat) -> (Result_26) query;
  verify_billing_offer : (BillingOffer) -> (Result);
  // Check the ledger's live decimals, fee, standards and, outside Local, one
  // real transfer block before quotes may use it.
  verify_settlement_asset : (principal, opt nat) -> (Result);
}
