// [Account](https://github.com/dfinity/ICRC-1/blob/main/standards/ICRC-3/README.md#value)
// representation of ledgers supporting the ICRC-1 standard.
type Account = record { owner : principal; subaccount : opt blob };
// One activation.
type ActivationOrder = record {
  // Progress.
  status : ActivationStatus;
  // Creating member.
  spec : WalletSpec;
  // Paid quote.
  quote : ActivationQuote;
  // Last change.
  updated_at_ms : nat64;
  // Whether the payment moved to the hub's revenue.
  collected : bool;
  // Created wallet.
  wallet : opt principal;
};
// Activation terms before a quote is stored: the price, version and what
// each plan still allows. The account's plan and the ledger fee are read by
// the client, which asks for an authoritative quote only when it may create.
type ActivationPreview = record {
  // Version installed.
  version : nat32;
  // ICP ledger whose fee the payer adds.
  icp_ledger : principal;
  // Remaining wallets by plan; plans not listed have none.
  plans : vec PlanAvailability;
  // Price in ICP e8s.
  price_e8s : nat64;
  // Cycles given to the wallet.
  cycles_to_wallet : nat;
};
// Activation terms for one account.
type ActivationQuote = record {
  // Creating account.
  account_id : blob;
  // Base plan read from commerce.
  plan : PlanId;
  // Account to pay into.
  deposit : Account;
  // Version installed.
  version : nat32;
  // ICP ledger fee the payer adds.
  ledger_fee_e8s : nat64;
  // Issue time.
  issued_at_ms : nat64;
  // Quote identity.
  quote_id : blob;
  // Wallets the account may still create, this one included.
  remaining : nat32;
  // Paying and calling Principal.
  payer : principal;
  // Price in ICP e8s.
  price_e8s : nat64;
  // Cycles given to the wallet.
  cycles_to_wallet : nat;
  // Exclusive deadline for `create_wallet`.
  expires_at_ms : nat64;
};
// Progress of an activation.
type ActivationStatus = variant {
  // Canister creation failed; the payment may be refunded.
  Failed : text;
  // Payment returned.
  Refunded : record {
    // ICP ledger block.
    block : nat64;
  };
  // Payment and approval verified.
  Paid;
  // Code installed; the wallet is live.
  Ready;
  // Canister created.
  Created;
};
// Approved dMsg account and product beneficiary are deliberately separate.
type ApplicationApproval = record {
  // Exact service allowed to consume this approval.
  "service" : principal;
  // Economic actor, distinct from both account IDs and payer accounts.
  actor : principal;
  // Product-defined rights recipient; no inferred AccountId conversion.
  beneficiary : Beneficiary;
  // Exact application configuration revision.
  app_config_version : nat64;
  // Browser origin, verified by the dMsg client.
  origin : text;
  // Complete cash/PANDA quotation or application action digest.
  action_digest : blob;
  // Idempotency identifier.
  operation_id : blob;
  // dMsg account whose device approves this action.
  approving_account : blob;
  // Integration version.
  version : nat16;
  // Registered application.
  app_id : text;
  // Fresh challenge.
  nonce : blob;
  // Deployment separation.
  environment : Environment;
  // Purpose-separated authorization.
  purpose : ApprovalPurpose;
  // Exclusive validity deadline in Unix milliseconds.
  expires_at_ms : nat64;
};
// Exact purpose for account approval, distinct from product authorization.
type ApprovalPurpose = variant {
  // Join a team wallet and bind the actor Principal; the service is the wallet.
  WalletJoin;
  // Create a team wallet; the service is the wallet hub.
  WalletCreate;
  // Cash order approval.
  CashCheckout;
  // Decide on a team wallet proposal; the service is the wallet.
  WalletProposal;
  // Full subscription waiver approval.
  PandaSubscription;
};
// Asset identity; amounts and limits are in its native base units.
type AssetKey = variant {
  // Bitcoin.
  Btc;
  // The native coin (`token = None`) or an ERC-20 token of an EVM chain.
  Evm : record {
    // ERC-20 contract.
    token : opt blob;
    // EIP-155 chain ID.
    chain_id : nat64;
  };
  // ICP on the ICP ledger.
  Icp;
  // SOL (`mint = None`) or an SPL token.
  Sol : record {
    // SPL token mint.
    mint : opt blob;
  };
  // An ICRC-1 ledger, such as ckBTC, ckUSDC or PANDA.
  Icrc : principal;
};
// Daily ceiling of an asset; amounts above it need every Approver.
type AssetLimit = record {
  // Asset.
  asset : AssetKey;
  // Rolling 24-hour amount.
  amount : nat;
};
// Product, authority and opaque subject binding; decoding does not establish control.
type Beneficiary = record {
  // Product identifier within this protocol.
  product_id : text;
  // Canister authoritative for the beneficiary subject.
  authority_canister : principal;
  // Opaque subject bytes in the registered schema.
  subject_bytes : blob;
  // Registered schema identifying how to interpret subject_bytes.
  subject_schema : text;
};
// Bitcoin network of a deployment.
type BtcNetwork = variant {
  // `bc` addresses.
  Mainnet;
  // `bcrt` addresses.
  Regtest;
  // `tb` addresses (testnet4 and signet).
  Testnet;
};
// Request to create a paid wallet.
type CreateWallet = record {
  // The creator's device approval request ID.
  approval_id : blob;
  // The wallet.
  spec : WalletSpec;
  // Device-approved terms: purpose `WalletCreate`, service the hub,
  // `action_digest = activation_digest(quote, spec)`.
  approval : ApplicationApproval;
  // Paid quote.
  quote_id : blob;
};
// Deployment domain used to separate identities and key derivation.
type Environment = variant {
  // Local development deployment.
  Local;
  // Production deployment with pinned chain-key configuration.
  Production;
  // Pre-production deployment domain.
  Staging;
};
// Application errors returned by dMsg canisters and protocol helpers.
// Transport failures and Candid decoding failures are separate from this enum.
type Error = variant {
  // Required legacy key material is unavailable.
  MigrationKeyUnavailable;
  // Legacy business writes are frozen.
  LegacyWriteDisabled;
  // A supplied field or combination is invalid; carries a diagnostic.
  InvalidInput : text;
  // Another accepted operation owns the same product interval.
  IntervalReserved;
  // A neuron still supports a committed or pending product application.
  NeuronOccupied;
  // A new content root must be committed before writes can resume.
  RekeyRequired;
  // Expected version/generation differs from current state; reread before preparing a new approval.
  VersionConflict;
  // Execution may have occurred; reconcile the original request instead of creating another.
  ExecutionUnknown;
  // A digest, signature, proof or accounting invariant failed validation.
  IntegrityFailed;
  // Account-ID timestamp cannot fit the generator format.
  IdTimestampOutOfRange;
  // The requested record does not exist.
  NotFound;
  // The approved fee or available fee reserve cannot support the transfer.
  FeeBlocked;
  // The device is missing, revoked or not approved for this operation.
  DeviceNotApproved;
  // Sensitive operations are locked by account state or policy.
  Locked;
  // The source benefit is closing and cannot issue new leases.
  MembershipClosing;
  // Required recovery setup/confirmation has not completed.
  RecoveryIncomplete;
  // Account-ID counter space is exhausted for this timestamp.
  IdCapacityExceeded;
  // Approval or policy evidence refers to an outdated security state.
  PolicyStale;
  // Persisted account-ID allocator state does not match its configured namespace.
  IdGeneratorStateConflict;
  // An operation ID was reused with different parameters.
  IdempotencyConflict;
  // The profile, algorithm or protocol version is unsupported.
  UnsupportedProtocol;
  // A required service or resource is unavailable; carries a diagnostic.
  Unavailable : text;
  // Commercial qualification is temporarily unverifiable or its lease expired.
  MembershipStale;
  // Caller, role or capability does not authorize this operation.
  Forbidden;
  // Retained output is no longer available; this does not authorize replay.
  ResultExpired;
  // The applicable deadline has passed.
  Expired;
  // The subject is known to be ineligible for the requested benefit.
  MembershipIneligible;
  // An execution, cycle, storage or admission limit was exceeded.
  QuotaExceeded;
  // An authenticated and appropriately bound caller is required.
  AuthRequired;
  // The operation is not yet complete; query/retry the same operation as appropriate.
  Pending;
};
// Hub deployment.
type HubInit = record {
  // Cycles minting canister.
  cmc : principal;
  // Account receiving activation revenue.
  revenue : Account;
  // Pricing and quotas.
  pricing : HubPricing;
  // ICP ledger.
  icp_ledger : principal;
  // Account issuer namespace.
  issuer_namespace : text;
  // Bitcoin network given to wallets.
  btc_network : BtcNetwork;
  // Chain-key name given to wallets.
  key_name : text;
  // Deployment domain.
  environment : Environment;
  // Commerce canister serving entitlements.
  commerce : principal;
  // SNS governance.
  governance : principal;
  // User homes, append-only.
  user_homes : vec principal;
};
// Activation price and quotas.
type HubPricing = record {
  // Part of each price converted to cycles for the hub, in e8s.
  cycles_share_e8s : nat64;
  // Activation price in ICP e8s.
  price_e8s : nat64;
  // Wallets per plan; plans not listed get none.
  quotas : vec PlanQuota;
  // Cycles given to each new wallet.
  cycles_to_wallet : nat;
  // Stops new quotes and creations.
  paused : bool;
};
// Hub counters.
type HubStats = record {
  // Ready activations whose payment is not yet revenue.
  uncollected : nat64;
  // Activations recorded.
  orders : nat64;
  // Cycle balance.
  cycles : nat;
  // Wallets created.
  wallets : nat64;
  // Version new wallets get.
  current_version : opt nat32;
  // Registered versions.
  versions : nat32;
};
// A wallet member, one of the team: a dMsg account or a Principal.
type MemberId = variant {
  // A dMsg account; it approves with device approvals its user home verifies.
  Account : blob;
  // A Principal calling in person.
  Principal : principal;
};
// A member as proposed.
type MemberInput = record {
  // Member identity.
  id : MemberId;
  // Role.
  role : Role;
  // Agent IDs allowed to propose on this member's behalf.
  agent_ids : vec text;
  // Display label, at most 64 bytes.
  label : text;
};
// Wallets an account may still create on one plan.
type PlanAvailability = record {
  // Plan.
  plan : PlanId;
  // Wallets left, this one included.
  remaining : nat32;
};
// Base resource tier; it grants no account or cryptographic permissions.
type PlanId = variant {
  // Max base tier.
  Max;
  // Pro base tier.
  Pro;
  // Free base tier.
  Free;
  // Plus base tier.
  Plus;
};
// Wallets an account may create per base plan.
type PlanQuota = record {
  // Plan.
  plan : PlanId;
  // Wallets.
  wallets : nat32;
};
// The wallet's rules. Every change increases `version`, and open proposals
// made under an older version can no longer pass.
type Policy = record {
  // Whether cosigners must be declared hardware keys.
  hardware_cosigners : bool;
  // Amount bands per asset, ascending by `up_to`.
  tiers : vec Tier;
  // Lifetime of an unexecuted proposal.
  proposal_ttl_ms : nat64;
  // Threshold signatures per UTC day.
  daily_signatures : nat32;
  // Admin approvals for admin proposals.
  admin_threshold : nat8;
  // Canisters a canister-call proposal may target.
  call_targets : vec principal;
  // Default Approver approvals for spending without a matching tier.
  approver_threshold : nat8;
  // Whether anyone may read the wallet, not only members.
  public : bool;
  // Monotonic version; a proposal fixes the version it was made under.
  version : nat64;
  // EVM chain IDs the wallet may sign for.
  evm_chains : vec nat64;
  // Delay of an Unfreeze proposal.
  unfreeze_delay_ms : nat64;
  // Time a new address-book entry waits before `book_only` tiers accept it.
  address_book_cooldown_ms : nat64;
  // Daily ceilings.
  daily_limits : vec AssetLimit;
  // Assets the wallet may send; empty means receive only.
  spendable_assets : vec AssetKey;
  // Automatic cycles top-up.
  refuel : opt RefuelRule;
};
// Cycles top-up from the wallet's own ICP.
type RefuelRule = record {
  // ICP address paying the top-up.
  from : nat32;
  // Top-ups per UTC day.
  max_per_day : nat8;
  // ICP sent to the cycles minting canister per top-up.
  icp_e8s : nat64;
  // Top up when the cycle balance is below this.
  min_cycles : nat;
};
type Result = variant { Ok; Err : Error };
type Result_1 = variant { Ok : WalletVersion; Err : Error };
type Result_2 = variant { Ok : nat64; Err : Error };
type Result_3 = variant { Ok : ActivationOrder; Err : Error };
type Result_4 = variant { Ok : WalletRecord; Err : Error };
type Result_5 = variant { Ok : ActivationQuote; Err : Error };
type Result_6 = variant { Ok : ActivationPreview; Err : Error };
type Result_7 = variant { Ok : StagedModule; Err : Error };
type Result_8 = variant { Ok : text; Err : text };
type Result_9 = variant { Ok : WalletHealth; Err : Error };
// What a member may do. Roles are ordered: each includes the ones after it
// except Recovery, which only proposes membership changes.
type Role = variant {
  // Reads the wallet.
  Viewer;
  // Approves and vetoes spending proposals, freezes the wallet.
  Approver;
  // Proposes only membership changes, with a seven-day delay; its approvals never count.
  Recovery;
  // Proposes and executes; its approvals do not count.
  Proposer;
  // Approves admin proposals (policy, members, cosigners, code) and everything below.
  Admin;
};
// Wasm module staged for registration.
type StagedModule = record {
  // Bytes uploaded so far.
  size : nat64;
  // SHA-256 of those bytes.
  module_hash : blob;
};
// Approval requirement of one asset amount band.
type Tier = record {
  // Delay after the last approval during which an Approver may veto.
  delay_ms : nat64;
  // Asset.
  asset : AssetKey;
  // Whether destinations must be address-book entries past their cooldown.
  book_only : bool;
  // Inclusive upper bound of the rolling 24-hour amount, proposal included.
  up_to : nat;
  // Approver approvals required.
  approvals : nat8;
};
// Resource state of a wallet canister, read by its controller, the hub.
type WalletHealth = record {
  // Memory in bytes.
  memory_bytes : nat;
  // Cycle balance.
  cycles : nat;
  // Cycles burned per day while idle.
  idle_cycles_per_day : nat;
  // Whether the canister runs.
  running : bool;
};
// The hub's record of a wallet.
type WalletRecord = record {
  // Creating account.
  creator : blob;
  // Members as the wallet last reported them.
  members : vec MemberId;
  // Display name at creation.
  name : text;
  // Whether the controllers were removed.
  locked : bool;
  // Creation time.
  created_at_ms : nat64;
  // Installed version.
  version : nat32;
  // Wallet canister.
  wallet : principal;
};
// The wallet a quote creates.
type WalletSpec = record {
  // Members besides the creator.
  members : vec MemberInput;
  // Display name, 1..=64 bytes.
  name : text;
  // Encrypted channel following wallet events.
  channel_hint : opt text;
  // Initial policy, version 1.
  policy : Policy;
};
// A registered wallet module.
type WalletVersion = record {
  // Registration time.
  registered_at_ms : nat64;
  // Module bytes.
  size : nat64;
  // Version number, from 1.
  version : nat32;
  // Release notes.
  notes : text;
  // SHA-256 of the module.
  module_hash : blob;
  // Whether new wallets stop using it; installed wallets may still accept it.
  retired : bool;
};
service : (HubInit) -> {
  admin_add_user_home : (principal) -> (Result);
  // Register the staged module as the next version new wallets get. The
  // staging must stay untouched until the proposal executes.
  admin_register_version : (blob, text) -> (Result_1);
  // Delete a retired version and its module, freeing a registration slot;
  // wallets can no longer install it.
  admin_remove_version : (nat32) -> (Result);
  // Stop giving a version to new wallets; installed wallets keep it and may
  // still accept it.
  admin_retire_version : (nat32) -> (Result);
  admin_set_pricing : (HubPricing) -> (Result);
  admin_set_revenue : (Account) -> (Result);
  admin_set_uploader : (opt principal) -> (Result);
  // Return the deposit of a failed activation, or of a quote that expired
  // without one, less the ledger fee, to `to`: an account outside the hub
  // that the quote's caller names, such as the payer's. The first claim
  // fixes the account and later ones finish that refund; returns the ledger
  // block.
  claim_activation_refund : (blob, Account) -> (Result_2);
  clear_wasm_staging : () -> (Result);
  // Move a ready activation's payment: the cycles share to the CMC for the
  // hub's cycles, the rest to the revenue account. Anyone may call it;
  // `collectable_activations` lists the activations waiting for it.
  collect_revenue : (blob) -> (Result_3);
  // Quote IDs of ready activations whose payment is not yet revenue, after
  // `after`, at most 100. Maintenance collects each with `collect_revenue`.
  collectable_activations : (opt blob, nat16) -> (vec blob) query;
  // Create the wallet of a paid quote, or continue its interrupted
  // activation. The creator's device approval names the quote and the exact
  // wallet; the payment must be in the deposit.
  create_wallet : (CreateWallet) -> (Result_3);
  get_hub_config : () -> (HubInit) query;
  get_order : (blob) -> (opt ActivationOrder) query;
  get_quote : (blob) -> (opt ActivationQuote) query;
  get_user_homes : () -> (vec principal) query;
  get_wallet_record : (principal) -> (opt WalletRecord) query;
  hub_stats : () -> (HubStats) query;
  list_versions : () -> (vec WalletVersion) query;
  // Wallet records by canister ID after `after`, at most 100, for
  // maintenance such as cycles top-ups.
  list_wallets : (opt principal, nat16) -> (vec WalletRecord) query;
  list_wallets_of : (MemberId) -> (vec WalletRecord) query;
  // Remove every controller of a wallet that accepted locking its code.
  lock_wallet : (principal) -> (Result_4);
  // Price and deposit account for the calling payer to create a wallet for
  // `account_id`; `remaining` shows what the account's plan still allows.
  quote_activation : (blob) -> (Result_5);
  // Activation terms this account would get now, without storing a quote: the
  // price, version and remaining wallets by plan. The client reads its plan and
  // the ledger fee itself, so this is a local query and a person sees a plan's
  // limit before asking for a quote.
  quote_activation_preview : (blob) -> (Result_6) query;
  // Continue an activation after an interrupted creation or install.
  reconcile_activation : (blob) -> (Result_3);
  staged_wasm : () -> (StagedModule) query;
  // Refresh the member index from the wallet. Anyone may call it.
  sync_wallet : (principal) -> (Result_4);
  // Install the version a wallet accepted. Anyone may call it.
  upgrade_wallet : (principal) -> (Result_4);
  // Append bytes to the module staged for registration.
  upload_wasm_chunk : (blob) -> (Result_7);
  validate_admin_add_user_home : (principal) -> (Result_8) query;
  validate_admin_register_version : (blob, text) -> (Result_8) query;
  validate_admin_remove_version : (nat32) -> (Result_8) query;
  validate_admin_retire_version : (nat32) -> (Result_8) query;
  validate_admin_set_pricing : (HubPricing) -> (Result_8) query;
  validate_admin_set_revenue : (Account) -> (Result_8) query;
  validate_admin_set_uploader : (opt principal) -> (Result_8) query;
  wallet_health : (principal) -> (Result_9);
}
