type CanisterArgs = variant { Upgrade : UpgradeArgs; Init : InitArgs };
// A delegation from one key to another.
// 
// If key A signs a delegation containing key B, then key B may be used to
// authenticate as key A's corresponding principal(s).
type Delegation = record {
  // The kinds of requests this delegation permits.
  permissions : opt DelegationPermissions;
  // The delegated-to key.
  pubkey : blob;
  // If present, this delegation only applies to requests sent to one of these canisters.
  targets : opt vec principal;
  // A nanosecond timestamp after which this delegation is no longer valid.
  expiration : nat64;
};
// The kinds of requests a [`Delegation`] permits.
type DelegationPermissions = variant {
  // All request types are permitted.
  all;
  // Only query calls and `read_state` requests are permitted.
  queries;
};
type InitArgs = record {
  session_expires_in_ms : nat64;
  governance_canister : opt principal;
};
type Result = variant { Ok; Err : text };
type Result_1 = variant { Ok : SignedDelegation; Err : text };
type Result_2 = variant { Ok : text; Err : text };
type Result_3 = variant { Ok : StateInfo; Err : text };
type Result_4 = variant { Ok : blob; Err : text };
type Result_5 = variant { Ok : SignInResponse; Err : text };
type Result_6 = variant { Ok : principal; Err : text };
type SignInResponse = record {
  // The user canister public key. This key is used to derive the user principal.
  user_key : blob;
  // The seed component used to derive the user key.
  seed : blob;
  // The session expiration time in nanoseconds since the UNIX epoch. This is the time at which
  // the delegation will no longer be valid.
  expiration : nat64;
};
// SignedDelegation is a [`Delegation`] that has been signed by an [`Identity`](https://docs.rs/ic-agent/latest/ic_agent/trait.Identity.html).
type SignedDelegation = record {
  // The signature for the delegation.
  signature : blob;
  // The signed delegation.
  delegation : Delegation;
};
type StateInfo = record {
  session_expires_in_ms : nat64;
  governance_canister : opt principal;
  statement : text;
  domains : vec record { text; text };
};
type UpgradeArgs = record {
  session_expires_in_ms : opt nat64;
  governance_canister : opt principal;
};
service : (opt CanisterArgs) -> {
  admin_remove_domain : (text) -> (Result);
  admin_update_domain : (text, text) -> (Result);
  admin_update_statement : (text) -> (Result);
  get_delegation : (blob, blob, nat64) -> (Result_1) query;
  get_sign_in_with_ethereum_message : (text, text, nat32, nat64) -> (
      Result_2,
    ) query;
  get_sign_in_with_solana_message : (text, text, nat64) -> (Result_2) query;
  info : () -> (Result_3) query;
  my_iv : () -> (Result_4) query;
  sign_in_with_ethereum : (
      text,
      text,
      nat32,
      nat64,
      text,
      blob,
      blob,
      blob,
    ) -> (Result_5);
  sign_in_with_solana : (text, text, nat64, text, blob, blob, blob) -> (
      Result_5,
    );
  validate_admin_remove_domain : (text) -> (Result_2);
  validate_admin_update_domain : (text, text) -> (Result_2);
  validate_admin_update_statement : (text) -> (Result_2);
  verify_envelope : (blob, opt principal, opt blob) -> (Result_6) query;
  whoami : () -> (Result_6) query;
}
