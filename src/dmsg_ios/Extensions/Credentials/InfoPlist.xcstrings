{
  "sourceLanguage": "en",
  "strings": {
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access the copies you explicitly exported from dMsg"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访问你明确从 dMsg 导出的副本"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accéder aux copies que vous avez exportées depuis dMsg"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceder a las copias que exportaste de dMsg"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к копиям, явно экспортированным из dMsg"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى النسخ التي صدّرتها صراحةً من dMsg"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訪問你明確從 dMsg 導出的副本"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "dMsg से आपके द्वारा स्पष्ट रूप से निर्यात की गई प्रतियों तक पहुँचें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses salinan yang Anda ekspor secara eksplisit dari dMsg"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesse as cópias que você exportou explicitamente de dMsg"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "dMsg から明示的にエクスポートしたコピーにアクセスします"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Greifen Sie auf die Kopien zu, die Sie explizit aus dMsg exportiert haben"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "dMsg에서 명시적으로 내보낸 복사본에 액세스하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi alle copie che hai esportato esplicitamente da dMsg"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "dMsg'dan açıkça dışa aktardığınız kopyalara erişin"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Truy cập các bản sao bạn đã xuất rõ ràng từ dMsg"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้าถึงสำเนาที่คุณส่งออกอย่างชัดเจนจาก dMsg"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzyskaj dostęp do kopii, które jawnie wyeksportowałeś z dMsg"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-access ang mga kopyang tahasan mong na-export mula sa dMsg"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses salinan yang anda eksport secara eksplisit daripada dMsg"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি স্পষ্টভাবে dMsg থেকে রপ্তানি করা কপিগুলি অ্যাক্সেস করুন৷"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang tot de kopieën die je expliciet hebt geëxporteerd vanuit dMsg"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "dMsg سے آپ نے واضح طور پر برآمد کی گئی کاپیوں تک رسائی حاصل کریں"
          }
        }
      }
    }
  },
  "version": "1.0"
}
