{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "comment": "Bundle display name",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "dMsg"
          }
        }
      },
      "shouldTranslate": false
    },
    "CFBundleName": {
      "comment": "Bundle name",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "dMsg"
          }
        }
      },
      "shouldTranslate": false
    },
    "NSCameraUsageDescription": {
      "comment": "Privacy - Camera Usage Description",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مسح رموز QR لمراجعتها، والتقاط صور وفيديوهات تُحفظ مشفّرة في الملفات."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan QR codes for review, and take photos and videos that are saved encrypted in Files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanear códigos QR para revisarlos y hacer fotos y vídeos que se guardan cifrados en Archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanner des codes QR pour vérification, et prendre des photos et des vidéos enregistrées chiffrées dans Fichiers."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканирование QR-кодов для проверки, а также съёмка фото и видео, которые сохраняются в зашифрованном виде в разделе «Файлы»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描二维码以便核对，以及拍摄照片和视频并加密保存到“文件”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描 QR 碼以便核對，以及拍攝照片和影片並加密儲存到「檔案」。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समीक्षा के लिए QR कोड स्कैन करें, और ऐसे फ़ोटो और वीडियो लें जो फ़ाइलें में एन्क्रिप्ट होकर सहेजे जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindai kode QR untuk ditinjau, serta ambil foto dan video yang disimpan terenkripsi di Berkas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanear códigos QR para revisão e tirar fotos e gravar vídeos que ficam salvos com criptografia em Arquivos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認のためにQRコードをスキャンし、ファイルに暗号化して保存する写真や動画を撮影します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "QR-Codes zur Prüfung scannen sowie Fotos und Videos aufnehmen, die verschlüsselt in „Dateien“ gespeichert werden."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인을 위해 QR 코드를 스캔하고, 파일에 암호화되어 저장되는 사진과 비디오를 촬영합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona codici QR per verificarli e scatta foto e video salvati cifrati in File."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İncelemek için QR kodlarını tarayın, Dosyalar’a şifreli olarak kaydedilen fotoğraf ve videolar çekin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quét mã QR để kiểm tra, đồng thời chụp ảnh và quay video được mã hóa và lưu trong Tệp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สแกนคิวอาร์โค้ดเพื่อตรวจสอบ และถ่ายรูปและวิดีโอที่จะถูกเข้ารหัสและบันทึกไว้ในไฟล์"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanowanie kodów QR do sprawdzenia oraz robienie zdjęć i nagrywanie filmów zapisywanych w postaci zaszyfrowanej w Plikach."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-scan ng mga QR code para suriin, at kumuha ng mga larawan at video na naka-encrypt na sine-save sa Mga file."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Imbas kod QR untuk semakan, dan ambil foto serta video yang disimpan tersulit dalam Fail."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পর্যালোচনার জন্য QR কোড স্ক্যান করুন, এবং ছবি ও ভিডিও তুলুন যা ফাইলে এনক্রিপ্ট করে সংরক্ষিত হয়।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "QR-codes scannen om te controleren, en foto’s en video’s maken die versleuteld worden bewaard in Bestanden."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جائزے کے لیے QR کوڈ اسکین کریں، اور ایسی تصاویر اور ویڈیوز بنائیں جو فائلوں میں خفیہ کاری کے ساتھ محفوظ ہوتی ہیں۔"
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "comment": "Privacy - Face ID Usage Description",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح مساحة عملك الخاصة وأكّد الطلب الذي راجعته."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock your private workspace and confirm the request you reviewed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea tu espacio privado y confirma la solicitud revisada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouillez votre espace privé et confirmez la demande examinée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокируйте личное пространство и подтвердите проверенный запрос."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁你的私密工作区，并确认你已核对的请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解鎖你的私密工作區，並確認你已核對的請求。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने निजी कार्यक्षेत्र को अनलॉक करें और आपके द्वारा समीक्षा किए गए अनुरोध की पुष्टि करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka kunci ruang kerja pribadi Anda dan konfirmasikan permintaan yang Anda tinjau."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie seu espaço de trabalho privado e confirme a solicitação que você analisou."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライベートワークスペースのロックを解除し、内容を確認したリクエストを承認します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entsperren Sie Ihren privaten Arbeitsbereich und bestätigen Sie die von Ihnen überprüfte Anfrage."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비공개 작업 공간을 잠금 해제하고 검토한 요청을 확인하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca il tuo spazio di lavoro privato e conferma la richiesta che hai esaminato."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel çalışma alanınızın kilidini açın ve incelediğiniz isteği onaylayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở khóa không gian làm việc riêng tư của bạn và xác nhận yêu cầu bạn đã xem xét."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปลดล็อกพื้นที่ทำงานส่วนตัวของคุณและยืนยันคำขอที่คุณตรวจสอบ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odblokuj swoją prywatną przestrzeń do pracy i potwierdź przejrzaną prośbę."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-unlock ang iyong pribadong workspace at kumpirmahin ang kahilingang iyong nasuri."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka kunci ruang kerja peribadi anda dan sahkan permintaan yang anda semak."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ব্যক্তিগত ওয়ার্কস্পেস আনলক করুন এবং আপনার পর্যালোচনা করা অনুরোধ নিশ্চিত করুন।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontgrendel je privéwerkruimte en bevestig het verzoek dat je hebt beoordeeld."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی نجی ورک اسپیس کو غیر مقفل کریں اور اس درخواست کی تصدیق کریں جس کا آپ نے جائزہ لیا ہے۔"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "comment": "Privacy - Local Network Usage Description",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث عن جهازك الآخر على هذه الشبكة لنقل ملفاتك إليه مباشرةً بتشفير تام بين الطرفين."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find your other device on this network to move your files to it directly, end-to-end encrypted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra tu otro dispositivo en esta red para transferirle tus archivos directamente, con cifrado de extremo a extremo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez votre autre appareil sur ce réseau pour y transférer vos fichiers directement, chiffrés de bout en bout."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найдите другое своё устройство в этой сети, чтобы перенести на него файлы напрямую со сквозным шифрованием."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此网络中找到你的另一台设备，以端到端加密直接向它传输文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在此網路中找到你的另一台設備，以端到端加密直接向它傳輸檔案。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस नेटवर्क पर अपना दूसरा डिवाइस ढूँढें और अपनी फ़ाइलें सीधे उस पर ले जाएँ, एंड-टू-एंड एन्क्रिप्टेड।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Temukan perangkat Anda yang lain di jaringan ini untuk memindahkan file langsung ke sana, terenkripsi ujung ke ujung."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre seu outro dispositivo nesta rede para transferir seus arquivos diretamente para ele, com criptografia de ponta a ponta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このネットワーク上のもう一台のデバイスを見つけ、ファイルをエンドツーエンド暗号化で直接移します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finden Sie Ihr anderes Gerät in diesem Netzwerk, um Ihre Dateien direkt und Ende-zu-Ende-verschlüsselt darauf zu übertragen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 네트워크에서 다른 기기를 찾아 파일을 종단 간 암호화로 직접 옮깁니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova l’altro tuo dispositivo su questa rete per trasferirvi i file direttamente, con crittografia end-to-end."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalarınızı uçtan uca şifreli olarak doğrudan taşımak için bu ağdaki diğer cihazınızı bulun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm thiết bị khác của bạn trên mạng này để chuyển tệp sang đó trực tiếp, được mã hóa đầu cuối."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค้นหาอุปกรณ์อีกเครื่องของคุณในเครือข่ายนี้เพื่อย้ายไฟล์ไปยังเครื่องนั้นโดยตรง โดยเข้ารหัสตั้งแต่ต้นทางถึงปลายทาง"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znajdź swoje drugie urządzenie w tej sieci, aby przenieść na nie pliki bezpośrednio, z szyfrowaniem end-to-end."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanapin ang iyong ibang device sa network na ito para direktang ilipat dito ang iyong mga file, naka-encrypt end-to-end."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cari peranti anda yang lain pada rangkaian ini untuk memindahkan fail anda terus kepadanya, disulitkan hujung ke hujung."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই নেটওয়ার্কে আপনার অন্য ডিভাইসটি খুঁজুন এবং আপনার ফাইলগুলো সরাসরি সেখানে সরান, এন্ড-টু-এন্ড এনক্রিপ্টেড।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vind je andere apparaat op dit netwerk om je bestanden er rechtstreeks naartoe te zetten, end-to-end versleuteld."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی فائلیں براہِ راست اینڈ ٹو اینڈ انکرپٹڈ منتقل کرنے کے لیے اس نیٹ ورک پر اپنا دوسرا آلہ تلاش کریں۔"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "Privacy - Microphone Usage Description",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الصوت لمقاطع الفيديو التي تصورها. تُحفظ مشفّرة في الملفات."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record sound for the videos you take. They are saved encrypted in Files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabar el sonido de los vídeos que haces. Se guardan cifrados en Archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer le son de vos vidéos. Elles sont enregistrées chiffrées dans Fichiers."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись звука для снимаемых видео. Они сохраняются в зашифрованном виде в разделе «Файлы»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍摄视频时录制声音。视频会加密保存到“文件”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拍攝影片時錄製聲音。影片會加密儲存到「檔案」。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके वीडियो के लिए ध्वनि रिकॉर्ड करें। वे फ़ाइलें में एन्क्रिप्ट होकर सहेजे जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekam suara untuk video yang Anda ambil. Video disimpan terenkripsi di Berkas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravar o som dos vídeos que você faz. Eles ficam salvos com criptografia em Arquivos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "撮影する動画の音声を録音します。動画はファイルに暗号化して保存されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton für Ihre Videos aufnehmen. Sie werden verschlüsselt in „Dateien“ gespeichert."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "촬영하는 비디오의 소리를 녹음합니다. 비디오는 파일에 암호화되어 저장됩니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra l’audio dei video che giri. I video vengono salvati cifrati in File."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çektiğiniz videolar için ses kaydedin. Videolar Dosyalar’a şifreli olarak kaydedilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi âm cho video bạn quay. Video được mã hóa và lưu trong Tệp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกเสียงสำหรับวิดีโอที่คุณถ่าย วิดีโอจะถูกเข้ารหัสและบันทึกไว้ในไฟล์"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrywanie dźwięku do nagrywanych filmów. Są one zapisywane w postaci zaszyfrowanej w Plikach."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-record ng tunog para sa mga video na kinukuha mo. Naka-encrypt itong sine-save sa Mga file."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakam bunyi untuk video yang anda ambil. Video disimpan tersulit dalam Fail."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার তোলা ভিডিওর জন্য শব্দ রেকর্ড করুন। এগুলো ফাইলে এনক্রিপ্ট করে সংরক্ষিত হয়।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geluid opnemen bij de video’s die je maakt. Ze worden versleuteld bewaard in Bestanden."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی بنائی ہوئی ویڈیوز کے لیے آواز ریکارڈ کریں۔ یہ فائلوں میں خفیہ کاری کے ساتھ محفوظ ہوتی ہیں۔"
          }
        }
      }
    }
  },
  "version": "1.0"
}
