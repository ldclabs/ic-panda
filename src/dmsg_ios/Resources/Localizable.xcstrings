    "You are viewing an immutable historical version." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنت تعرض نسخة تاريخية ثابتة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are viewing an immutable historical version."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás viendo una versión histórica inmutable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous consultez une version historique immuable."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
