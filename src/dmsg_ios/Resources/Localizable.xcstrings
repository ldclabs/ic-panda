        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分源记录或属性不受支持。此处只导入所选字段，不导入归档附件、通行密钥和历史记录。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
