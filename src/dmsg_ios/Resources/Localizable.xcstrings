          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans cosignataire choisi, aucune politique de cosignature supplémentaire ne s’applique. Examinez toute la proposition avant d’approuver."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin cofirmantes seleccionados no se añade política de cofirma. Revisa toda la propuesta antes de aprobar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без выбранных соподписантов дополнительная политика совместной подписи не применяется. Проверьте всё предложение перед одобрением."
          }
        },
        "ar" : {
