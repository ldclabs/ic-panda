    "This profile is public. Do not include secrets or private contact information." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا الملف الشخصي عام. لا تضع فيه أسرارًا أو معلومات اتصال خاصة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This profile is public. Do not include secrets or private contact information."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este perfil es público. No incluyas secretos ni datos de contacto privados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce profil est public. N’y mettez pas de secrets ni de coordonnées privées."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот профиль общедоступен. Не включайте секреты или личные контактные данные."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
