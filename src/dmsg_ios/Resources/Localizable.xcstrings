        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إكمال العملية. يُرجى المحاولة مجددًا."
          }
        }
      }
    },
    "The operation was cancelled or is not permitted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作已取消，或当前没有权限。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation was cancelled or is not permitted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’opération a été annulée ou n’est pas autorisée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La operación se canceló o no está permitida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операция отменена или не разрешена."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُلغيت العملية أو أنها غير مسموحة."
          }
        }
      }
    },
    "The result is not confirmed. Reconcile this request before retrying.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果尚未确认。请核对原请求，不要重复提交。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result is not confirmed. Reconcile this request before retrying."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat n’est pas confirmé. Vérifiez cette demande avant de réessayer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resultado no está confirmado. Comprueba esta solicitud antes de volver a intentarlo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат не подтверждён. Проверьте исходный запрос перед повторной попыткой."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تتأكد النتيجة. تحقّق من الطلب الأصلي قبل إعادة المحاولة."
          }
        }
      }
    },
    "This creates a pending request. It does not authorize the device.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一步仅创建待审批请求，不会授权设备。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This creates a pending request. It does not authorize the device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci crée une demande en attente. Cela n’autorise pas l’appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto crea una solicitud pendiente. No autoriza el dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будет создан ожидающий запрос. Устройство не будет авторизовано."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي هذا إلى إنشاء طلب معلّق، ولا يفوّض الجهاز."
          }
        }
      }
    },
    "This device keeps its own encrypted workspace. Content that has not synced cannot be recovered from another device.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备保存独立的加密工作区，未同步内容无法从其他设备恢复。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device keeps its own encrypted workspace. Content that has not synced cannot be recovered from another device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil conserve son propre espace chiffré. Le contenu non synchronisé ne peut pas être récupéré depuis un autre appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo mantiene su propio espacio cifrado. El contenido no sincronizado no puede recuperarse desde otro dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это устройство хранит отдельное зашифрованное пространство. Несинхронизированные данные нельзя восстановить с другого устройства."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتفظ هذا الجهاز بمساحة عمل مشفّرة مستقلة. لا يمكن استرداد المحتوى غير المتزامن من جهاز آخر."
          }
        }
      }
    },
    "This device may receive your private content. The content root must be redistributed after approval.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备可能获得你的私密内容。批准后仍需完成内容根分发。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device may receive your private content. The content root must be redistributed after approval."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil peut recevoir votre contenu privé. La racine de chiffrement doit être redistribuée après l’approbation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo puede recibir tu contenido privado. La clave raíz de contenido debe redistribuirse tras la aprobación."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это устройство может получить ваши личные данные. После одобрения необходимо заново распределить корневой ключ содержимого."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يحصل هذا الجهاز على محتواك الخاص. يجب إعادة توزيع مفتاح جذر المحتوى بعد الموافقة."
          }
        }
      }
    },
