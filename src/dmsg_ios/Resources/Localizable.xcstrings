    "Removing a reference does not delete the file. Existing references are kept even when their files are missing on this device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removing a reference does not delete the file. Existing references are kept even when their files are missing on this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除引用不会删除文件。即使此设备上没有对应文件，现有引用也会保留。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirer une référence ne supprime pas le fichier. Les références existantes sont conservées même si leurs fichiers sont absents de cet appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitar una referencia no elimina el archivo. Las referencias existentes se conservan aunque sus archivos no estén en este dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаление ссылки не удаляет файл. Существующие ссылки сохраняются, даже если файлов нет на этом устройстве."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إزالة المرجع لا تحذف الملف. تُحفظ المراجع الموجودة حتى عندما تكون ملفاتها غير موجودة على هذا الجهاز."
          }
        }
      }
    },
