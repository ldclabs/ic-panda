    "Revocation stops new access after security state is refreshed and keys are rotated. Previously copied content cannot be recalled.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revocation stops new access after security state is refreshed and keys are rotated. Previously copied content cannot be recalled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安全状态更新并完成密钥轮换后，撤销会阻止新的访问。已复制的内容无法收回。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La révocation bloque les nouveaux accès après actualisation de l’état de sécurité et rotation des clés. Le contenu déjà copié ne peut pas être rappelé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La revocación impide nuevos accesos tras actualizar el estado de seguridad y rotar las claves. No se puede retirar el contenido ya copiado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отзыв прекращает новый доступ после обновления состояния безопасности и смены ключей. Уже скопированные данные отозвать нельзя."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمنع إلغاء التفويض أي وصول جديد بعد تحديث الحالة الأمنية وتدوير المفاتيح. لا يمكن استرجاع المحتوى الذي نُسخ سابقًا."
          }
        }
      }
    },
