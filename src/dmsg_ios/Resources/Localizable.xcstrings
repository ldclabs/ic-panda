    "Channel copies have no expiry, retrieval limit or recall. Recipients can keep independent copies.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Channel copies have no expiry, retrieval limit or recall. Recipients can keep independent copies."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "频道副本没有到期时间、取回次数限制，也无法收回。接收者可以保留独立副本。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les copies de canal n’ont ni expiration, ni limite de récupération, ni rappel. Les destinataires peuvent conserver des copies indépendantes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias del canal no caducan, no limitan las recuperaciones y no se pueden retirar. Los destinatarios pueden conservar copias independientes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У копий в канале нет срока действия, лимита получения или возможности изъятия. Получатели могут сохранять независимые копии."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نسخ القناة بلا انتهاء صلاحية أو حد للاسترجاع، ولا يمكن سحبها. يستطيع المستلمون الاحتفاظ بنسخ مستقلة."
          }
        }
      }
    },
