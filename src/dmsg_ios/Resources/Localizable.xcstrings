          "stringUnit": {
            "state": "translated",
            "value": "Нужно проверить состояние восстановления"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حالة الاسترداد تحتاج إلى تحقق"
          }
        }
      }
    },
    "Review the request and dispute it if it is not yours.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review the request and dispute it if it is not yours."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请审阅请求；如非本人发起，请提出异议。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez la demande et contestez-la si elle ne vient pas de vous."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa la solicitud e impúgnala si no es tuya."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте запрос и оспорьте его, если вы его не отправляли."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع الطلب واعترض عليه إذا لم تكن أنت من أرسله."
          }
        }
      }
    },
    "Unlock dMsg to review this request.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock dMsg to review this request."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁 dMsg 后审阅此请求。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouillez dMsg pour examiner cette demande."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea dMsg para revisar esta solicitud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокируйте dMsg, чтобы проверить запрос."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح قفل dMsg لمراجعة هذا الطلب."
          }
        }
      }
    },
    "The last verified observation is kept. Current status could not be confirmed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last verified observation is kept. Current status could not be confirmed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保留最近一次验证结果，当前状态尚无法确认。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dernière observation vérifiée est conservée. L’état actuel n’a pas pu être confirmé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conserva la última observación verificada. No se ha podido confirmar el estado actual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последнее проверенное наблюдение сохранено. Текущее состояние подтвердить не удалось."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الاحتفاظ بآخر ملاحظة متحقق منها. تعذّر تأكيد الحالة الحالية."
          }
        }
      }
    },
    "Review": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审阅"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Examiner"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверить"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مراجعة"
          }
        }
      }
    },
    "Check recovery status": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check recovery status"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查恢复状态"
          }
        },
        "fr": {
