    },
    "These are verified backups from your account's devices. Restore explicitly to keep a copy on this device." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه نسخ احتياطية تم التحقق منها من أجهزة حسابك. اختر الاستعادة صراحةً للاحتفاظ بنسخة على هذا الجهاز."
          }
        },
