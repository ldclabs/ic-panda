    "Choose exactly what this independent snapshot contains. Source edits will not change copies already sent.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose exactly what this independent snapshot contains. Source edits will not change copies already sent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逐项选择这份独立快照的内容。之后修改源条目不会改变已发送的副本。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez précisément le contenu de cet instantané indépendant. Modifier la source ne changera pas les copies déjà envoyées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige exactamente qué contiene esta instantánea independiente. Los cambios en el original no modificarán las copias ya enviadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите точное содержимое независимого снимка. Изменения оригинала не затронут уже отправленные копии."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر بدقة محتوى هذه اللقطة المستقلة. تعديل المصدر لن يغيّر النسخ المرسلة سابقًا."
          }
        }
      }
    },
