    "Selected OTP fields include the reusable seed, not just a current code.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected OTP fields include the reusable seed, not just a current code."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选一次性密码字段包含可重复使用的种子密钥，不仅是当前验证码。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les champs OTP sélectionnés incluent la clé secrète réutilisable, pas seulement le code actuel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los campos OTP seleccionados incluyen la clave secreta reutilizable, no solo el código actual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранные поля OTP содержат многоразовый секретный ключ, а не только текущий код."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتضمن حقول OTP المحددة المفتاح السري القابل لإعادة الاستخدام، وليس الرمز الحالي فقط."
          }
        }
      }
    },
    "The local binding key is unavailable. Keep this workspace and review your recovery options before locking it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local binding key is unavailable. Keep this workspace and review your recovery options before locking it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机绑定钥匙不可用。请保留此工作区，并在锁定前检查恢复方式。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé de liaison locale est indisponible. Conservez cet espace et vérifiez vos options de récupération avant de le verrouiller."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave de vinculación local no está disponible. Conserve este espacio y revise las opciones de recuperación antes de bloquearlo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ локальной привязки недоступен. Сохраните рабочую область и проверьте способы восстановления перед блокировкой."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفتاح الربط المحلي غير متاح. احتفظ بمساحة العمل وراجع خيارات الاسترداد قبل قفلها."
          }
        }
      }
    },
    "A record or device key could not be verified. Your workspace has not been erased.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A record or device key could not be verified. Your workspace has not been erased."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证记录或设备钥匙。你的工作区并未被清除。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un enregistrement ou une clé de l’appareil n’a pas pu être vérifié. Votre espace de travail n’a pas été effacé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar un registro o una clave del dispositivo. Su espacio de trabajo no se ha borrado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить запись или ключ устройства. Рабочая область не удалена."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر التحقق من سجل أو مفتاح جهاز. لم يتم مسح مساحة عملك."
          }
        }
      }
    },
    "Preview downloads and verifies the package on this device and uses a download session. Choose the receiving device before continuing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview downloads and verifies the package on this device and uses a download session. Choose the receiving device before continuing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览会在本设备下载并验证秘密包，占用一次下载会话。请先选定接收设备再继续。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’aperçu télécharge et vérifie le paquet sur cet appareil et utilise une session de téléchargement. Choisissez l’appareil de réception avant de continuer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vista previa descarga y verifica el paquete en este dispositivo y utiliza una sesión de descarga. Elija el dispositivo receptor antes de continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предпросмотр загружает и проверяет пакет на этом устройстве, используя сеанс загрузки. Выберите принимающее устройство, прежде чем продолжить."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُنزّل المعاينة الحزمة وتتحقق منها على هذا الجهاز وتستخدم جلسة تنزيل. اختر جهاز الاستلام قبل المتابعة."
          }
        }
      }
    }
  },
  "version": "1.0"
}
