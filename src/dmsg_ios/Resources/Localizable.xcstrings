      }
    },
    "Anyone with the complete link and required password can retrieve it within its limits." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لأي شخص يملك الرابط الكامل وكلمة المرور المطلوبة استرجاع المحتوى ضمن الحدود المحددة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone with the complete link and required password can retrieve it within its limits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquiera con el enlace completo y la contraseña requerida puede recuperar el contenido dentro de sus límites."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute personne disposant du lien complet et du mot de passe requis peut récupérer le contenu dans les limites définies."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любой, у кого есть полная ссылка и необходимый пароль, может получить содержимое в пределах заданных ограничений."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "持有完整链接及所需密码的人，都可在限制范围内取回内容。"
          }
        }
      }
    },
