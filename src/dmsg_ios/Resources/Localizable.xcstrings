    "This requests an end to future retrieval. Already saved copies remain usable. An uncertain publication must still be reconciled.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This requests an end to future retrieval. Already saved copies remain usable. An uncertain publication must still be reconciled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会请求停止之后的内容取回。已保存的副本仍可使用；结果不确定的发布仍需对账。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela demande l’arrêt des récupérations futures. Les copies déjà enregistrées restent utilisables. Une publication incertaine doit toujours être vérifiée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto solicita detener las recuperaciones futuras. Las copias ya guardadas siguen siendo utilizables. Una publicación incierta aún debe comprobarse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будет запрошено прекращение дальнейшего получения данных. Уже сохранённые копии останутся доступны. Неизвестный результат публикации всё равно нужно проверить."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب هذا إيقاف عمليات الاسترجاع اللاحقة. تبقى النسخ المحفوظة قابلة للاستخدام، ويظل من الضروري التحقق من نتيجة أي نشر غير مؤكد."
          }
        }
      }
    },
