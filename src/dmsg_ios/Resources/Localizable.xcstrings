          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se elimina la copia seleccionada de la nube. Los archivos locales permanecen en sus dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seule la copie cloud sélectionnée sera supprimée. Les fichiers locaux restent sur leurs appareils."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
