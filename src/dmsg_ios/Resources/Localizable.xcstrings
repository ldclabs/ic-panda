    "Blocked senders are hidden on this device. Online blocks also prevent new direct contact and invitations; existing shared copies are not recalled." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocked senders are hidden on this device. Online blocks also prevent new direct contact and invitations; existing shared copies are not recalled."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "被屏蔽发送者的内容在本机隐藏。在线屏蔽也会阻止新的直接联系和邀请，已分享的副本无法收回。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les expéditeurs bloqués sont masqués ici. Le blocage en ligne empêche aussi les nouveaux contacts directs et invitations, sans rappeler les copies déjà partagées."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los remitentes bloqueados se ocultan aquí. El bloqueo en línea también impide nuevos contactos directos e invitaciones; no retira copias ya compartidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заблокированные отправители скрыты на этом устройстве. Онлайн-блокировка также запрещает новые прямые контакты и приглашения, но не отзывает переданные копии."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُخفى المرسلون المحظورون على هذا الجهاز. ويمنع الحظر عبر الخدمة التواصل المباشر والدعوات الجديدة، دون سحب النسخ المشتركة سابقًا."
          }
        }
      }
    },
