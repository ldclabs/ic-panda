    "The mobile package limit is 8 MiB. Preview checks the package before you choose what to import.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mobile package limit is 8 MiB. Preview checks the package before you choose what to import."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动端包大小上限为 8 MiB。预览会先验证包，再由你选择导入内容。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La taille des paquets mobiles est limitée à 8 MiB. La prévisualisation vérifie le paquet avant votre sélection des éléments à importer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El límite de los paquetes móviles es de 8 MiB. La vista previa verifica el paquete antes de que elijas qué importar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размер мобильного пакета ограничен 8 MiB. Предпросмотр проверяет пакет до выбора импортируемых данных."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحد الأقصى للحزمة على الهاتف هو 8 MiB. تتحقق المعاينة من الحزمة قبل اختيار ما تريد استيراده."
          }
        }
      }
    },
