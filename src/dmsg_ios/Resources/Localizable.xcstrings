    },
    "The selected image stays on this device until you publish. Published avatars are public and copies may remain outside dMsg." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The selected image stays on this device until you publish. Published avatars are public and copies may remain outside dMsg."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所选图片在发布前仅保留在此设备。发布的头像是公开内容，副本可能保留在 dMsg 之外。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’image choisie reste ici jusqu’à sa publication. Les avatars publiés sont publics et peuvent être copiés hors de dMsg."
