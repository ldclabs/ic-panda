    "Cancellation applies to this undecided request. It does not undo a completed delivery.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancellation applies to this undecided request. It does not undo a completed delivery."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消仅适用于这个尚未决定的请求，不会撤销已完成的交付。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’annulation concerne cette demande non décidée. Elle n’annule pas une livraison déjà terminée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cancelación se aplica a esta solicitud aún no decidida. No deshace una entrega completada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмена относится только к запросу, по которому ещё не принято решение. Завершённая передача не отменяется."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينطبق الإلغاء على هذا الطلب الذي لم يُتخذ قرار بشأنه بعد. ولا يعكس تسليمًا مكتملًا."
          }
        }
      }
    },
    "Have you reviewed the missing outcome?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Have you reviewed the missing outcome?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已核查缺失的执行结果吗？"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avez-vous vérifié le résultat manquant ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Has revisado el resultado no disponible?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы проверили отсутствующий результат?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل راجعت النتيجة غير المتاحة؟"
          }
        }
      }
    },
    "This records that you checked the outcome manually. It does not mark the operation successful or run it again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This records that you checked the outcome manually. It does not mark the operation successful or run it again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这只记录你已人工核查结果，不会将操作标记为成功，也不会再次执行。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela indique que vous avez vérifié le résultat manuellement, sans marquer l’opération comme réussie ni l’exécuter de nouveau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto registra que comprobaste el resultado manualmente. No marca la operación como correcta ni la ejecuta de nuevo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будет записано, что вы проверили результат вручную. Операция не отмечается успешной и не выполняется повторно."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسجّل هذا أنك تحققت من النتيجة يدويًا. ولا يضع علامة نجاح على العملية أو يشغّلها مجددًا."
          }
        }
      }
    },
