    "Your report and any text you explicitly include will be sent to the moderation team. Other private content and keys are not included." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your report and any text you explicitly include will be sent to the moderation team. Other private content and keys are not included."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "举报及你明确附上的正文会发送给处理团队，不包含其他私密内容或密钥。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre signalement et le texte explicitement joint seront envoyés aux modérateurs. Aucun autre contenu privé ni clé n’est inclus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La denuncia y el texto que adjuntes expresamente se enviarán a moderación. No se incluye otro contenido privado ni claves."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жалоба и явно приложенный текст будут отправлены модераторам. Другие личные данные и ключи не передаются."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُرسل البلاغ والنص الذي ترفقه صراحةً إلى فريق المراجعة. لا يُضمّن أي محتوى خاص آخر أو مفاتيح."
          }
        }
      }
