    },
    "The local tour is available to everyone. To test account creation, synchronization, purchases, notifications and hardware authorization, leave the tour and sign in through Internet Identity." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The local tour is available to everyone. To test account creation, synchronization, purchases, notifications and hardware authorization, leave the tour and sign in through Internet Identity."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有人都可使用本地演示。要测试账号创建、同步、购买、通知和硬件授权，请退出演示并通过 Internet Identity 登录。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La visite locale est ouverte à tous. Pour tester la création de compte, la synchronisation, les achats, les notifications et l’autorisation matérielle, quittez-la et connectez-vous avec Internet Identity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La visita local está disponible para todos. Para probar cuentas, sincronización, compras, notificaciones y autorización de hardware, sal e inicia sesión con Internet Identity."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Локальная демонстрация доступна всем. Для проверки создания аккаунтов, синхронизации, покупок, уведомлений и аппаратной авторизации выйдите из неё и войдите через Internet Identity."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الجولة المحلية متاحة للجميع. لاختبار إنشاء الحسابات والمزامنة والمشتريات والإشعارات والتفويض العتادي، غادر الجولة وسجّل الدخول عبر Internet Identity."
          }
        }
      }
    },
    "The record changed. Refresh and review your edits before saving again." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
