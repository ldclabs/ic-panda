    "Local files are not backed up automatically. Uninstalling dMsg removes files that have no cloud backup.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机文件不会自动备份。卸载 dMsg 会丢失尚未云备份的文件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local files are not backed up automatically. Uninstalling dMsg removes files that have no cloud backup."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers locaux ne sont pas sauvegardés automatiquement. Désinstaller dMsg supprime les fichiers sans sauvegarde cloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos locales no se respaldan automáticamente. Desinstalar dMsg elimina los archivos sin copia en la nube."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальные файлы не копируются в облако автоматически. Удаление dMsg приведёт к потере файлов без облачной копии."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تُنسخ الملفات المحلية احتياطيًا تلقائيًا. تؤدي إزالة dMsg إلى فقد الملفات التي ليس لها نسخة سحابية."
          }
        }
      }
    },
