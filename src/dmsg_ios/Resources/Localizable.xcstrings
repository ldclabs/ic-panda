    "This only hides this exact finding and revision on this device. It does not repair a credential or dismiss future changes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This only hides this exact finding and revision on this device. It does not repair a credential or dismiss future changes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这只会在此设备隐藏本次发现及其对应版本，不会修复凭据，也不会忽略之后的变更。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela masque uniquement ce constat et cette révision sur cet appareil. Aucun identifiant n’est réparé et les changements futurs ne sont pas ignorés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto solo oculta este hallazgo y su revisión en este dispositivo. No repara la credencial ni descarta cambios futuros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будут скрыты только этот результат и его версия на данном устройстве. Учётные данные не исправляются, будущие изменения не игнорируются."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يخفي هذا النتيجة المحددة وإصدارها على هذا الجهاز فقط. ولا يصلح بيانات الاعتماد أو يستبعد التغييرات المستقبلية."
          }
        }
      }
    },
