    "Desktop-local command approvals stay on that desktop. Only requests available to this device appear here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop-local command approvals stay on that desktop. Only requests available to this device appear here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桌面本地命令的审批留在对应桌面，只显示此设备可用的请求。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les approbations de commandes locales à un ordinateur y restent. Seules les demandes disponibles sur cet appareil apparaissent ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las aprobaciones de comandos locales del escritorio permanecen en ese ordenador. Aquí solo aparecen las solicitudes disponibles para este dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтверждения локальных команд остаются на соответствующем компьютере. Здесь показаны только запросы, доступные этому устройству."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى موافقات الأوامر المحلية على الحاسوب نفسه. لا تظهر هنا إلا الطلبات المتاحة لهذا الجهاز."
          }
        }
      }
    },
