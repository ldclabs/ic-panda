    "Changes create proposals and still require the wallet's existing approvals. Existing policy fields and member agent permissions are preserved." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changes create proposals and still require the wallet's existing approvals. Existing policy fields and member agent permissions are preserved."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改会创建提案，仍须满足钱包现有批准要求。其他策略字段和成员 Agent 权限会保留。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les changements créent des propositions soumises aux approbations existantes. Les autres paramètres et permissions d’agents des membres sont conservés."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cambios crean propuestas sujetas a las aprobaciones existentes. Se conservan los demás campos de política y permisos de agentes de los miembros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изменения создают предложения с действующими требованиями одобрения. Остальные поля политики и разрешения агентов участников сохраняются."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنشئ التغييرات اقتراحات تخضع للموافقات الحالية. تُحفظ حقول السياسة الأخرى وصلاحيات وكلاء الأعضاء."
          }
        }
      }
    },
