          }
        }
      }
    },
    "The operation was cancelled or is not permitted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作已取消，或当前没有权限。"
          }
        },
        "en": {
