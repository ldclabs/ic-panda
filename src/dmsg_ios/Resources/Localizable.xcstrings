    "Choose which version to keep. Existing history is retained; secrets are never silently overwritten.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which version to keep. Existing history is retained; secrets are never silently overwritten."
          }
