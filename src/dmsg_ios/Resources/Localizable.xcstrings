    "A reference identifies a field; it does not contain its secret value or grant permission to read it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reference identifies a field; it does not contain its secret value or grant permission to read it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "引用用于定位字段，不包含字段的秘密值，也不授予读取权限。"
          }
        },
        "fr": {
          "stringUnit": {
