          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбранное изображение остаётся на устройстве до публикации. Опубликованные аватары публичны, и их копии могут сохраняться вне dMsg."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى الصورة المختارة على هذا الجهاز حتى نشرها. الصور المنشورة عامة وقد تبقى نسخ منها خارج dMsg."
          }
        }
      }
    },
    "The selected items could not be staged. Open dMsg and try importing them there." : {
      "extractionState" : "manual",
