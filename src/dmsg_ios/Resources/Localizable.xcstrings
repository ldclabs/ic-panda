    "Import an unencrypted 1Password, Bitwarden or browser password export. The source stays on this device; only selected records are added." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import an unencrypted 1Password, Bitwarden or browser password export. The source stays on this device; only selected records are added."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导入未加密的 1Password、Bitwarden 或浏览器密码导出文件。源文件仅保留在本机，只添加你选择的记录。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importez un export non chiffré de 1Password, Bitwarden ou du navigateur. La source reste sur cet appareil ; seuls les éléments choisis sont ajoutés."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa un archivo sin cifrar de 1Password, Bitwarden o del navegador. El origen permanece aquí; solo se añaden los registros seleccionados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Импортируйте незашифрованный экспорт 1Password, Bitwarden или браузера. Исходный файл остаётся на устройстве; добавляются только выбранные записи."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استورد ملف كلمات مرور غير مشفّر من 1Password أو Bitwarden أو المتصفح. يبقى المصدر على هذا الجهاز وتُضاف السجلات المختارة فقط."
          }
        }
      }
    },
