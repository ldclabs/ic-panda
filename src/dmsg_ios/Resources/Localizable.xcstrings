    "This tracks your work on this device. It does not create, test or revoke credentials at their provider.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This tracks your work on this device. It does not create, test or revoke credentials at their provider."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这只记录你在此设备上的工作，不会替你在服务提供方创建、测试或撤销凭据。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela suit votre travail sur cet appareil, sans créer, tester ni révoquer les identifiants auprès de leur fournisseur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto registra tu trabajo en este dispositivo. No crea, prueba ni revoca credenciales en su proveedor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь фиксируются ваши действия на этом устройстве. Учётные данные у поставщика не создаются, не проверяются и не отзываются автоматически."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتتبع هذا عملك على هذا الجهاز. ولا ينشئ بيانات اعتماد لدى مزودها أو يختبرها أو يبطلها."
          }
        }
      }
    },
    "No item attachments": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No item attachments"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "条目暂无附件"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune pièce jointe à cet élément"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El elemento no tiene adjuntos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У записи нет вложений"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد مرفقات للعنصر"
          }
        }
      }
    },
    "Item references can sync before their files. Only files available on this device can be added to a new snapshot.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Item references can sync before their files. Only files available on this device can be added to a new snapshot."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "条目引用可能先于文件同步。只有此设备上可用的文件才能加入新快照。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les références d’éléments peuvent se synchroniser avant leurs fichiers. Seuls les fichiers disponibles sur cet appareil peuvent être ajoutés à un nouvel instantané."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las referencias pueden sincronizarse antes que sus archivos. Solo los archivos disponibles en este dispositivo pueden añadirse a una nueva instantánea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылки на файлы могут синхронизироваться раньше самих файлов. В новый снимок можно добавить только файлы, доступные на этом устройстве."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد تتم مزامنة مراجع العناصر قبل ملفاتها. لا يمكن إضافة ملف إلى لقطة جديدة إلا إذا كان متاحًا على هذا الجهاز."
          }
        }
      }
    },
    "Item attachments": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Item attachments"
          }
        },
        "zh-Hans": {
          "stringUnit": {
