    "Binding protects this local workspace even after a new login. Keep another authorized device or a recovery path before changing it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Binding protects this local workspace even after a new login. Keep another authorized device or a recovery path before changing it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使重新登录，本机绑定仍会保护此本地工作区。变更前，请确保有其他已授权设备或可用的恢复途径。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liaison protège cet espace local même après une nouvelle connexion. Conservez un autre appareil autorisé ou une voie de récupération avant de la modifier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vinculación protege este espacio local incluso tras iniciar sesión de nuevo. Conserva otro dispositivo autorizado o una vía de recuperación antes de cambiarla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Привязка защищает локальное рабочее пространство даже после нового входа. Перед изменением убедитесь, что есть другое авторизованное устройство или способ восстановления."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحمي الربط مساحة العمل المحلية حتى بعد تسجيل دخول جديد. تأكد من وجود جهاز مخوّل آخر أو مسار استرداد قبل تغييره."
          }
        }
      }
    },
    "Background signing and resident agent capabilities are separate from this workspace lock.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background signing and resident agent capabilities are separate from this workspace lock."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台签名和常驻 Agent 能力不受此工作区锁定控制。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La signature en arrière-plan et les capacités des agents résidents sont distinctes du verrouillage de cet espace."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La firma en segundo plano y las capacidades de los agentes residentes son independientes del bloqueo de este espacio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подпись в фоне и возможности постоянно работающих агентов не связаны с блокировкой рабочего пространства."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التوقيع في الخلفية وصلاحيات الوكلاء المقيمين منفصلة عن قفل مساحة العمل هذا."
          }
        }
      }
    },
