    "The encrypted version will use cloud storage. Your local copy stays on this device.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加密版本将占用云端空间，本机副本会继续保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The encrypted version will use cloud storage. Your local copy stays on this device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version chiffrée utilisera du stockage cloud. Votre copie locale reste sur cet appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión cifrada ocupará espacio en la nube. Tu copia local permanece en este dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зашифрованная версия займёт место в облаке. Локальная копия останется на этом устройстве."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستستخدم النسخة المشفّرة مساحة تخزين سحابية. تبقى نسختك المحلية على هذا الجهاز."
          }
        }
      }
    },
    "The invitation is bound to this account. Sharing the link does not grant access to another account.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The invitation is bound to this account. Sharing the link does not grant access to another account."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邀请与这个账户绑定，分享链接不会向其他账户授予权限。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’invitation est liée à ce compte. Partager le lien n’accorde pas l’accès à un autre compte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La invitación está vinculada a esta cuenta. Compartir el enlace no concede acceso a otra cuenta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приглашение привязано к этому аккаунту. Передача ссылки не даёт доступа другому аккаунту."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الدعوة مرتبطة بهذا الحساب. مشاركة الرابط لا تمنح حسابًا آخر حق الوصول."
          }
        }
      }
    },
