    "Biometrics-only keys cannot use the device passcode and may stop working when enrolled biometrics change." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المفاتيح المقيدة بالقياسات الحيوية لا تقبل رمز دخول الجهاز، وقد تتوقف عن العمل عند تغيّر القياسات الحيوية المسجلة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biometrics-only keys cannot use the device passcode and may stop working when enrolled biometrics change."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las claves limitadas a biometría no admiten el código del dispositivo y pueden dejar de funcionar si cambian los datos biométricos registrados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clés limitées à la biométrie n’acceptent pas le code de l’appareil et peuvent devenir inutilisables si les données biométriques enregistrées changent."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключи только с биометрией не допускают код-пароль устройства и могут перестать работать при изменении зарегистрированной биометрии."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅限生物识别的钥匙不能使用设备密码，并可能在已录入的生物识别信息变化后失效。"
          }
        }
      }
    },
