    "Existing block rules, invitations and inbox capacity are preserved. Choosing a free or closed policy replaces any previous paid contact setting." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Existing block rules, invitations and inbox capacity are preserved. Choosing a free or closed policy replaces any previous paid contact setting."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现有屏蔽规则、邀请和收件箱容量会保留。选择免费或关闭，会替换原有的付费联系设置。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
