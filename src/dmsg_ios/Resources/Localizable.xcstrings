    "Choose who may send you free letters. Blocked accounts remain blocked until you unblock them." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose who may send you free letters. Blocked accounts remain blocked until you unblock them."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择谁可以向你免费发送来信。已屏蔽账号会保持屏蔽，直到你解除。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez qui peut vous écrire gratuitement. Les comptes bloqués le restent jusqu’à leur déblocage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige quién puede enviarte mensajes gratis. Las cuentas bloqueadas siguen así hasta que las desbloquees."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
