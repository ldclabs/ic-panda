          }
        }
      }
    },
    "The transfer authorization expired. Cancel this task, then continue the original backup in the foreground or start a new download." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The transfer authorization expired. Cancel this task, then continue the original backup in the foreground or start a new download."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "传输授权已到期。请取消此任务，再在前台继续原备份或启动新下载。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’autorisation a expiré. Annulez cette tâche, puis continuez la sauvegarde initiale au premier plan ou démarrez un nouveau téléchargement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
