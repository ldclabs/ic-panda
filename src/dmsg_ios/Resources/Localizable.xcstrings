          }
        }
      }
    },
    "This inventory covers references and delivery records on this device. It does not search other devices or arbitrary project files.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This inventory covers references and delivery records on this device. It does not search other devices or arbitrary project files."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此清单涵盖本设备的引用和交付记录，不会搜索其他设备或任意项目文件。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet inventaire couvre les références et livraisons enregistrées sur cet appareil. Il ne recherche ni sur d’autres appareils ni dans des fichiers de projet arbitraires."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este inventario incluye referencias y registros de entrega de este dispositivo. No busca en otros dispositivos ni en archivos de proyecto arbitrarios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список охватывает ссылки и записи передачи на этом устройстве. Другие устройства и произвольные файлы проектов не проверяются."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشمل هذا الجرد المراجع وسجلات التسليم على هذا الجهاز. ولا يبحث في الأجهزة الأخرى أو في ملفات المشاريع غير المحددة."
          }
        }
      }
    },
