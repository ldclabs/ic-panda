    "Ask an administrator to bind this login to your existing account. Device authorization is a separate step.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask an administrator to bind this login to your existing account. Device authorization is a separate step."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请管理员将这个登录身份绑定到已有账户。设备授权需要单独完成。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à un administrateur de rattacher cette identité à votre compte existant. L’autorisation de l’appareil est une étape distincte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide a un administrador que vincule esta identidad a tu cuenta existente. La autorización del dispositivo es un paso independiente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попросите администратора привязать эту учётную запись входа к существующему аккаунту. Авторизация устройства выполняется отдельно."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلب من مسؤول ربط هوية تسجيل الدخول هذه بحسابك الحالي. تفويض الجهاز خطوة منفصلة."
          }
        }
      }
    },
