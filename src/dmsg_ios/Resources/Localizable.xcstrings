    "Signing in proves your identity. An existing device must authorize a new device before it can read your content.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录只证明你的身份。新设备需要已有设备授权后，才能读取私密内容。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in proves your identity. An existing device must authorize a new device before it can read your content."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion prouve votre identité. Un appareil existant doit autoriser le nouvel appareil avant qu’il puisse lire votre contenu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar sesión demuestra tu identidad. Un dispositivo existente debe autorizar el nuevo dispositivo antes de que pueda leer tu contenido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход подтверждает вашу личность. Существующее устройство должно авторизовать новое, прежде чем оно сможет читать ваши данные."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يثبت تسجيل الدخول هويتك. يجب أن يفوّض جهاز حالي الجهاز الجديد قبل أن يتمكن من قراءة محتواك."
          }
        }
      }
    },
