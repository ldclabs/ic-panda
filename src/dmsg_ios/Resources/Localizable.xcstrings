          "stringUnit": {
            "state": "translated",
            "value": "No se pudo completar la operación. Inténtalo de nuevo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось завершить операцию. Повторите попытку."
