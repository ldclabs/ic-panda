    },
    "The source copy was interrupted. Discard it and select the source again." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The source copy was interrupted. Discard it and select the source again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "源文件复制已中断，请丢弃此副本并重新选择来源。"
          }
        },
        "fr" : {
          "stringUnit" : {
