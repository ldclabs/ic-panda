    "This changes local unlock protection. System authentication may be required. No account recovery or other device is changed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This changes local unlock protection. System authentication may be required. No account recovery or other device is changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会改变本地解锁保护，可能需要系统认证；不会变更账户恢复或其他设备。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela modifie la protection du déverrouillage local et peut nécessiter l’authentification système. La récupération du compte et les autres appareils ne sont pas modifiés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto cambia la protección del desbloqueo local y puede requerir autenticación del sistema. No modifica la recuperación de la cuenta ni otros dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это изменяет защиту локальной разблокировки и может потребовать системной аутентификации. Восстановление аккаунта и другие устройства не изменяются."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يغيّر هذا حماية فك القفل المحلي وقد يتطلب مصادقة النظام. لا يغيّر استرداد الحساب أو أي جهاز آخر."
          }
        }
      }
    },
    "This history belongs to this device. It does not mirror desktop-local CLI, SSH or file-mount approvals from another device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This history belongs to this device. It does not mirror desktop-local CLI, SSH or file-mount approvals from another device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此历史记录仅属于本设备，不会镜像其他设备上的桌面本地 CLI、SSH 或文件挂载审批。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet historique appartient à cet appareil. Il ne reproduit pas les approbations CLI, SSH ou de montage de fichiers locales à un autre ordinateur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este historial pertenece a este dispositivo. No refleja aprobaciones locales de CLI, SSH o montajes de archivos de otro ordenador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта история относится к данному устройству. Локальные подтверждения CLI, SSH и монтирования файлов с другого компьютера здесь не отображаются."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا السجل خاص بهذا الجهاز. ولا يعكس موافقات CLI أو SSH أو تركيب الملفات المحلية على حاسوب آخر."
          }
        }
      }
    },
