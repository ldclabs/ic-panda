    "Account, device and identity protection changes together. A required approval cannot fall back to an ordinary confirmation dialog.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account, device and identity protection changes together. A required approval cannot fall back to an ordinary confirmation dialog."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户、设备和身份的保护同时变更。必需的硬件批准不能降级为普通确认对话框。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La protection du compte, des appareils et des identités change ensemble. Une approbation obligatoire ne peut pas être remplacée par une simple boîte de confirmation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La protección de la cuenta, los dispositivos y las identidades cambia conjuntamente. Una aprobación obligatoria no puede sustituirse por un diálogo de confirmación normal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Защита аккаунта, устройств и личностей меняется совместно. Обязательное подтверждение нельзя заменить обычным диалогом подтверждения."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتغيّر حماية الحساب والأجهزة والهويات معًا. لا يمكن استبدال الموافقة المطلوبة بنافذة تأكيد عادية."
          }
        }
      }
    },
