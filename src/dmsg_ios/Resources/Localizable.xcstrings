    "Recovery uses your bound login and a waiting period. An authorized device can dispute it. Unsynced local content cannot be recovered.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用已绑定的登录身份发起恢复，并经过等待期。已授权设备可提出争议。未同步的本机内容无法恢复。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery uses your bound login and a waiting period. An authorized device can dispute it. Unsynced local content cannot be recovered."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La récupération utilise votre identité liée et un délai d’attente. Un appareil autorisé peut la contester. Le contenu local non synchronisé ne peut pas être récupéré."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La recuperación utiliza tu identidad vinculada y un período de espera. Un dispositivo autorizado puede impugnarla. El contenido local no sincronizado no se puede recuperar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для восстановления используются привязанная учётная запись входа и период ожидания. Авторизованное устройство может оспорить его. Несинхронизированные локальные данные восстановить нельзя."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعتمد الاسترداد على هوية الدخول المرتبطة وفترة انتظار. يمكن لجهاز مفوّض الاعتراض عليه. لا يمكن استرداد المحتوى المحلي غير المتزامن."
          }
        }
      }
    },
