          "stringUnit" : {
            "state" : "translated",
            "value" : "Authenticate to access the file copies you exported from dMsg. Access lasts five minutes; the snapshot expires after 24 hours."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过系统认证后访问从 dMsg 导出的文件副本。访问持续五分钟，快照在 24 小时后到期。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authentifiez-vous pour accéder aux copies exportées de dMsg. L’accès dure cinq minutes ; l’instantané expire après 24 heures."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autentícate para acceder a las copias exportadas de dMsg. El acceso dura cinco minutos; la instantánea caduca a las 24 horas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подтвердите личность для доступа к экспортированным копиям. Доступ длится пять минут; снимок истекает через 24 часа."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صادِق للوصول إلى نسخ الملفات المصدّرة من dMsg. يستمر الوصول خمس دقائق وتنتهي اللقطة بعد 24 ساعة."
          }
        }
      }
    },
    "Authenticate to continue" : {
