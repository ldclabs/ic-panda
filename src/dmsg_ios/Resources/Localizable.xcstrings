    "Import a document to encrypt it on this device. Cloud backup is a separate action." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استورد مستندًا لتشفيره على هذا الجهاز. النسخ الاحتياطي السحابي إجراء منفصل."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import a document to encrypt it on this device. Cloud backup is a separate action."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa un documento para cifrarlo en este dispositivo. El respaldo en la nube es una acción independiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importez un document pour le chiffrer sur cet appareil. La sauvegarde cloud est une action distincte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Импортируйте документ для шифрования на этом устройстве. Резервная копия в облаке создаётся отдельно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导入文件后将在本机加密保存，云端备份需要单独操作。"
          }
        }
      }
    },
    "Import a file in Files before attaching it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استورد ملفًا في قسم الملفات قبل إرفاقه."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import a file in Files before attaching it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa un archivo en Archivos antes de adjuntarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importez d’abord un fichier dans Fichiers pour pouvoir le joindre."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала импортируйте файл в раздел «Файлы», затем прикрепите его."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请先在文件库中导入文件，再选择附件。"
          }
        }
      }
    },
    "Import creates new independent items. Files stay on this device and inherit the selected folder's access grants. Nothing is selected automatically." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينشئ الاستيراد عناصر مستقلة جديدة. تبقى الملفات على هذا الجهاز وترث أذونات الوصول للمجلد المحدد. لا يتم تحديد أي محتوى تلقائيًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import creates new independent items. Files stay on this device and inherit the selected folder's access grants. Nothing is selected automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La importación crea elementos nuevos e independientes. Los archivos permanecen en este dispositivo y heredan los permisos de acceso de la carpeta elegida. Nada se selecciona automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’importation crée de nouveaux éléments indépendants. Les fichiers restent sur cet appareil et héritent des droits d’accès du dossier choisi. Rien n’est sélectionné automatiquement."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Импорт создаёт новые независимые записи. Файлы остаются на этом устройстве и наследуют разрешения выбранной папки. Ничего не выбирается автоматически."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导入会创建新的独立条目。文件仅保存在本设备，并继承所选文件夹的访问授权。不会自动选择任何内容。"
          }
        }
      }
    },
