    "This device keeps its own encrypted workspace. Content that has not synced cannot be recovered from another device." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتفظ هذا الجهاز بمساحة عمل مشفّرة مستقلة. لا يمكن استرداد المحتوى غير المتزامن من جهاز آخر."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device keeps its own encrypted workspace. Content that has not synced cannot be recovered from another device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo mantiene su propio espacio cifrado. El contenido no sincronizado no puede recuperarse desde otro dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil conserve son propre espace chiffré. Le contenu non synchronisé ne peut pas être récupéré depuis un autre appareil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это устройство хранит отдельное зашифрованное пространство. Несинхронизированные данные нельзя восстановить с другого устройства."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台设备保存独立的加密工作区，未同步内容无法从其他设备恢复。"
          }
        }
      }
    },
    "This device key is no longer usable. Use another authorized device or account recovery. Your workspace has not been erased." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يعد مفتاح هذا الجهاز صالحًا للاستخدام. استخدم جهازًا مخوّلًا آخر أو استرداد الحساب. لم تُمحَ مساحة عملك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device key is no longer usable. Use another authorized device or account recovery. Your workspace has not been erased."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta clave del dispositivo ya no se puede usar. Utiliza otro dispositivo autorizado o la recuperación de la cuenta. Tu espacio no se ha borrado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette clé d’appareil n’est plus utilisable. Utilisez un autre appareil autorisé ou la récupération du compte. Votre espace n’a pas été effacé."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключ устройства больше нельзя использовать. Воспользуйтесь другим авторизованным устройством или восстановлением аккаунта. Рабочее пространство не удалено."
          }
        },
        "zh-Hans" : {
