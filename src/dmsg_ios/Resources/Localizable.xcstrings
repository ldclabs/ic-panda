    "Share this request with an authorized administrator. It does not register or approve the key by itself.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share this request with an authorized administrator. It does not register or approve the key by itself."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此请求分享给已授权的管理员。请求本身不会注册或批准钥匙。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez cette demande avec un administrateur autorisé. Elle n’enregistre ni n’approuve la clé à elle seule."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte esta solicitud con un administrador autorizado. Por sí sola no registra ni aprueba la clave."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Передайте запрос авторизованному администратору. Сам запрос не регистрирует и не подтверждает ключ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شارك هذا الطلب مع مسؤول مخوّل. الطلب وحده لا يسجّل المفتاح ولا يوافق عليه."
          }
        }
      }
    },
