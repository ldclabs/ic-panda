// Product, authority and opaque subject binding; decoding does not establish control.
type Beneficiary = record {
  // Product identifier within this protocol.
  product_id : text;
  // Canister authoritative for the beneficiary subject.
  authority_canister : principal;
  // Opaque subject bytes in the registered schema.
  subject_bytes : blob;
  // Registered schema identifying how to interpret subject_bytes.
  subject_schema : text;
};
// IC-certified query response. Merely decoding this value authenticates nothing.
// Verify the IC certificate against a trusted root, the expected canister and
// certificate time, then each witness, requested path and exact leaf bytes.
type CertifiedBatch = record {
  // IC data certificate bytes; verify against a trusted IC root key.
  certificate : blob;
  // Version of this public certified-leaf format, not the storage schema.
  schema : nat16;
  // Requested leaves and their membership/absence witnesses.
  entries : vec CertifiedEntry;
  // Canister identity to match against the expected service and certificate.
  canister : principal;
};
// One requested leaf and its IC hash-tree witness.
// A missing value must be checked as an absence proof, not treated as an empty leaf.
type CertifiedEntry = record {
  // Raw requested leaf path segment; compare with the exact expected path.
  key : blob;
  // Exact serialized leaf bytes, or None for requested absence.
  value : opt blob;
  // CBOR-encoded IC hash-tree witness for this requested leaf.
  witness : blob;
};
// Relationship between a new claim and an existing benefit commitment.
type ClaimChange = variant {
  // Start a new independent benefit.
  Start;
  // Upgrade an existing base benefit.
  Upgrade : record {
    // Existing claim whose benefit is being changed.
    previous_claim : blob;
  };
  // Replace the qualifying claim supporting an existing benefit.
  Replace : record {
    // Existing claim whose benefit is being changed.
    previous_claim : blob;
  };
  // Renew an existing benefit for a subsequent term.
  Renew : record {
    // Existing claim whose benefit is being changed.
    previous_claim : blob;
  };
};
// Frozen qualification request and beneficiary authorization.
type ClaimRequest = record {
  // Requested or frozen benefit interval.
  term : TermRule;
  // Opaque product benefit identity.
  benefit_id : blob;
  // Requested relationship to an earlier claim.
  change : ClaimChange;
  // Immutable qualification policy version.
  policy_version : nat64;
  // Product business revision required for compare-and-swap.
  expected_business_revision : nat64;
  // Exact beneficiary intent approved for this operation.
  authorization : MembershipIntent;
  // Fixed PANDA SNS neuron identifier.
  neuron_id : blob;
};
// Durable qualification and product-decision lifecycle.
type ClaimStatus = variant {
  // Qualified observation is waiting out the admission cooling period.
  CoolingDown;
  // Benefit closure is in progress.
  Closing;
  // Benefit is active under its recorded terms.
  Active;
  // Exclusive binding has been released.
  Released;
  // The request or transfer was definitively rejected.
  Rejected;
  // Initial qualification checks are pending.
  Checking;
  // A durable product decision awaits acknowledgment.
  Applying;
};
// Public qualification leaf deliberately excludes economic identities and raw neurons.
type ClaimView = record {
  // Current lifecycle state of this record.
  status : ClaimStatus;
  // Membership canister authoritative for this claim.
  home_membership : principal;
  // Idempotency identifier of the product decision.
  decision_id : opt blob;
  // Earliest exclusive-binding release time in Unix milliseconds.
  release_after_ms : nat64;
  // Stable qualification claim identity.
  claim_id : blob;
  // Product subject receiving the benefit.
  beneficiary : Beneficiary;
  // Public record format version, independent of stable storage.
  schema : nat16;
  // Exclusive validity deadline in Unix milliseconds.
  valid_until_ms : nat64;
  // Time the supporting qualification observation began, in Unix milliseconds.
  observed_at_ms : nat64;
  // Opaque product benefit identity.
  benefit_id : blob;
  // Monotonic projection/lease revision, including refreshes.
  lease_revision : nat64;
  // Inclusive interval start in Unix milliseconds.
  starts_at_ms : nat64;
  // Most recent qualification assessment.
  eligibility : Eligibility;
  // Immutable qualification policy version.
  policy_version : nat64;
  // Exclusive interval end in Unix milliseconds.
  expires_at_ms : nat64;
};
// Qualification observation; unverifiable is distinct from known ineligibility.
type Eligibility = variant {
  // Current supporting facts cannot be verified.
  Unverifiable;
  // Known not to satisfy the policy.
  Ineligible;
  // Known to satisfy the fixed qualification policy.
  Eligible;
};
// Deployment domain used to separate identities and key derivation.
type Environment = variant {
  // Local development deployment.
  Local;
  // Production deployment with pinned chain-key configuration.
  Production;
  // Pre-production deployment domain.
  Staging;
};
// Application errors returned by dMsg canisters and protocol helpers.
// Transport failures and Candid decoding failures are separate from this enum.
type Error = variant {
  // Required legacy key material is unavailable.
  MigrationKeyUnavailable;
  // Legacy business writes are frozen.
  LegacyWriteDisabled;
  // A supplied field or combination is invalid; carries a diagnostic.
  InvalidInput : text;
  // A new content root must be committed before writes can resume.
  RekeyRequired;
  // Expected version/generation differs from current state; reread before preparing a new approval.
  VersionConflict;
  // Execution may have occurred; reconcile the original request instead of creating another.
  ExecutionUnknown;
  // A digest, signature, proof or accounting invariant failed validation.
  IntegrityFailed;
  // Account-ID timestamp cannot fit the generator format.
  IdTimestampOutOfRange;
  // The requested record does not exist.
  NotFound;
  // The approved fee or available fee reserve cannot support the transfer.
  FeeBlocked;
  // The device is missing, revoked or not approved for this operation.
  DeviceNotApproved;
  // Sensitive operations are locked by account state or policy.
  Locked;
  // The source benefit is closing and cannot issue new leases.
  MembershipClosing;
  // Required recovery setup/confirmation has not completed.
  RecoveryIncomplete;
  // Account-ID counter space is exhausted for this timestamp.
  IdCapacityExceeded;
  // Approval or policy evidence refers to an outdated security state.
  PolicyStale;
  // Persisted account-ID allocator state does not match its configured namespace.
  IdGeneratorStateConflict;
  // An operation ID was reused with different parameters.
  IdempotencyConflict;
  // The profile, algorithm or protocol version is unsupported.
  UnsupportedProtocol;
  // A required service or resource is unavailable; carries a diagnostic.
  Unavailable : text;
  // Commercial qualification is temporarily unverifiable or its lease expired.
  MembershipStale;
  // Caller, role or capability does not authorize this operation.
  Forbidden;
  // Retained output is no longer available; this does not authorize replay.
  ResultExpired;
  // The applicable deadline has passed.
  Expired;
  // The subject is known to be ineligible for the requested benefit.
  MembershipIneligible;
  // An execution, cycle, storage or admission limit was exceeded.
  QuotaExceeded;
  // An authenticated and appropriately bound caller is required.
  AuthRequired;
  // The operation is not yet complete; query/retry the same operation as appropriate.
  Pending;
};
// Shared qualification service deployment and admission limits.
type MembershipInit = record {
  // Maximum retained qualification claims.
  max_claims : nat64;
  // New application limit per UTC hour.
  hourly_applications : nat32;
  // Pinned PANDA ledger canister.
  panda_ledger : principal;
  // Pinned PANDA SNS root canister.
  sns_root : principal;
  // Deployment domain of the request or service.
  environment : Environment;
  // Cooling duration in milliseconds before qualification can activate.
  cooling_ms : nat64;
  // Governance Principal controlling this service configuration.
  governance : principal;
  // Registered product adapters and subject schemas.
  products : vec ProductConfig;
  // Total allowed service subsidy units, not ledger funds.
  subsidy_budget : nat64;
  // Initial immutable qualification policies.
  policies : vec MembershipPolicy;
};
// A device-approved, purpose-separated intent. Actor authentication is also required.
type MembershipIntent = record {
  // Authenticated economic actor approving the action.
  actor : principal;
  // Product subject receiving the benefit.
  beneficiary : Beneficiary;
  // Exclusive validity deadline in Unix milliseconds.
  valid_until_ms : nat64;
  // Domain-separated commitment to the exact requested action.
  action_digest : blob;
  // Stable idempotency identifier for this application.
  application_id : blob;
  // Challenge preventing reuse as a different authorization.
  nonce : blob;
  // Exact service authorized to consume this intent.
  service_canister : principal;
  // Deployment domain of the request or service.
  environment : Environment;
};
// Immutable product benefit and qualification policy snapshot.
type MembershipPolicy = record {
  // Product identifier within this protocol.
  product_id : text;
  // Required PANDA stake calculation under this policy.
  threshold : Threshold;
  // Governance-approved service cost reservation, not cash revenue.
  subsidy_units : nat64;
  // Opaque product benefit identity.
  benefit_id : blob;
  // Inclusive activation time in Unix milliseconds.
  effective_at_ms : nat64;
  // Immutable version identifier within this policy or catalog.
  version : nat64;
};
// Governance-registered product adapter and permitted beneficiary authorities.
type ProductConfig = record {
  // Product identifier within this protocol.
  product_id : text;
  // Expected subject byte length.
  subject_size : nat16;
  // Product canister applying membership decisions.
  adapter : principal;
  // Canisters permitted to authorize product subjects.
  authorities : vec principal;
  // Registered schema identifying how to interpret subject_bytes.
  subject_schema : text;
};
type Result = variant { Ok : ClaimView; Err : Error };
type Result_1 = variant { Ok : CertifiedBatch; Err : Error };
type Result_2 = variant { Ok : MembershipPolicy; Err : Error };
type Result_3 = variant { Ok; Err : Error };
// Calendar-year term or an explicit half-open UTC millisecond interval.
type TermRule = variant {
  // Explicit half-open interval.
  Fixed : record {
    // Inclusive interval start in Unix milliseconds.
    starts_at_ms : nat64;
    // Exclusive interval end in Unix milliseconds.
    expires_at_ms : nat64;
  };
  // One calendar year; February 29 is clamped to February 28.
  CalendarYear;
};
// Integer PANDA stake requirement; AnnualPrice is rounded up by the protocol helper.
type Threshold = variant {
  // Annual USD-cent price converted at a rational PANDA/USD ratio.
  AnnualPrice : record {
    // Integer annual or product price in USD cents.
    price_cents : nat64;
    // Positive denominator of the PANDA-per-USD conversion ratio.
    r_den : nat;
    // Positive numerator of the PANDA-per-USD conversion ratio.
    r_num : nat;
  };
  // Fixed positive PANDA atomic stake.
  FixedPanda : record {
    // Positive PANDA amount in ledger atomic units.
    atomic : nat;
  };
};
service : (MembershipInit) -> {
  advance_application : (blob) -> (Result);
  cancel_application : (blob) -> (Result);
  close_for_consumer : (blob) -> (Result);
  get_claim_certified : (vec blob) -> (Result_1) query;
  get_claim_for_consumer : (blob) -> (Result);
  get_operation : (blob) -> (Result) query;
  get_policy : (nat64) -> (Result_2) query;
  get_policy_certified : (vec nat64) -> (Result_1) query;
  increase_subsidy_budget : (nat64) -> (Result_3);
  reconcile_claim : (blob) -> (Result);
  refresh_claim : (blob) -> (Result);
  register_product : (ProductConfig) -> (Result_3);
  request_change : (blob, MembershipIntent) -> (Result);
  request_claim : (ClaimRequest) -> (Result);
  schedule_policy : (MembershipPolicy) -> (Result_3);
  set_admission_pause : (bool) -> (Result_3);
  verify_sns_configuration : () -> (Result_3);
}
