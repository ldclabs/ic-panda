@tailwind base;
@tailwind components;
@tailwind utilities;

/**
 * Typography — self-hosted, no external requests.
 * Archivo (variable) carries the display voice; IBM Plex Mono carries every
 * label, number, and on-chain fact. Mono-forward on purpose: this site should
 * read like a protocol spec sheet, not a token launch page.
 */
@font-face {
  font-family: 'Archivo';
  font-style: normal;
  font-weight: 400 900;
  font-stretch: 100%;
  font-display: swap;
  src: url('/_assets/fonts/archivo-latin.woff2') format('woff2');
  unicode-range:
    U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
    U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212,
    U+2215, U+FEFF, U+FFFD;
}

@font-face {
  font-family: 'Archivo';
  font-style: normal;
  font-weight: 400 900;
  font-stretch: 100%;
  font-display: swap;
  src: url('/_assets/fonts/archivo-latin-ext.woff2') format('woff2');
  unicode-range:
    U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304,
    U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB,
    U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
}

@font-face {
  font-family: 'IBM Plex Mono';
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url('/_assets/fonts/plexmono-400-latin.woff2') format('woff2');
  unicode-range:
    U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
    U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212,
    U+2215, U+FEFF, U+FFFD;
}

@font-face {
  font-family: 'IBM Plex Mono';
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url('/_assets/fonts/plexmono-400-latin-ext.woff2') format('woff2');
  unicode-range:
    U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304,
    U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB,
    U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
}

@font-face {
  font-family: 'IBM Plex Mono';
  font-style: normal;
  font-weight: 500;
  font-display: swap;
  src: url('/_assets/fonts/plexmono-500-latin.woff2') format('woff2');
  unicode-range:
    U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
    U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212,
    U+2215, U+FEFF, U+FFFD;
}

@font-face {
  font-family: 'IBM Plex Mono';
  font-style: normal;
  font-weight: 600;
  font-display: swap;
  src: url('/_assets/fonts/plexmono-600-latin.woff2') format('woff2');
  unicode-range:
    U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
    U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212,
    U+2215, U+FEFF, U+FFFD;
}

:root {
  --paper: #f2f1ec;
  --surface: #ffffff;
  --ink: #0b0b0b;
  --rule: rgb(11 11 11 / 14%);
  --rule-soft: rgb(11 11 11 / 6%);
  --panda: #11c291;
}

html,
body {
  @apply h-full overflow-hidden;
}

html {
  -webkit-font-smoothing: antialiased;
  scrollbar-color: rgb(11 11 11 / 25%) transparent !important;
}

body {
  background: var(--paper) !important;
  color: var(--ink);
  font-family: theme('fontFamily.sans');
}

/* https://www.skeleton.dev/docs/themes */
:root [data-theme='skeleton'] {
  --theme-font-family-base:
    'Archivo', -apple-system, blinkmacsystemfont, 'system-ui', 'Segoe UI',
    'Noto Sans', roboto, helvetica, arial, sans-serif, 'Apple Color Emoji',
    'Segoe UI Emoji';
  --theme-font-family-heading:
    'Archivo', -apple-system, blinkmacsystemfont, 'system-ui', 'Segoe UI',
    'Noto Sans', roboto, helvetica, arial, sans-serif;
}

/**
 * Page ground: bone paper, a hairline engineering grid, and a faint grain.
 * Fixed so it never scrolls with #page.
 */
.page-ground {
  position: fixed;
  inset: 0;
  overflow: hidden;
  background-color: var(--paper);
  background-image:
    linear-gradient(var(--rule-soft) 1px, transparent 1px),
    linear-gradient(90deg, var(--rule-soft) 1px, transparent 1px);
  background-size: 96px 96px;
  background-position: center top;
}

.page-ground::after {
  content: '';
  position: absolute;
  inset: 0;
  background-image: radial-gradient(
    120% 90% at 50% -10%,
    rgb(17 194 145 / 10%) 0%,
    rgb(17 194 145 / 0%) 55%
  );
}

@layer components {
  /* Small mono label: section kickers, table headers, status chips. */
  .eyebrow {
    @apply font-mono text-xs font-medium uppercase leading-[1.5] tracking-[0.18em] text-ink-70;
  }

  /* Display headline: tight, heavy, optically balanced. */
  .display {
    @apply font-display font-black leading-[0.92] tracking-[-0.035em] text-ink;

    font-variant-ligatures: none;
  }

  /* Hairline framing used across every section block. */
  .rule-box {
    @apply border border-ink/15 bg-white;
  }

  .rule-t {
    @apply border-t border-ink/15;
  }

  /* Underline that grows on hover — the only link flourish on the page. */
  .link-mark {
    @apply relative inline-flex items-center gap-1 font-mono text-sm font-medium text-ink;
  }

  .link-mark::after {
    content: '';
    @apply absolute -bottom-1 left-0 h-px w-full origin-left scale-x-0 bg-ink transition-transform duration-300 ease-out;
  }

  .link-mark:hover::after {
    @apply scale-x-100;
  }

  /* Solid ink button. */
  .btn-ink {
    @apply inline-flex items-center justify-center gap-2 border border-ink bg-ink px-6 py-3 font-mono text-sm font-medium uppercase tracking-[0.08em] text-paper transition-colors duration-200 hover:bg-transparent hover:text-ink;
  }

  /* Outlined counterpart. */
  .btn-outline {
    @apply inline-flex items-center justify-center gap-2 border border-ink/25 bg-transparent px-6 py-3 font-mono text-sm font-medium uppercase tracking-[0.08em] text-ink transition-colors duration-200 hover:border-ink hover:bg-ink hover:text-paper;
  }
}

/* Scroll-reveal: opt-in, respects reduced motion. */
.reveal {
  opacity: 0;
  transform: translateY(18px);
  transition:
    opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
    transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
}

.reveal.is-visible {
  opacity: 1;
  transform: none;
}

/* Terminal caret in the hero — the 20% panda personality. */
@keyframes caret-blink {
  0%,
  49% {
    opacity: 1;
  }

  50%,
  100% {
    opacity: 0;
  }
}

.caret {
  animation: caret-blink 1.1s steps(1) infinite;
}

@media (prefers-reduced-motion: reduce) {
  #page {
    scroll-behavior: auto;
  }

  .reveal {
    opacity: 1;
    transform: none;
    transition: none;
  }

  .caret {
    animation: none;
  }
}

@supports not (text-wrap: balance) {
  .text-balance {
    white-space: normal;
    overflow-wrap: break-word;
  }
}

@supports not (text-wrap: pretty) {
  .text-pretty {
    text-wrap: wrap;
  }
}

@supports not (text-wrap: wrap) {
  .text-pretty {
    white-space: normal;
    overflow-wrap: break-word;
  }
}
