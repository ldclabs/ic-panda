[
    {
        "match": ".well-known",
        "ignore": false
    },
    {
        "match": ".well-known/ii-alternative-origins",
        "headers": {
            "Access-Control-Allow-Origin": "*",
            "Content-Type": "application/json"
        },
        "ignore": false
    },
    {
        "match": ".well-known/apple-app-site-association",
        "headers": {
            "Content-Type": "application/json",
            "Cache-Control": "public, max-age=3600"
        },
        "ignore": false
    },
    {
        "match": "**/*",
        "security_policy": "standard",
        "headers": {
            "Content-Security-Policy": "default-src 'self';script-src 'self' 'unsafe-eval' 'unsafe-inline';connect-src 'self' http://localhost:* https://icp0.io https://*.icp0.io https://icp-api.io https://*.dmsg.net https://*.r2.cloudflarestorage.com https://api.icpswap.com;img-src 'self' https: http://localhost:* http://127.0.0.1:* https://assets.dmsg.net data: blob:;style-src * 'unsafe-inline';style-src-elem * 'unsafe-inline';font-src *;object-src 'none';base-uri 'self';frame-ancestors 'none';form-action 'self';upgrade-insecure-requests;",
            "Permissions-Policy": "autoplay=*, camera=*, cross-origin-isolated=*, display-capture=*, encrypted-media=*, fullscreen=*, keyboard-map=*, microphone=*, payment=*, picture-in-picture=*, clipboard-read=*, clipboard-write=*",
            "X-Frame-Options": "DENY",
            "Referrer-Policy": "same-origin",
            "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
            "X-Content-Type-Options": "nosniff",
            "X-XSS-Protection": "1; mode=block"
        },
        "allow_raw_access": false
    },
    {
        "match": "index.html",
        "cache": {
            "max_age": 0
        },
        "headers": {
            "Content-Type": "text/html; charset=utf-8",
            "Cache-Control": "public, max-age=0, must-revalidate",
            "Link": "</llms.txt>; rel=\"describedby\""
        }
    },
    {
        "match": "_/about*.html",
        "cache": {
            "max_age": 0
        },
        "headers": {
            "Content-Type": "text/html; charset=utf-8",
            "Cache-Control": "public, max-age=0, must-revalidate",
            "Link": "</llms.txt>; rel=\"describedby\""
        }
    },
    {
        "match": "index*.md",
        "cache": {
            "max_age": 0
        },
        "headers": {
            "Content-Type": "text/markdown; charset=utf-8",
            "Cache-Control": "public, max-age=0, must-revalidate",
            "Link": "</llms.txt>; rel=\"describedby\""
        }
    },
    {
        "match": "_/docs/*.md",
        "cache": {
            "max_age": 0
        },
        "headers": {
            "Content-Type": "text/markdown; charset=utf-8",
            "Cache-Control": "public, max-age=0, must-revalidate",
            "Link": "</llms.txt>; rel=\"describedby\""
        }
    },
    {
        "match": "llms*.txt",
        "cache": {
            "max_age": 0
        },
        "headers": {
            "Content-Type": "text/plain; charset=utf-8",
            "Cache-Control": "public, max-age=0, must-revalidate",
            "Link": "</llms.txt>; rel=\"describedby\""
        }
    },
    {
        "match": "robots.txt",
        "cache": {
            "max_age": 0
        },
        "headers": {
            "Content-Type": "text/plain; charset=utf-8",
            "Cache-Control": "public, max-age=0, must-revalidate",
            "Link": "</llms.txt>; rel=\"describedby\""
        }
    },
    {
        "match": "sitemap.xml",
        "cache": {
            "max_age": 0
        },
        "headers": {
            "Content-Type": "application/xml; charset=utf-8",
            "Cache-Control": "public, max-age=0, must-revalidate",
            "Link": "</llms.txt>; rel=\"describedby\""
        }
    },
    {
        "match": "_/knowledge.json",
        "cache": {
            "max_age": 0
        },
        "headers": {
            "Content-Type": "application/json; charset=utf-8",
            "Cache-Control": "public, max-age=0, must-revalidate",
            "Link": "</llms.txt>; rel=\"describedby\""
        }
    }
]
