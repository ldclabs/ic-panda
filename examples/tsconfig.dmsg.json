{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@dmsg/sdk": ["../packages/dmsg-sdk/dist/index.d.ts"],
      "@dmsg/sdk/*": ["../packages/dmsg-sdk/dist/*.d.ts"]
    }
  },
  "include": ["dmsg-browser-client.ts"]
}
