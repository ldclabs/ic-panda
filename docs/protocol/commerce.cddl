; Current resource/entitlement framing; public methods use integration.cddl.
; Commerce 2 checkout and membership 2 replace the retired v1 intent/order/claim domains.
; These resource leaf domains remain v1. See commerce.md and dmsg_protocol::billing.
hash32 = bytes .size 32
principal = bytes .size (1..29)
uint128 = uint / #6.2(bytes .size (9..16))
beneficiary = {
  "product_id": tstr,
  "authority_canister": principal,
  "subject_schema": tstr,
  "subject_bytes": bytes .size (1..64)
}
entitlement-key-preimage = [1, "dmsg/commerce/entitlement-key/v1", beneficiary]
catalog-key-preimage = [1, "dmsg/commerce/catalog-key/v1", "dmsg"]
resource-limits = { "storage_bytes": uint, "active_channels": uint, "monthly_execution_units": uint }
month-segment = { "start_ms": uint, "end_ms": uint, "monthly_units": uint, "source_contract_id": hash32 / null }
delivery-fee-policy = { "version": uint, "effective_at_ms": uint, "rate_bps": uint .le 10000, "minimum_atomic": uint128 }
